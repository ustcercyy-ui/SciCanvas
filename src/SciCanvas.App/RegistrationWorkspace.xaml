<UserControl x:Class="SciCanvas.App.RegistrationWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="250">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False">
        <StackPanel Margin="16,16,16,24">
            <TextBlock Text="手动配准" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,0"
                       Text="Translation · Rigid · Affine"
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="10" />

            <Border Margin="0,12,0,0" Padding="10"
                    Background="#10212A" BorderBrush="#245A68"
                    BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="矩阵约定" Foreground="#8CE5F4" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0"
                               Text="TargetPoint = M × SourcePoint；3×3 row-major。Translation ≥1 pair，Rigid ≥2 valid pairs，Affine ≥3 non-collinear pairs。"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="9" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Margin="0,12,0,0" Text="{Binding SummaryText}"
                       Foreground="#DCE7F0" FontSize="9" TextWrapping="Wrap" />
            <ComboBox Margin="0,7,0,0"
                      ItemsSource="{Binding Registrations}"
                      SelectedItem="{Binding SelectedRegistration}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding PairTitle}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding GroupName}" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Border Margin="0,12,0,0" Padding="10"
                    Background="{DynamicResource PanelRaisedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SelectedRegistration.PairTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectedRegistration.KindText}" Foreground="#80DDEA" FontSize="9" />
                    </Grid>
                    <TextBlock Margin="0,8,0,0" Text="Landmark pairs / source px → target px"
                               Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                    <TextBox Margin="0,4,0,0" MinHeight="90" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="9"
                             Text="{Binding SelectedRegistration.LandmarksText, UpdateSourceTrigger=PropertyChanged}" />
                    <UniformGrid Margin="0,8,0,0" Columns="3">
                        <Button Margin="0,0,3,0" Content="Translation" Command="{Binding SelectedRegistration.SolveTranslationCommand}" />
                        <Button Margin="3,0" Content="Rigid" Command="{Binding SelectedRegistration.SolveRigidCommand}" />
                        <Button Margin="3,0,0,0" Content="Affine" Command="{Binding SelectedRegistration.SolveAffineCommand}" />
                    </UniformGrid>
                    <TextBlock Margin="0,9,0,0" Text="Matrix / row-major" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                    <TextBlock Margin="0,3,0,0" Padding="7" Text="{Binding SelectedRegistration.MatrixText}"
                               Background="#0C141A" FontFamily="Consolas" FontSize="9" />
                    <TextBlock Margin="0,8,0,0" Text="{Binding SelectedRegistration.RmsText}"
                               Foreground="#8CE5F4" FontWeight="SemiBold" />
                    <TextBlock Margin="0,5,0,0" Text="{Binding SelectedRegistration.RevisionStatusText}"
                               Foreground="#E7C49C" FontFamily="Consolas" FontSize="8" TextWrapping="Wrap" />
                    <TextBlock Margin="0,5,0,0" Text="{Binding SelectedRegistration.StatusText}"
                               Foreground="{DynamicResource MutedBrush}" FontSize="8" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Margin="0,12,0,0" Padding="9" Background="#241B16"
                    BorderBrush="#755137" BorderThickness="1" CornerRadius="4">
                <TextBlock Text="SourceRevision 改变后状态为 ReviewRequired，linked crop、ROI propagation 与 analysis 会停止，直到重新求解。"
                           Foreground="#BDA68E" FontSize="8" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
