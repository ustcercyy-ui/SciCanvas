<UserControl x:Class="SciCanvas.App.InspectorWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SciCanvas.App"
             Focusable="False"
             Background="#141A22"
             Foreground="#E8EDF4">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <SolidColorBrush x:Key="PanelBrush" Color="#141A22" />
        <SolidColorBrush x:Key="PanelRaisedBrush" Color="#1A222D" />
        <SolidColorBrush x:Key="BorderBrush" Color="#2B3543" />
        <SolidColorBrush x:Key="MutedBrush" Color="#8F9BAD" />
        <SolidColorBrush x:Key="AccentBrush" Color="#22C7E8" />
        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#087E98" />
            <Setter Property="BorderBrush" Value="#26D8F6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AEB9C7" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>
    </UserControl.Resources>
<ScrollViewer x:Name="InspectorScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                    <Grid>
                    <StackPanel Margin="16,16,16,24"
                                IsEnabled="{Binding HasSelection}"
                                Visibility="{Binding CropWorkspaceVisibility}">
                        <TextBlock Text="检查器" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,0" Text="整数像素 · 非破坏式" Foreground="{StaticResource MutedBrush}" FontSize="10" />

                        <Border Margin="0,14,0,0" Padding="10" Background="#10251E" BorderBrush="#28664F" BorderThickness="1" CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="源图层已锁定" Foreground="#7DE0AF" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,3,0,0" Text="不会向原图写入像素或元数据" Foreground="#91B8A6" FontSize="9" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="LOCK" Foreground="#7DE0AF" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Margin="0,10,0,0" Padding="10" Background="#241B16" BorderBrush="#755137" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="源图版本控制" Foreground="#E7C49C" FontSize="10" FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,0,7"
                                           Text="仅当磁盘文件已被有意更新时使用；操作会显示新旧 SHA-256 并要求再次确认。"
                                           Foreground="#BDA68E"
                                           FontSize="8"
                                           TextWrapping="Wrap" />
                                <Button Command="{Binding AcceptSourceRevisionCommand}" Content="接受当前文件为新版本" />
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,22,0,8" Style="{StaticResource SectionTitleStyle}" Text="尺度标定 / CALIBRATION" />
                        <Border Padding="10" Background="#111B23" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding SelectedSource.Calibration.StatusText}" Foreground="#7DD9E9" FontSize="10" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding SelectedSource.Calibration.OriginText}" Foreground="#AEB9C7" FontSize="9" />
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="X 尺度 / unit per px" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <TextBox Margin="0,4,0,0" Text="{Binding SelectedSource.Calibration.UnitsPerPixelX, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Y 尺度 / unit per px" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <TextBox Margin="0,4,0,0" Text="{Binding SelectedSource.Calibration.UnitsPerPixelY, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="参考线像素长度" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <TextBox Margin="0,4,0,0" IsReadOnly="True" Text="{Binding SelectedSource.Calibration.ReferencePixelLength, Mode=OneWay, StringFormat={}{0:0.###}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="已知真实距离" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <TextBox Margin="0,4,0,0" Text="{Binding SelectedSource.Calibration.ReferencePhysicalLength, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,8,0,0"
                                      Visibility="{Binding SelectedSource.Calibration.ReferenceLineVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="参考线方向角 / °（顺时针）" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <TextBox Margin="0,4,0,0"
                                                 Text="{Binding SelectedSource.Calibration.ReferenceAngleDegrees, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Width="42" VerticalAlignment="Bottom"
                                            Command="{Binding SelectedSource.Calibration.SetReferenceHorizontalCommand}"
                                            Content="水平" />
                                    <Button Grid.Column="4" Width="42" VerticalAlignment="Bottom"
                                            Command="{Binding SelectedSource.Calibration.SetReferenceVerticalCommand}"
                                            Content="垂直" />
                                </Grid>
                                <ComboBox Margin="0,8,0,0"
                                          ItemsSource="{Binding SelectedSource.Calibration.AvailableUnits}"
                                          SelectedItem="{Binding SelectedSource.Calibration.Unit}" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Command="{Binding SelectedSource.Calibration.ApplyReferenceCommand}" Style="{StaticResource AccentButtonStyle}" Content="应用参考标定" />
                                    <Button Grid.Column="2" Command="{Binding ApplyCalibrationToFigurePanelsCommand}" Content="同步到拼版" />
                                </Grid>
                                <Button Margin="0,6,0,0" Command="{Binding SelectedSource.Calibration.ClearCalibrationCommand}" Content="清除标定" />
                                <TextBlock Margin="0,8,0,0" Text="{Binding SelectedSource.Calibration.ValidatorText}" Foreground="#AFC5D2" FontSize="9" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,22,0,8" Style="{StaticResource SectionTitleStyle}" Text="当前测量" />
                        <Border x:Name="MeasurementInspectorPanel" Padding="10" Background="#111B23" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedSource.SelectedMeasurementStatusText}" Foreground="#7DD9E9" FontSize="10" TextWrapping="Wrap" />
                                <Grid Margin="0,8,0,0"
                                      Visibility="{Binding SelectedSource.SelectedMeasurement.DirectionEditorVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="测量方向角 / °（顺时针）" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <TextBox Margin="0,4,0,0"
                                                 Text="{Binding SelectedSource.SelectedMeasurement.DirectionAngleDegrees, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Width="42" VerticalAlignment="Bottom"
                                            Command="{Binding SelectedSource.SelectedMeasurement.SetHorizontalDirectionCommand}"
                                            Content="水平" />
                                    <Button Grid.Column="4" Width="42" VerticalAlignment="Bottom"
                                            Command="{Binding SelectedSource.SelectedMeasurement.SetVerticalDirectionCommand}"
                                            Content="垂直" />
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="描边颜色" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding SelectedSource.SelectedMeasurement.StrokeColor, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="2"
                                                    Width="46"
                                                    Padding="5,4"
                                                    Background="{Binding SelectedSource.SelectedMeasurement.OverlayStroke}"
                                                    BorderBrush="#80FFFFFF"
                                                    Click="MeasurementColorPicker_OnClick"
                                                    Content="取色"
                                                    AutomationProperties.Name="选择测量标注颜色" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="线宽 / px" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <TextBox Margin="0,4,0,0" Text="{Binding SelectedSource.SelectedMeasurement.StrokeWidthPixels, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Margin="0,10,0,0"
                                           Text="填充"
                                           Foreground="#AFC5D2"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Visibility="{Binding SelectedSource.SelectedMeasurement.FillStyleVisibility}" />
                                <Grid Margin="0,6,0,0"
                                      Visibility="{Binding SelectedSource.SelectedMeasurement.FillStyleVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="填充颜色" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding SelectedSource.SelectedMeasurement.FillColor, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="2" Width="46" Padding="5,4"
                                                    Background="{Binding SelectedSource.SelectedMeasurement.OverlayFill}"
                                                    Click="MeasurementFillColorPicker_OnClick"
                                                    Content="取色" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="透明度 / %" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <TextBox Margin="0,4,0,0"
                                                 Text="{Binding SelectedSource.SelectedMeasurement.FillOpacityPercent, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Margin="0,10,0,0" Text="端点" Foreground="#AFC5D2" FontSize="9" FontWeight="SemiBold" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="边框颜色" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding SelectedSource.SelectedMeasurement.MarkerStrokeColor, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="2" Width="46" Padding="5,4"
                                                    Background="{Binding SelectedSource.SelectedMeasurement.MarkerStrokeBrush}"
                                                    Click="MeasurementMarkerStrokeColorPicker_OnClick"
                                                    Content="取色" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="内部颜色" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding SelectedSource.SelectedMeasurement.MarkerFillColor, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="2" Width="46" Padding="5,4"
                                                    Background="{Binding SelectedSource.SelectedMeasurement.MarkerFillBrush}"
                                                    Click="MeasurementMarkerFillColorPicker_OnClick"
                                                    Content="取色" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Margin="0,10,0,0" Text="标签" Foreground="#AFC5D2" FontSize="9" FontWeight="SemiBold" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="文字颜色" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding SelectedSource.SelectedMeasurement.LabelColor, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="2" Width="46" Padding="5,4"
                                                    Background="{Binding SelectedSource.SelectedMeasurement.LabelBrush}"
                                                    Click="MeasurementLabelColorPicker_OnClick"
                                                    Content="取色" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="字体" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <ComboBox Margin="0,4,0,0"
                                                  IsEditable="True"
                                                  IsTextSearchEnabled="True"
                                                  ItemsSource="{Binding SelectedSource.SelectedMeasurement.LabelFontChoices}"
                                                  Text="{Binding SelectedSource.SelectedMeasurement.LabelFontFamily, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="字号 / pt" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <TextBox Margin="0,4,0,0"
                                                 Text="{Binding SelectedSource.SelectedMeasurement.LabelFontSizePt, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                        <CheckBox IsChecked="{Binding SelectedSource.SelectedMeasurement.LabelIsBold}" Content="粗体" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Margin="0,5,0,0"
                                           Text="{Binding SelectedSource.SelectedMeasurement.LabelFontAvailabilityMessage}"
                                           Foreground="#FFFFB74D"
                                           FontSize="8"
                                           TextWrapping="Wrap" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding MeasurementScientificColorTargets}"
                                              SelectedItem="{Binding MeasurementScientificColorTarget}"
                                              ToolTip="选择科学调色板颜色要应用的测量样式字段" />
                                    <Button Grid.Column="2"
                                            Command="{Binding ApplyScientificColorToMeasurementCommand}"
                                            Content="应用调色板颜色"
                                            ToolTip="将 Figure 视图中当前选定的科学颜色应用到此字段" />
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="线型" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <ComboBox Margin="0,4,0,0"
                                                  SelectedValue="{Binding SelectedSource.SelectedMeasurement.LineStyle, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="Tag">
                                            <ComboBoxItem Tag="solid" Content="实线" />
                                            <ComboBoxItem Tag="dash" Content="虚线" />
                                            <ComboBoxItem Tag="dot" Content="点线" />
                                            <ComboBoxItem Tag="dash-dot" Content="点划线" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="端点大小 / px" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <TextBox Margin="0,4,0,0" Text="{Binding SelectedSource.SelectedMeasurement.MarkerSizePixels, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding SelectedSource.SelectedMeasurement.ShowMarkers}" Content="显示端点" />
                                    <CheckBox Margin="16,0,0,0" IsChecked="{Binding SelectedSource.SelectedMeasurement.ShowLabel}" Content="显示数值标签" />
                                </StackPanel>
                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding SelectedSource.SelectedMeasurement.IsVisible}" Content="图层可见" />
                                    <CheckBox Grid.Column="1" IsChecked="{Binding SelectedSource.SelectedMeasurement.IsLocked}" Content="锁定图层" />
                                </Grid>
                                <TextBlock Margin="0,7,0,0" Text="选中后拖动图形可移动；拖动黄色端点手柄可改大小。" Foreground="{StaticResource MutedBrush}" FontSize="8" TextWrapping="Wrap" />
                                <UniformGrid Margin="0,8,0,0" Columns="2">
                                    <Button Margin="0,0,4,4" Command="{Binding ResetSelectedMeasurementStyleCommand}" Content="恢复继承样式" />
                                    <Button Margin="4,0,0,4" Command="{Binding CopySelectedMeasurementStyleCommand}" Content="复制样式" />
                                    <Button Margin="0,4,4,0" Command="{Binding PasteSelectedMeasurementStyleCommand}" Content="粘贴样式" />
                                    <Button Margin="4,4,0,0" Command="{Binding ApplyMeasurementStyleToSameTypeCommand}" Content="应用到同类型" />
                                </UniformGrid>
                                <Button Margin="0,8,0,0" Command="{Binding DeleteSelectedMeasurementCommand}" Content="删除当前测量" />
                                <TextBlock Margin="0,12,0,0"
                                           Text="科学图像分析 · 原始像素"
                                           Foreground="#AFC5D2"
                                           FontSize="9"
                                           FontWeight="SemiBold" />
                                <ComboBox Margin="0,6,0,0"
                                          ItemsSource="{Binding AvailableAnalysisChannels}"
                                          SelectedItem="{Binding AnalysisChannel}"
                                          ToolTip="灰度/亮度或明确的 RGB/A 原始通道" />
                                <Button Margin="0,6,0,0"
                                        Command="{Binding AnalyzeRoiStatisticsCommand}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Content="统计当前裁剪 ROI" />
                                <TextBlock Margin="0,6,0,0"
                                           Text="{Binding RoiStatisticsStatusText}"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="8"
                                           TextWrapping="Wrap" />
                                <Button Margin="0,6,0,0"
                                        Command="{Binding AnalyzeIntensityProfileCommand}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Content="从原始像素生成强度剖面" />
                                <TextBlock Margin="0,6,0,0"
                                           Text="{Binding IntensityProfileStatusText}"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="8"
                                           TextWrapping="Wrap" />
                                <Border Margin="0,8,0,0"
                                        Padding="7"
                                        Background="#0B131A"
                                        BorderBrush="#315365"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Visibility="{Binding IntensityProfileVisibility}">
                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                        <Canvas Width="300" Height="100">
                                            <Line X1="0" Y1="99" X2="300" Y2="99" Stroke="#4E6474" StrokeThickness="1" />
                                            <Line X1="0" Y1="0" X2="0" Y2="100" Stroke="#4E6474" StrokeThickness="1" />
                                            <Polyline Points="{Binding IntensityProfilePoints}"
                                                      Stroke="#22C7E8"
                                                      StrokeThickness="2"
                                                      StrokeLineJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <Button Margin="0,8,0,0"
                                        Command="{Binding ExportAnalysisResultsCommand}"
                                        Content="导出分析结果 CSV / Excel" />
                                <TextBlock Margin="0,5,0,0"
                                           Text="{Binding SelectedSource.AnalysisCountText}"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="8" />
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,22,0,8" Style="{StaticResource SectionTitleStyle}" Text="智能辅助区域分析 / 可审计规则" />
                        <Border Padding="10" Background="#171A21" BorderBrush="#66543A" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="只生成候选，不修改原图；候选必须人工接受后才写入测量表。"
                                           Foreground="#E8C989" FontSize="9" TextWrapping="Wrap" />
                                <ComboBox Margin="0,8,0,0"
                                          ItemsSource="{Binding AssistedRegionModes}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Mode"
                                          SelectedValue="{Binding AssistedRegionMode}" />
                                <CheckBox Margin="0,8,0,0"
                                          IsChecked="{Binding UseAutomaticRegionThreshold}"
                                          Content="自动阈值（Otsu，可复现）" />
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="手动阈值 / %" Foreground="{StaticResource MutedBrush}" FontSize="8" />
                                        <TextBox Margin="0,3,0,0"
                                                 Text="{Binding RegionThresholdPercent, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="关闭自动阈值后使用此值" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="最小面积 / px²" Foreground="{StaticResource MutedBrush}" FontSize="8" />
                                        <TextBox Margin="0,3,0,0" Text="{Binding MinimumRegionAreaPixels, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <Button Margin="0,8,0,0"
                                        Command="{Binding AnalyzeAssistedRegionsCommand}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Content="分析当前裁剪 ROI" />
                                <TextBlock Margin="0,7,0,0"
                                           Text="{Binding AssistedRegionStatusText}"
                                           Foreground="#D9C29A"
                                           FontSize="8"
                                           TextWrapping="Wrap" />
                                <StackPanel Visibility="{Binding AssistedRegionResultsVisibility}">
                                    <TextBlock Margin="0,7,0,4"
                                               Text="{Binding AssistedRegionDecisionText}"
                                               Foreground="#AFC5D2"
                                               FontSize="8" />
                                    <DataGrid Height="150"
                                              ItemsSource="{Binding AssistedRegions}"
                                              SelectedItem="{Binding SelectedAssistedRegion}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              HeadersVisibility="Column"
                                              RowHeaderWidth="0"
                                              Background="#0D1319"
                                              BorderBrush="{StaticResource BorderBrush}">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn Header="采用" Binding="{Binding IsAccepted, Mode=TwoWay}" Width="42" />
                                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="34" IsReadOnly="True" />
                                            <DataGridTextColumn Header="等效尺寸" Binding="{Binding SizeText}" Width="*" IsReadOnly="True" />
                                            <DataGridTextColumn Header="形貌 / 强度" Binding="{Binding ShapeText}" Width="2*" IsReadOnly="True" />
                                            <DataGridTextColumn Header="颜色" Binding="{Binding Color}" Width="82" IsReadOnly="True" />
                                            <DataGridTextColumn Header="状态" Binding="{Binding DecisionText}" Width="78" IsReadOnly="True" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Grid Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding SelectedAssistedRegion.Color, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="当前智能分析候选在图像上的标注颜色" />
                                        <Button Grid.Column="2"
                                                Width="72"
                                                Padding="6,4"
                                                Background="{Binding SelectedAssistedRegion.OverlayStroke}"
                                                Click="AssistedRegionColorPicker_OnClick"
                                                Content="候选取色" />
                                    </Grid>
                                    <UniformGrid Margin="0,7,0,0" Columns="2" Rows="2">
                                        <Button Margin="0,0,4,4" Command="{Binding AcceptAllAssistedRegionsCommand}" Content="全部接受" />
                                        <Button Margin="4,0,0,4" Command="{Binding RejectSelectedAssistedRegionCommand}" Content="拒绝所选" />
                                        <Button Margin="0,4,4,0" Command="{Binding CommitAcceptedAssistedRegionsCommand}" Style="{StaticResource AccentButtonStyle}" Content="写入测量表" />
                                        <Button Margin="4,4,0,0" Command="{Binding ClearAssistedRegionsCommand}" Content="清除候选" />
                                    </UniformGrid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,22,0,8" Style="{StaticResource SectionTitleStyle}" Text="裁剪区域 / PX" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="X" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                <TextBox Margin="0,4,0,0" Text="{Binding Crop.X, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Y" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                <TextBox Margin="0,4,0,0" Text="{Binding Crop.Y, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="宽度" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                <TextBox Margin="0,4,0,0" Text="{Binding Crop.Width, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="高度" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                <TextBox Margin="0,4,0,0" Text="{Binding Crop.Height, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Margin="0,9,0,0" Text="{Binding Crop.ValidationMessage}" Foreground="#7DD9E9" FontSize="10" TextWrapping="Wrap" />
                        <Button Margin="0,8,0,0"
                                Command="{Binding AutoTrimCurrentSourceCommand}"
                                Content="Auto Trim · 白色/透明边界"
                                ToolTip="基于只读预览生成建议并映射回源像素；不会修改源文件。" />
                        <CheckBox Margin="0,10,0,0"
                                  IsChecked="{Binding LockCropSizeAcrossSources}"
                                  Content="切换源图像时保持相同宽高"
                                  ToolTip="用于在一批图像上沿用同一裁剪尺寸，并分别自由选择位置" />

                        <TextBlock Margin="0,22,0,8" Style="{StaticResource SectionTitleStyle}" Text="对齐到源图像" />
                        <UniformGrid Columns="3" Rows="2">
                            <Button Margin="0,0,5,5" Padding="7" Command="{Binding Crop.AlignLeftCommand}" Content="左" ToolTip="左对齐" />
                            <Button Margin="0,0,5,5" Padding="7" Command="{Binding Crop.AlignHorizontalCenterCommand}" Content="水平中" ToolTip="水平居中" />
                            <Button Margin="0,0,0,5" Padding="7" Command="{Binding Crop.AlignRightCommand}" Content="右" ToolTip="右对齐" />
                            <Button Margin="0,0,5,0" Padding="7" Command="{Binding Crop.AlignTopCommand}" Content="上" ToolTip="上对齐" />
                            <Button Margin="0,0,5,0" Padding="7" Command="{Binding Crop.AlignVerticalCenterCommand}" Content="垂直中" ToolTip="垂直居中" />
                            <Button Padding="7" Command="{Binding Crop.AlignBottomCommand}" Content="下" ToolTip="下对齐" />
                        </UniformGrid>

                        <TextBlock Margin="0,22,0,8" Style="{StaticResource SectionTitleStyle}" Text="图层" />
                        <Border Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <Grid Margin="10,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsCropOverlayVisible}" />
                                    <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="裁剪框" VerticalAlignment="Center" FontSize="11" />
                                    <TextBlock Grid.Column="2" Text="OVERLAY" Foreground="{StaticResource MutedBrush}" FontSize="8" VerticalAlignment="Center" />
                                </Grid>
                                <Border Height="1" Background="{StaticResource BorderBrush}" />
                                <Grid Margin="10,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="True" IsEnabled="False" />
                                    <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding SelectedSource.DisplayName, FallbackValue=源图像}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="11" />
                                    <TextBlock Grid.Column="2" Text="LOCK" Foreground="#70D6A4" FontSize="8" FontWeight="Bold" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,22,0,8" Style="{StaticResource SectionTitleStyle}" Text="输出" />
                        <Button Command="{Binding ExportCropCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                Content="导出当前裁剪" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="首版仅写入全新文件；不会覆盖源图或任何已有文件。TIFF 为推荐格式。"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="9"
                                   TextWrapping="Wrap" />

                        <TextBlock Margin="0,22,0,8" Style="{StaticResource SectionTitleStyle}" Text="批量裁剪队列" />
                        <ListBox Height="150"
                                 ItemsSource="{Binding BatchCropQueue}"
                                 SelectedItem="{Binding SelectedBatchCrop}"
                                 Background="{StaticResource PanelRaisedBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 BorderThickness="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="6,5">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="1" Text="{Binding CropSummary}" Foreground="{StaticResource MutedBrush}" FontSize="8" />
                                        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Foreground="#7DD9E9" FontSize="8" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding AddCurrentCropToBatchQueueCommand}" Content="加入队列" />
                            <Button Grid.Column="2" Command="{Binding RemoveSelectedBatchCropCommand}" Content="移除所选" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding ClearBatchCropQueueCommand}" Content="清空队列" />
                            <Button Grid.Column="2" Command="{Binding ExportBatchCropsCommand}" Style="{StaticResource AccentButtonStyle}" Content="导出批量裁剪" />
                        </Grid>
                        <Button Margin="0,6,0,0"
                                Command="{Binding AnalyzeParticleBatchCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                Content="应用当前配方批量颗粒分析" />
                        <TextBlock Margin="0,7,0,0" Text="批量分析复用上方区域分析的模式、阈值、最小面积与通道；结果绑定各源 revision 并写入工程。批量导出仍只创建全新 TIFF。" Foreground="{StaticResource MutedBrush}" FontSize="9" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Margin="16,16,16,24" Visibility="{Binding FigureWorkspaceVisibility}">
                        <TextBlock Text="拼版检查器" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,0" Text="模板布局 · 原始像素导出" Foreground="{StaticResource MutedBrush}" FontSize="10" />

                        <Border Margin="0,14,0,0" Padding="11" Background="#16232D" BorderBrush="#315365" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="模板" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                <Grid Margin="0,5,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding AvailableTemplates}"
                                              SelectedItem="{Binding SelectedFigureTemplate}"
                                              DisplayMemberPath="Name"
                                              IsEnabled="{Binding IsTemplateSelectionEnabled}"
                                              ToolTip="切换模板时会按新画布比例迁移现有内容" />
                                    <Button Grid.Column="2" Command="{Binding ImportTemplateCommand}" Content="导入" ToolTip="导入并安装用户模板 JSON" />
                                </Grid>
                                <TextBlock Text="{Binding Figure.TemplateName}" Foreground="#8CE5F4" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Margin="0,5,0,0" Text="{Binding Figure.CanvasSizeText}" Foreground="#C0CBD6" FontSize="10" />
                                <TextBlock Margin="0,5,0,0" Text="{Binding Figure.TemplateDescription}" Foreground="{StaticResource MutedBrush}" FontSize="9" TextWrapping="Wrap" />
                                <TextBlock Margin="0,10,0,0" Text="自定义画布尺寸 / px" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding CustomCanvasWidth, UpdateSourceTrigger=PropertyChanged}" ToolTip="宽度：100–20,000 px" />
                                    <TextBlock Grid.Column="1" Text="×" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox Grid.Column="2" Text="{Binding CustomCanvasHeight, UpdateSourceTrigger=PropertyChanged}" ToolTip="高度：100–20,000 px" />
                                    <Button Grid.Column="4" Command="{Binding ApplyCustomCanvasSizeCommand}" Content="应用" />
                                </Grid>
                                <TextBlock Margin="0,4,0,0" Text="{Binding CustomCanvasSizeValidationMessage}" Foreground="#80DDEA" FontSize="8" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,18,0,8" Style="{StaticResource SectionTitleStyle}" Text="画布与面板编号" />
                        <Border Padding="10" Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="背景颜色 / HEX" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox IsEditable="True"
                                              Text="{Binding Figure.BackgroundColor, UpdateSourceTrigger=PropertyChanged}">
                                        <ComboBoxItem Content="#FFFFFFFF" />
                                        <ComboBoxItem Content="#FF000000" />
                                        <ComboBoxItem Content="#FFF5F5F2" />
                                        <ComboBoxItem Content="#00FFFFFF" />
                                    </ComboBox>
                                    <Button Grid.Column="2" Padding="8,5" Command="{Binding Figure.ResetBackgroundCommand}" Content="白色" />
                                </Grid>
                                <TextBlock Margin="0,5,0,0"
                                           Text="{Binding Figure.BackgroundValidationMessage}"
                                           Foreground="#80DDEA"
                                           FontSize="8"
                                           TextWrapping="Wrap" />
                                <CheckBox Margin="0,10,0,0" IsChecked="{Binding Figure.ShowPanelLabels}" Content="预览与导出面板编号" />
                                <CheckBox Margin="0,5,0,0" IsChecked="{Binding Figure.AutoPanelLabelsEnabled}" Content="新增或删除面板时自动编号" />
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="118" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="编号序列" Foreground="{StaticResource MutedBrush}" FontSize="9" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="2"
                                              SelectedValue="{Binding Figure.PanelLabelSequence}"
                                              SelectedValuePath="Tag">
                                        <ComboBoxItem Tag="lowercase" Content="a, b, c…" />
                                        <ComboBoxItem Tag="uppercase" Content="A, B, C…" />
                                        <ComboBoxItem Tag="numeric" Content="1, 2, 3…" />
                                    </ComboBox>
                                </Grid>
                                <Button Margin="0,7,0,0" Command="{Binding Figure.RenumberPanelLabelsCommand}" Content="按画布位置重新编号" />
                                <TextBlock Margin="0,5,0,0" Text="{Binding Figure.PanelLabelSettingsText}" Foreground="{StaticResource MutedBrush}" FontSize="8" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,18,0,8" Style="{StaticResource SectionTitleStyle}" Text="Project Style · 继承与覆盖" />
                        <Border Padding="10" Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,8"
                                           Text="Project → Figure → Panel → Scientific Object；下级只保存局部覆盖，未覆盖项持续继承项目样式。"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="8"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="字体家族" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                <ComboBox Margin="0,4,0,0"
                                          IsEditable="True"
                                          IsTextSearchEnabled="True"
                                          ItemsSource="{Binding Figure.GlobalFontChoices}"
                                          Text="{Binding Figure.GlobalFontFamily, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,5,0,0"
                                           Text="{Binding Figure.GlobalFontAvailabilityMessage}"
                                           Foreground="#FFFFB74D"
                                           FontSize="8"
                                           TextWrapping="Wrap" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="字号 / pt" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <TextBox Margin="0,4,0,0" Text="{Binding Figure.GlobalFontSizePt, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="线宽 / pt" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <TextBox Margin="0,4,0,0" Text="{Binding Figure.GlobalStrokeWidthPt, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="文字" Foreground="{StaticResource MutedBrush}" FontSize="8" />
                                        <Grid Margin="0,3,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="4" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Figure.GlobalTextColor, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="2" Width="36" Padding="3" Background="{Binding Figure.GlobalTextBrush}" Click="FigureGlobalTextColorPicker_OnClick" Content="取色" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="图形" Foreground="{StaticResource MutedBrush}" FontSize="8" />
                                        <Grid Margin="0,3,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="4" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Figure.GlobalShapeColor, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="2" Width="36" Padding="3" Background="{Binding Figure.GlobalShapeBrush}" Click="FigureGlobalShapeColorPicker_OnClick" Content="取色" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="比例尺" Foreground="{StaticResource MutedBrush}" FontSize="8" />
                                        <Grid Margin="0,3,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="4" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Figure.GlobalScaleBarColor, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="2" Width="36" Padding="3" Background="{Binding Figure.GlobalScaleBarBrush}" Click="FigureScaleBarColorPicker_OnClick" Content="取色" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                                <Border Margin="0,10,0,0" Padding="8" Background="#101A22" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                                    <StackPanel>
                                        <TextBlock Text="Panel Label" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="SemiBold" />
                                        <ComboBox Margin="0,6,0,0"
                                                  IsEditable="True"
                                                  IsTextSearchEnabled="True"
                                                  ItemsSource="{Binding Figure.PanelLabelFontChoices}"
                                                  Text="{Binding Figure.PanelLabelFontFamily, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="{Binding Figure.PanelLabelFontAvailabilityMessage}"
                                                   Foreground="#FFFFB74D"
                                                   FontSize="8"
                                                   TextWrapping="Wrap" />
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="文字颜色" Foreground="{StaticResource MutedBrush}" FontSize="8" />
                                                <Grid Margin="0,3,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="4" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBox Text="{Binding Figure.PanelLabelTextColor, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button Grid.Column="2" Width="36" Padding="3" Background="{Binding Figure.PanelLabelTextBrush}" Click="FigurePanelLabelColorPicker_OnClick" Content="取色" />
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="字号 / pt" Foreground="{StaticResource MutedBrush}" FontSize="8" />
                                                <TextBox Margin="0,3,0,0" Text="{Binding Figure.PanelLabelFontSizePt, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>
                                        <CheckBox Margin="0,6,0,0" IsChecked="{Binding Figure.PanelLabelIsBold}" Content="粗体" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,8,0,0" Padding="8" Background="#101A22" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                                    <StackPanel>
                                        <TextBlock Text="Scale Bar" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="SemiBold" />
                                        <ComboBox Margin="0,6,0,0"
                                                  IsEditable="True"
                                                  IsTextSearchEnabled="True"
                                                  ItemsSource="{Binding Figure.ScaleBarFontChoices}"
                                                  Text="{Binding Figure.ScaleBarFontFamily, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="{Binding Figure.ScaleBarFontAvailabilityMessage}"
                                                   Foreground="#FFFFB74D"
                                                   FontSize="8"
                                                   TextWrapping="Wrap" />
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="尺线颜色" Foreground="{StaticResource MutedBrush}" FontSize="8" />
                                                <Grid Margin="0,3,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="4" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBox Text="{Binding Figure.GlobalScaleBarColor, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button Grid.Column="2" Width="36" Padding="3" Background="{Binding Figure.GlobalScaleBarBrush}" Click="FigureScaleBarColorPicker_OnClick" Content="取色" />
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="文字颜色" Foreground="{StaticResource MutedBrush}" FontSize="8" />
                                                <Grid Margin="0,3,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="4" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBox Text="{Binding Figure.ScaleBarLabelColor, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button Grid.Column="2" Width="36" Padding="3" Background="{Binding Figure.ScaleBarLabelBrush}" Click="FigureScaleBarLabelColorPicker_OnClick" Content="取色" />
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="字号 / pt" Foreground="{StaticResource MutedBrush}" FontSize="8" />
                                                <TextBox Margin="0,3,0,0" Text="{Binding Figure.ScaleBarFontSizePt, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="尺线厚度 / pt" Foreground="{StaticResource MutedBrush}" FontSize="8" />
                                                <TextBox Margin="0,3,0,0" Text="{Binding Figure.ScaleBarThicknessPt, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>
                                        <CheckBox Margin="0,6,0,0" IsChecked="{Binding Figure.ScaleBarLabelIsBold}" Content="文字粗体" />
                                    </StackPanel>
                                </Border>
                                <Button Margin="0,9,0,0"
                                        Command="{Binding Figure.ApplyGlobalStyleCommand}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Content="一键统一全部标注" />
                                <TextBlock Margin="0,5,0,0" Text="{Binding Figure.GlobalStyleStatusText}" Foreground="{StaticResource MutedBrush}" FontSize="8" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,18,0,8" Style="{StaticResource SectionTitleStyle}" Text="科研颜色字典" />
                        <Border Padding="10" Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="同一物理对象在全项目复用同一颜色，并进行红绿色觉缺陷近似检查。"
                                           Foreground="{StaticResource MutedBrush}" FontSize="8" TextWrapping="Wrap" />
                                <ListBox Margin="0,8,0,0"
                                         MaxHeight="210"
                                         ItemsSource="{Binding Figure.ScientificColors}"
                                         SelectedItem="{Binding Figure.SelectedScientificColor}"
                                         Background="#0D151C"
                                         BorderBrush="{StaticResource BorderBrush}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="3" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="92" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="16" Height="16" Background="{Binding ColorBrush}" BorderBrush="#8090A0" BorderThickness="1" CornerRadius="2" />
                                                <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBox Grid.Column="3" Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <ComboBox Margin="0,8,0,0"
                                          ItemsSource="{Binding Figure.ScientificColorApplicationTargets}"
                                          SelectedItem="{Binding Figure.ScientificColorApplicationTarget}" />
                                <UniformGrid Margin="0,8,0,0" Columns="3" Rows="1">
                                    <Button Margin="0,0,4,0" Command="{Binding Figure.AddScientificColorCommand}" Content="新增" />
                                    <Button Margin="4,0" Command="{Binding Figure.RemoveSelectedScientificColorCommand}" Content="删除" />
                                    <Button Margin="4,0,0,0" Command="{Binding Figure.ApplySelectedScientificColorCommand}" Style="{StaticResource AccentButtonStyle}" Content="应用" ToolTip="可应用到标注描边/填充/文字、比例尺或 Panel Label；Auto 按当前选中对象判断" />
                                </UniformGrid>
                                <TextBlock Margin="0,7,0,0"
                                           Text="{Binding Figure.ScientificColorStatusText}"
                                           Foreground="#80DDEA"
                                           FontSize="8"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,18,0,8">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="面板图层" />
                            <TextBlock HorizontalAlignment="Right" Text="{Binding Figure.PanelCountText}" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                        </Grid>
                        <ListBox MinHeight="120"
                                 MaxHeight="300"
                                 Background="{StaticResource PanelRaisedBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 BorderThickness="1"
                                 ItemsSource="{Binding Figure.Panels}"
                                 SelectionMode="Extended"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="7,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsVisible}" ToolTip="显示/隐藏图层" />
                                        <StackPanel Grid.Column="1" Margin="8,0">
                                            <TextBlock FontSize="11" FontWeight="SemiBold">
                                                <Run Text="{Binding Label, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding RoleDisplayName, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Source.DisplayName}" Foreground="{StaticResource MutedBrush}" FontSize="9" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="2" IsChecked="{Binding IsLocked}" Content="锁" FontSize="9" ToolTip="锁定后不能在画布拖动" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <UniformGrid Margin="0,8,0,0" Columns="3">
                            <Button Margin="0,0,5,0" Padding="7" Command="{Binding Figure.MoveLayerUpCommand}" Content="上移" />
                            <Button Margin="0,0,5,0" Padding="7" Command="{Binding Figure.MoveLayerDownCommand}" Content="下移" />
                            <Button Padding="7" Command="{Binding Figure.RemoveSelectedCommand}" Content="移除所选" />
                        </UniformGrid>
                        <UniformGrid Margin="0,6,0,0" Columns="2">
                            <Button Margin="0,0,5,0" Padding="6" Command="{Binding Figure.SelectAllPanelsCommand}" Content="全选面板" />
                            <Button Padding="6" Command="{Binding Figure.ClearPanelSelectionCommand}" Content="取消选择" />
                        </UniformGrid>

                        <TextBlock Margin="0,20,0,8" Style="{StaticResource SectionTitleStyle}" Text="选中面板" />
                        <Border Padding="10" Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="{Binding Figure.SelectedPanel.RoleDisplayName, FallbackValue=未选择面板}" FontWeight="SemiBold" />
                                <TextBlock Margin="0,8,0,3" Text="面板编号" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                <TextBox Text="{Binding Figure.SelectedPanel.Label, UpdateSourceTrigger=PropertyChanged}" MaxLength="16" />
                                <TextBlock Margin="0,5,0,0" Text="{Binding Figure.SelectedPanel.FrameStatusText}" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                <StackPanel Margin="0,5,0,0" Visibility="{Binding Figure.SelectedPanel.FrameSelectionVisibility}">
                                    <TextBlock Text="多页图像帧（从 1 开始）" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                    <TextBox Margin="0,3,0,0" Text="{Binding Figure.SelectedPanel.FrameNumber, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <TextBlock Margin="0,5,0,0" Text="{Binding Figure.SelectedPanel.EffectiveDpiText}" Foreground="#80DDEA" FontSize="10" />
                                <Border Margin="0,6,0,0"
                                        Padding="7"
                                        Background="#2A2414"
                                        BorderBrush="#8D7735"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Visibility="{Binding Figure.SelectedPanel.RequiresScientificReview, Converter={StaticResource BooleanToVisibility}}">
                                    <TextBlock Text="{Binding Figure.SelectedPanel.ScientificValidityText}" Foreground="#F2D272" FontSize="9" TextWrapping="Wrap" />
                                </Border>
                                <TextBlock Margin="0,4,0,0" Text="{Binding Figure.SelectedPanel.HelpText}" Foreground="{StaticResource MutedBrush}" FontSize="9" TextWrapping="Wrap" />
                                <Button Margin="0,8,0,0" Command="{Binding ReplaceSelectedPanelSourceCommand}" Content="用当前源图替换面板" />
                                <TextBlock Margin="0,8,0,0" Text="图像适配" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                <ComboBox Margin="0,4,0,0"
                                          ItemsSource="{Binding Figure.SelectedPanel.AvailableFitModes}"
                                          SelectedItem="{Binding Figure.SelectedPanel.FitMode}" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="X / mm" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <TextBox Margin="0,4,0,0" Text="{Binding Figure.SelectedPanel.XMm, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.###}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Y / mm" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <TextBox Margin="0,4,0,0" Text="{Binding Figure.SelectedPanel.YMm, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.###}}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Margin="0,12,0,6" Text="Panel Frame / mm" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="宽度" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <TextBox Margin="0,4,0,0" Text="{Binding Figure.SelectedPanel.WidthMm, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.###}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="高度" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <TextBox Margin="0,4,0,0" Text="{Binding Figure.SelectedPanel.HeightMm, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.###}}" />
                                    </StackPanel>
                                </Grid>
                                <CheckBox Margin="0,8,0,0"
                                          IsChecked="{Binding Figure.SelectedPanel.IsAspectRatioLocked}"
                                          Content="锁定源图比例（等比缩放）"
                                          ToolTip="锁定后修改宽度或高度会同步调整另一边；关闭后可自由输入宽高。" />
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="整体缩放 / %" Foreground="{StaticResource MutedBrush}" FontSize="9" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="2"
                                             Text="{Binding Figure.SelectedPanel.ScalePercent, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.#}}"
                                             ToolTip="按源图比例同时缩放宽高，范围 1%—1000%。" />
                                </Grid>
                                <TextBlock Margin="0,5,0,0" Text="{Binding Figure.SelectedPanel.AspectRatioText}" Foreground="{StaticResource MutedBrush}" FontSize="8" />
                                <TextBlock Margin="0,2,0,0" Text="{Binding Figure.SelectedPanel.SizeStatusText}" Foreground="#80DDEA" FontSize="9" />

                                <TextBlock Margin="0,12,0,6" Text="对齐到画布" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                <UniformGrid Columns="3" Rows="2">
                                    <Button Margin="0,0,5,5" Padding="6" Command="{Binding Figure.AlignPanelLeftCommand}" Content="左" />
                                    <Button Margin="0,0,5,5" Padding="6" Command="{Binding Figure.AlignPanelHorizontalCenterCommand}" Content="水平中" />
                                    <Button Margin="0,0,0,5" Padding="6" Command="{Binding Figure.AlignPanelRightCommand}" Content="右" />
                                    <Button Margin="0,0,5,0" Padding="6" Command="{Binding Figure.AlignPanelTopCommand}" Content="上" />
                                    <Button Margin="0,0,5,0" Padding="6" Command="{Binding Figure.AlignPanelVerticalCenterCommand}" Content="垂直中" />
                                    <Button Padding="6" Command="{Binding Figure.AlignPanelBottomCommand}" Content="下" />
                                </UniformGrid>

                                <Border Margin="0,12,0,0"
                                        Padding="9"
                                        Background="#10212A"
                                        BorderBrush="#245A68"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Visibility="{Binding Figure.MultiplePanelSelectionVisibility}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Figure.SelectedPanelCountText}" Foreground="#8CE5F4" FontSize="10" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,0,7" Text="所选面板相互对齐；锁定面板作为参照但不会移动。" Foreground="{StaticResource MutedBrush}" FontSize="8" TextWrapping="Wrap" />
                                        <UniformGrid Columns="3" Rows="2">
                                            <Button Margin="0,0,5,5" Padding="5" Command="{Binding Figure.AlignSelectionLeftCommand}" Content="齐左" />
                                            <Button Margin="0,0,5,5" Padding="5" Command="{Binding Figure.AlignSelectionHorizontalCenterCommand}" Content="横中" />
                                            <Button Margin="0,0,0,5" Padding="5" Command="{Binding Figure.AlignSelectionRightCommand}" Content="齐右" />
                                            <Button Margin="0,0,5,0" Padding="5" Command="{Binding Figure.AlignSelectionTopCommand}" Content="齐上" />
                                            <Button Margin="0,0,5,0" Padding="5" Command="{Binding Figure.AlignSelectionVerticalCenterCommand}" Content="纵中" />
                                            <Button Padding="5" Command="{Binding Figure.AlignSelectionBottomCommand}" Content="齐下" />
                                        </UniformGrid>
                                        <UniformGrid Margin="0,7,0,0" Columns="2">
                                            <Button Margin="0,0,5,0" Padding="5" Command="{Binding Figure.DistributeSelectionHorizontallyCommand}" Content="水平等距" />
                                            <Button Padding="5" Command="{Binding Figure.DistributeSelectionVerticallyCommand}" Content="垂直等距" />
                                        </UniformGrid>
                                        <UniformGrid Margin="0,7,0,0" Columns="2">
                                            <Button Margin="0,0,5,0" Padding="5" Command="{Binding Figure.LinkSelectedPanelCropsCommand}" Content="关联裁剪" ToolTip="所选面板必须来自同一源图；之后替换其中一个裁剪会同步到同组面板" />
                                            <Button Padding="5" Command="{Binding Figure.UnlinkSelectedPanelCropsCommand}" Content="解除关联" />
                                        </UniformGrid>
                                        <TextBlock Margin="0,9,0,5"
                                                   Text="匹配主选面板（最后选中的高亮面板）"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="8" />
                                        <UniformGrid Columns="4">
                                            <Button Margin="0,0,4,0" Padding="4" Command="{Binding Figure.MatchSelectionWidthCommand}" Content="同宽" />
                                            <Button Margin="0,0,4,0" Padding="4" Command="{Binding Figure.MatchSelectionHeightCommand}" Content="同高" />
                                            <Button Margin="0,0,4,0" Padding="4" Command="{Binding Figure.MatchSelectionFrameCommand}" Content="同框" />
                                            <Button Padding="4" Command="{Binding Figure.MatchSelectionAspectRatioCommand}" Content="同比" ToolTip="保持各自宽度，将宽高比匹配到主选面板" />
                                        </UniformGrid>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="精确边界间距 / px" Foreground="{StaticResource MutedBrush}" FontSize="9" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="2" Text="{Binding Figure.ExactSpacingPixels, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                        <UniformGrid Margin="0,6,0,0" Columns="2">
                                            <Button Margin="0,0,5,0" Padding="5" Command="{Binding Figure.SetHorizontalSpacingCommand}" Content="应用水平间距" />
                                            <Button Padding="5" Command="{Binding Figure.SetVerticalSpacingCommand}" Content="应用垂直间距" />
                                        </UniformGrid>
                                        <TextBlock Margin="0,5,0,0" Text="{Binding Figure.ExactSpacingStatusText}" Foreground="{StaticResource MutedBrush}" FontSize="8" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Expander Margin="0,14,0,0" Header="Panel 局部样式覆盖" IsExpanded="False">
                                    <Border Margin="0,6,0,0" Padding="9" Background="#101820" BorderBrush="#334454" BorderThickness="1" CornerRadius="3">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Figure.SelectedPanelStyleOverrideStatusText}" Foreground="#80DDEA" FontSize="8" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,9,0,0" Text="Panel Label" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="SemiBold" />
                                            <ComboBox Margin="0,5,0,0" IsEditable="True" IsTextSearchEnabled="True"
                                                      ItemsSource="{Binding Figure.SelectedPanelLabelFontChoices}"
                                                      Text="{Binding Figure.SelectedPanelLabelFontFamily, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Margin="0,3,0,0" Text="{Binding Figure.SelectedPanelLabelFontAvailabilityMessage}" Foreground="#FFFFB74D" FontSize="8" TextWrapping="Wrap" />
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="文字颜色" Foreground="{StaticResource MutedBrush}" FontSize="8" />
                                                    <Grid Margin="0,3,0,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="4" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <TextBox Text="{Binding Figure.SelectedPanelLabelTextColor, UpdateSourceTrigger=PropertyChanged}" />
                                                        <Button Grid.Column="2" Width="36" Padding="3" Background="{Binding Figure.SelectedPanelLabelTextBrush}" Click="SelectedPanelLabelColorPicker_OnClick" Content="取色" />
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="字号 / pt" Foreground="{StaticResource MutedBrush}" FontSize="8" />
                                                    <TextBox Margin="0,3,0,0" Text="{Binding Figure.SelectedPanelLabelFontSizePt, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding Figure.SelectedPanelLabelIsBold}" Content="粗体" />
                                                <Button Margin="16,0,0,0" Padding="7,3" Command="{Binding Figure.ResetSelectedPanelLabelStyleCommand}" Content="恢复继承" />
                                            </StackPanel>

                                            <TextBlock Margin="0,12,0,0" Text="Scale Bar" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="SemiBold" />
                                            <ComboBox Margin="0,5,0,0" IsEditable="True" IsTextSearchEnabled="True"
                                                      ItemsSource="{Binding Figure.SelectedPanelScaleBarFontChoices}"
                                                      Text="{Binding Figure.SelectedPanelScaleBarFontFamily, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Margin="0,3,0,0" Text="{Binding Figure.SelectedPanelScaleBarFontAvailabilityMessage}" Foreground="#FFFFB74D" FontSize="8" TextWrapping="Wrap" />
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="尺线颜色" Foreground="{StaticResource MutedBrush}" FontSize="8" />
                                                    <Grid Margin="0,3,0,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="4" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <TextBox Text="{Binding Figure.SelectedPanelScaleBarColor, UpdateSourceTrigger=PropertyChanged}" />
                                                        <Button Grid.Column="2" Width="36" Padding="3" Background="{Binding Figure.SelectedPanelScaleBarBrush}" Click="SelectedPanelScaleBarColorPicker_OnClick" Content="取色" />
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="文字颜色" Foreground="{StaticResource MutedBrush}" FontSize="8" />
                                                    <Grid Margin="0,3,0,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="4" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <TextBox Text="{Binding Figure.SelectedPanelScaleBarLabelColor, UpdateSourceTrigger=PropertyChanged}" />
                                                        <Button Grid.Column="2" Width="36" Padding="3" Background="{Binding Figure.SelectedPanelScaleBarLabelBrush}" Click="SelectedPanelScaleBarLabelColorPicker_OnClick" Content="取色" />
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="字号 / pt" Foreground="{StaticResource MutedBrush}" FontSize="8" />
                                                    <TextBox Margin="0,3,0,0" Text="{Binding Figure.SelectedPanelScaleBarFontSizePt, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="尺线厚度 / pt" Foreground="{StaticResource MutedBrush}" FontSize="8" />
                                                    <TextBox Margin="0,3,0,0" Text="{Binding Figure.SelectedPanelScaleBarThicknessPt, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding Figure.SelectedPanelScaleBarLabelIsBold}" Content="文字粗体" />
                                                <Button Margin="16,0,0,0" Padding="7,3" Command="{Binding Figure.ResetSelectedPanelScaleBarStyleCommand}" Content="恢复继承" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Expander>

                                <Border Margin="0,14,0,0" Padding="9" Background="#101820" BorderBrush="#334454" BorderThickness="1" CornerRadius="3">
                                    <StackPanel>
                                        <CheckBox IsChecked="{Binding Figure.SelectedPanel.ShowScaleBar}"
                                                  Content="显示经过校准的比例尺" />
                                        <TextBlock Margin="0,6,0,0" Text="{Binding Figure.SelectedPanel.CropLinkStatusText}" Foreground="{StaticResource MutedBrush}" FontSize="8" />
                                        <Button Margin="0,7,0,0" Command="{Binding Figure.CreateInsetCommand}" Content="创建 Inset 局部放大" />
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="校准值 / 源像素" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                                <TextBox Margin="0,4,0,0"
                                                         Text="{Binding Figure.SelectedPanel.PhysicalUnitsPerSourcePixel, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="主比例尺长度" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                                <TextBox Margin="0,4,0,0"
                                                         Text="{Binding Figure.SelectedPanel.ScaleBarPhysicalLength, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="主比例尺显示单位" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                                <ComboBox Margin="0,4,0,0"
                                                          IsEditable="True"
                                                          Text="{Binding Figure.SelectedPanel.ScaleBarUnit, UpdateSourceTrigger=PropertyChanged}">
                                                    <ComboBoxItem Content="nm" />
                                                    <ComboBoxItem Content="µm" />
                                                    <ComboBoxItem Content="mm" />
                                                </ComboBox>
                                            </StackPanel>
                                            <CheckBox Grid.Column="2"
                                                      VerticalAlignment="Bottom"
                                                      Margin="0,0,0,6"
                                                      IsChecked="{Binding Figure.SelectedPanel.ScaleBarShowLabel}"
                                                      Content="显示数值标签" />
                                        </Grid>
                                        <StackPanel Margin="0,7,0,0">
                                            <TextBlock Text="校准单位（校准值 / 源像素）" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                            <ComboBox Margin="0,4,0,0"
                                                      IsEditable="True"
                                                      Text="{Binding Figure.SelectedPanel.CalibrationUnit, UpdateSourceTrigger=PropertyChanged}">
                                                <ComboBoxItem Content="nm" />
                                                <ComboBoxItem Content="µm" />
                                                <ComboBoxItem Content="mm" />
                                            </ComboBox>
                                        </StackPanel>
                                        <Border Margin="0,10,0,0" Padding="7" Background="#0D151D" BorderBrush="#2D3E4D" BorderThickness="1" CornerRadius="3">
                                            <StackPanel>
                                                <DockPanel LastChildFill="False">
                                                    <TextBlock DockPanel.Dock="Left" Text="额外比例尺" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="SemiBold" />
                                                    <Button DockPanel.Dock="Right" Padding="7,2" Command="{Binding Figure.AddAdditionalScaleBarCommand}" Content="+ 新增" />
                                                </DockPanel>
                                                <TextBlock Margin="0,4,0,0" Text="与当前 Panel 共享校准值；显示单位可独立换算。" Foreground="{StaticResource MutedBrush}" FontSize="8" TextWrapping="Wrap" />
                                                <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Figure.SelectedPanel.AdditionalScaleBars}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,3,0,0" Padding="6" Background="#111E28" BorderBrush="#304657" BorderThickness="1" CornerRadius="2">
                                                                <StackPanel>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                                        <TextBox Text="{Binding PhysicalLength, UpdateSourceTrigger=PropertyChanged}" />
                                                                        <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableUnits}" SelectedItem="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" />
                                                                    </Grid>
                                                                    <Grid Margin="0,5,0,0">
                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                        <ComboBox ItemsSource="{Binding AvailableAnchors}" SelectedItem="{Binding Anchor, UpdateSourceTrigger=PropertyChanged}" />
                                                                        <Button Grid.Column="2" Margin="8,0,0,0" Padding="7,2" Command="{Binding RemoveCommand}" Content="删除" />
                                                                    </Grid>
                                                                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                                                        <CheckBox IsChecked="{Binding ShowLabel}" Content="显示标签" />
                                                                        <CheckBox Margin="12,0,0,0" IsChecked="{Binding IsVisible}" Content="显示" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>                                        <TextBlock Margin="0,8,0,0"
                                                   Text="{Binding Figure.SelectedPanel.ScaleBarStatusText}"
                                                   Foreground="#80DDEA"
                                                   FontSize="9"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,5,0,0"
                                                   Text="校准值应来自显微镜元数据或实验记录；软件不会猜测物理尺度。"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="8"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,20,0,8">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="非破坏性图像处理" />
                            <TextBlock HorizontalAlignment="Right" Text="显示层" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                        </Grid>
                        <Border Padding="10" Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="仅记录参数，不改写源图；导出时从原始像素重新渲染。" Foreground="{StaticResource MutedBrush}" FontSize="8" TextWrapping="Wrap" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="亮度 (-100—+100)" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <Slider Margin="0,4,0,0"
                                                Minimum="-100"
                                                Maximum="100"
                                                SmallChange="1"
                                                LargeChange="10"
                                                IsSnapToTickEnabled="False"
                                                Height="18"
                                                Foreground="{StaticResource AccentBrush}"
                                                Value="{Binding Figure.SelectedPanel.BrightnessPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Margin="0,3,0,0" Text="{Binding Figure.SelectedPanel.BrightnessPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="对比度 (-100—+100)" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <Slider Margin="0,4,0,0"
                                                Minimum="-100"
                                                Maximum="100"
                                                SmallChange="1"
                                                LargeChange="10"
                                                IsSnapToTickEnabled="False"
                                                Height="18"
                                                Foreground="{StaticResource AccentBrush}"
                                                Value="{Binding Figure.SelectedPanel.ContrastPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Margin="0,3,0,0" Text="{Binding Figure.SelectedPanel.ContrastPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Gamma (0.1—10)" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <TextBox Margin="0,3,0,0" Text="{Binding Figure.SelectedPanel.Gamma, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="黑点 (0—1)" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <TextBox Margin="0,3,0,0" Text="{Binding Figure.SelectedPanel.BlackPoint, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="白点 (0—1)" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <TextBox Margin="0,3,0,0" Text="{Binding Figure.SelectedPanel.WhitePoint, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="通道" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <ComboBox Margin="0,3,0,0" IsEditable="True" Text="{Binding Figure.SelectedPanel.Channel, UpdateSourceTrigger=PropertyChanged}">
                                            <ComboBoxItem Content="rgb" />
                                            <ComboBoxItem Content="red" />
                                            <ComboBoxItem Content="green" />
                                            <ComboBoxItem Content="blue" />
                                            <ComboBoxItem Content="alpha" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <CheckBox IsChecked="{Binding Figure.SelectedPanel.Grayscale}" Content="灰度化" />
                                    <CheckBox Margin="14,0,0,0" IsChecked="{Binding Figure.SelectedPanel.Invert}" Content="反相" />
                                </StackPanel>
                                <TextBlock Margin="0,8,0,0" Text="{Binding Figure.SelectedPanel.AdjustmentStatusText}" Foreground="#80DDEA" FontSize="9" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Grid Margin="0,20,0,8">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="参考线与吸附" />
                            <TextBlock HorizontalAlignment="Right" Text="{Binding Figure.GuideCountText}" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                        </Grid>
                        <CheckBox IsChecked="{Binding Figure.IsSnappingEnabled}" Content="拖动面板时启用吸附" />
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="吸附阈值 / px" Foreground="{StaticResource MutedBrush}" FontSize="9" VerticalAlignment="Center" />
                            <TextBox Grid.Column="2" Text="{Binding Figure.SnapTolerancePixels, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <TextBlock Margin="0,5,0,0" Text="{Binding Figure.SnapSettingsText}" Foreground="#80DDEA" FontSize="8" />
                        <UniformGrid Margin="0,8,0,0" Columns="2">
                            <Button Margin="0,0,5,0" Command="{Binding Figure.AddVerticalGuideCommand}" Content="＋ 垂直参考线" />
                            <Button Command="{Binding Figure.AddHorizontalGuideCommand}" Content="＋ 水平参考线" />
                        </UniformGrid>
                        <ListBox Margin="0,8,0,0"
                                 MinHeight="60"
                                 MaxHeight="140"
                                 Background="{StaticResource PanelRaisedBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 BorderThickness="1"
                                 ItemsSource="{Binding Figure.Guides}"
                                 SelectedItem="{Binding Figure.SelectedGuide}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="7,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Summary}" FontSize="10" />
                                        <TextBlock Grid.Column="1" Text="锁" Foreground="#70D6A4" FontSize="9"
                                                   Visibility="{Binding IsLocked, Converter={StaticResource BooleanToVisibility}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Margin="0,8,0,0"
                                Padding="9"
                                Background="{StaticResource PanelRaisedBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Visibility="{Binding Figure.SelectedGuideVisibility}">
                            <StackPanel>
                                <TextBlock Text="{Binding Figure.SelectedGuide.OrientationDisplayName}" FontWeight="SemiBold" />
                                <TextBlock Margin="0,7,0,3" Text="位置 / 画布 px" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                <TextBox IsEnabled="{Binding Figure.SelectedGuide.CanEditPosition}"
                                         Text="{Binding Figure.SelectedGuide.Position, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox Margin="0,7,0,0" IsChecked="{Binding Figure.SelectedGuide.IsLocked}" Content="锁定参考线" />
                                <Button Margin="0,7,0,0" Command="{Binding Figure.RemoveSelectedGuideCommand}" Content="删除参考线" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,20,0,8">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="科研标注层" />
                            <TextBlock HorizontalAlignment="Right" Text="{Binding Figure.AnnotationCountText}" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                        </Grid>
                        <UniformGrid Columns="2" Rows="3">
                            <Button Margin="0,0,5,5" Command="{Binding Figure.AddTextAnnotationCommand}" Content="＋ 文字" />
                            <Button Margin="0,0,0,5" Command="{Binding Figure.AddArrowAnnotationCommand}" Content="＋ 箭头" />
                            <Button Margin="0,0,5,5" Command="{Binding Figure.AddLineAnnotationCommand}" Content="＋ 直线" />
                            <Button Margin="0,0,0,5" Command="{Binding Figure.AddRectangleAnnotationCommand}" Content="＋ 矩形" />
                            <Button Margin="0,0,5,0" Command="{Binding Figure.AddEllipseAnnotationCommand}" Content="＋ 椭圆" />
                        </UniformGrid>
                        <ListBox Margin="0,8,0,0"
                                 MinHeight="80"
                                 MaxHeight="180"
                                 Background="{StaticResource PanelRaisedBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 BorderThickness="1"
                                 ItemsSource="{Binding Figure.Annotations}"
                                 SelectionMode="Multiple">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=OneWay}" />
                                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="AnnotationListItem_OnPreviewMouseLeftButtonDown" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="7,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsVisible}" ToolTip="显示/隐藏标注" />
                                        <StackPanel Grid.Column="1" Margin="8,0">
                                            <TextBlock Text="{Binding Summary}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Color}" Foreground="{StaticResource MutedBrush}" FontSize="8" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="2" IsChecked="{Binding IsLocked}" Content="锁" FontSize="9" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <UniformGrid Margin="0,8,0,0" Columns="3">
                            <Button Margin="0,0,5,0" Padding="7" Command="{Binding Figure.MoveAnnotationUpCommand}" Content="上移" />
                            <Button Margin="0,0,5,0" Padding="7" Command="{Binding Figure.MoveAnnotationDownCommand}" Content="下移" />
                            <Button Padding="7" Command="{Binding Figure.RemoveSelectedAnnotationCommand}" Content="移除" />
                        </UniformGrid>
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="{Binding Figure.SelectedAnnotationCountText}" Foreground="#80DDEA" FontSize="9" />
                            <Button Grid.Column="1" Padding="7,4" Command="{Binding Figure.SelectAllAnnotationsCommand}" Content="全选" />
                            <Button Grid.Column="3" Padding="7,4" Command="{Binding Figure.ClearAnnotationSelectionCommand}" Content="清除选择" />
                        </Grid>
                        <UniformGrid Margin="0,7,0,0"
                                     Columns="3"
                                     Rows="2"
                                     Visibility="{Binding Figure.MultipleAnnotationSelectionVisibility}">
                            <Button Margin="0,0,4,4" Padding="6" Command="{Binding Figure.AlignAnnotationLeftCommand}" Content="左对齐" />
                            <Button Margin="0,0,4,4" Padding="6" Command="{Binding Figure.AlignAnnotationHorizontalCenterCommand}" Content="水平居中" />
                            <Button Margin="0,0,0,4" Padding="6" Command="{Binding Figure.AlignAnnotationRightCommand}" Content="右对齐" />
                            <Button Margin="0,0,4,0" Padding="6" Command="{Binding Figure.AlignAnnotationTopCommand}" Content="上对齐" />
                            <Button Margin="0,0,4,0" Padding="6" Command="{Binding Figure.AlignAnnotationVerticalCenterCommand}" Content="垂直居中" />
                            <Button Padding="6" Command="{Binding Figure.AlignAnnotationBottomCommand}" Content="下对齐" />
                        </UniformGrid>

                        <Border Margin="0,10,0,0"
                                Padding="10"
                                Background="{StaticResource PanelRaisedBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Visibility="{Binding Figure.SelectedAnnotationVisibility}">
                            <StackPanel>
                                <TextBlock Text="{Binding Figure.SelectedAnnotation.KindDisplayName, FallbackValue=未选择标注}" FontWeight="SemiBold" />
                                <TextBox Margin="0,8,0,0"
                                         Visibility="{Binding Figure.SelectedAnnotation.TextVisibility}"
                                         Text="{Binding Figure.SelectedAnnotation.Text, UpdateSourceTrigger=PropertyChanged}" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="X" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <TextBox Margin="0,4,0,0" Text="{Binding Figure.SelectedAnnotation.X, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Y" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <TextBox Margin="0,4,0,0" Text="{Binding Figure.SelectedAnnotation.Y, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,8,0,0" Visibility="{Binding Figure.SelectedAnnotation.EndpointVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Figure.SelectedAnnotation.EndXLabel}" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <TextBox Margin="0,4,0,0" Text="{Binding Figure.SelectedAnnotation.EndX, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Figure.SelectedAnnotation.EndYLabel}" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <TextBox Margin="0,4,0,0" Text="{Binding Figure.SelectedAnnotation.EndY, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,8,0,0"
                                      Visibility="{Binding Figure.SelectedAnnotation.DirectionEditorVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="方向角 / °（顺时针）" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <TextBox Margin="0,4,0,0"
                                                 Text="{Binding Figure.SelectedAnnotation.DirectionAngleDegrees, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Width="42" VerticalAlignment="Bottom"
                                            Command="{Binding Figure.SetAnnotationDirectionHorizontalCommand}"
                                            Content="水平" />
                                    <Button Grid.Column="4" Width="42" VerticalAlignment="Bottom"
                                            Command="{Binding Figure.SetAnnotationDirectionVerticalCommand}"
                                            Content="垂直" />
                                </Grid>
                                <StackPanel Margin="0,8,0,0"
                                            Visibility="{Binding Figure.SelectedAnnotation.TextVisibility}">
                                    <TextBlock Text="文字样式" Foreground="#AFC5D2" FontSize="9" FontWeight="SemiBold" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="文字颜色" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding Figure.SelectedAnnotation.TextColor, UpdateSourceTrigger=PropertyChanged}" />
                                                <Button Grid.Column="2" Width="46" Padding="5,4"
                                                        Background="{Binding Figure.SelectedAnnotation.TextBrush}"
                                                        Click="AnnotationTextColorPicker_OnClick"
                                                        Content="取色" />
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="字体" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                            <ComboBox Margin="0,4,0,0"
                                                      IsEditable="True"
                                                      IsTextSearchEnabled="True"
                                                      ItemsSource="{Binding Figure.SelectedAnnotation.FontChoices}"
                                                      Text="{Binding Figure.SelectedAnnotation.FontFamily, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="字号 / pt" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                            <TextBox Margin="0,4,0,0"
                                                     Text="{Binding Figure.SelectedAnnotation.FontSizePt, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                            <CheckBox IsChecked="{Binding Figure.SelectedAnnotation.IsBold}" Content="粗体" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Margin="0,5,0,0"
                                               Text="{Binding Figure.SelectedAnnotation.FontAvailabilityMessage}"
                                               Foreground="#FFFFB74D"
                                               FontSize="8"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Grid Margin="0,8,0,0"
                                      Visibility="{Binding Figure.SelectedAnnotation.StrokeVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="描边颜色" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Figure.SelectedAnnotation.StrokeColor, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="2" Width="46" Padding="5,4"
                                                    Background="{Binding Figure.SelectedAnnotation.StrokeBrush}"
                                                    Click="AnnotationStrokeColorPicker_OnClick"
                                                    Content="取色" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="线宽 / pt" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <TextBox Margin="0,4,0,0"
                                                 Text="{Binding Figure.SelectedAnnotation.StrokeWidthPt, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,8,0,0"
                                      Visibility="{Binding Figure.SelectedAnnotation.ShapeVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="填充颜色" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Figure.SelectedAnnotation.FillColor, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="2" Width="46" Padding="5,4"
                                                    Background="{Binding Figure.SelectedAnnotation.FillBrush}"
                                                    Click="AnnotationFillColorPicker_OnClick"
                                                    Content="取色" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="填充透明度 / %" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <TextBox Margin="0,4,0,0"
                                                 Text="{Binding Figure.SelectedAnnotation.FillOpacityPercent, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Margin="0,8,0,0"
                                           Text="{Binding Figure.SelectedAnnotation.ValidationMessage}"
                                           Foreground="#80DDEA"
                                           FontSize="9"
                                           TextWrapping="Wrap" />
                                <UniformGrid Margin="0,8,0,0" Columns="2">
                                    <Button Margin="0,0,4,4"
                                            Command="{Binding Figure.ResetSelectedAnnotationStyleCommand}"
                                            Content="恢复继承样式" />
                                    <Button Margin="4,0,0,4"
                                            Command="{Binding Figure.CopySelectedAnnotationStyleCommand}"
                                            Content="复制样式" />
                                    <Button Margin="0,4,4,0"
                                            Command="{Binding Figure.PasteSelectedAnnotationStyleCommand}"
                                            Content="粘贴样式" />
                                    <Button Margin="4,4,0,0"
                                            Command="{Binding Figure.ApplyAnnotationStyleToSameTypeCommand}"
                                            Content="应用到同类型" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,20,0,8">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="科研对象（PR 3）" />
                            <TextBlock HorizontalAlignment="Right" Text="{Binding Figure.ScientificObjectCountText}" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                        </Grid>
                        <UniformGrid Columns="2" Rows="3">
                            <Button Margin="0,0,5,5" Command="{Binding Figure.BeginPolygonAnnotationCommand}" Content="＋ Polygon Annotation" />
                            <Button Margin="0,0,5,5" Command="{Binding Figure.AddDirectionMarkerCommand}" Content="＋ 方向" />
                            <Button Margin="0,0,0,5" Command="{Binding Figure.AddColorbarCommand}" Content="＋ 色条" />
                            <Button Margin="0,0,5,0" Command="{Binding Figure.AddChannelLegendCommand}" Content="＋ 通道图例" />
                        </UniformGrid>
                        <TextBlock Margin="0,4,0,0"
                                   Text="{Binding Figure.PolygonAnnotationDraftHint}"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="9"
                                   TextWrapping="Wrap" />
                        <ListBox Margin="0,8,0,0" MinHeight="70" MaxHeight="150"
                                 Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                 ItemsSource="{Binding Figure.ScientificObjects}" SelectedItem="{Binding Figure.SelectedScientificObject}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="7,5">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsVisible}" ToolTip="显示/隐藏" />
                                        <StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="{Binding Summary}" FontSize="10" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding PointsText}" Foreground="{StaticResource MutedBrush}" FontSize="8" TextTrimming="CharacterEllipsis" /></StackPanel>
                                        <CheckBox Grid.Column="2" IsChecked="{Binding IsLocked}" Content="锁" FontSize="9" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Margin="0,7,0,0" Command="{Binding Figure.RemoveSelectedScientificObjectCommand}" Content="移除选中科研对象" />
                        <Border Margin="0,8,0,0" Padding="9" Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                Visibility="{Binding Figure.SelectedScientificObjectVisibility}">
                            <StackPanel>
                                <TextBlock Text="{Binding Figure.SelectedScientificObject.KindDisplayName, FallbackValue=未选择科研对象}" FontWeight="SemiBold" />
                                <TextBlock Margin="0,7,0,0" Text="标签" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                <TextBox Margin="0,4,0,0" Text="{Binding Figure.SelectedScientificObject.Label, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,7,0,0" Text="几何点 / 画布 px（x,y; x,y）" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                <TextBox Margin="0,4,0,0" Text="{Binding Figure.SelectedScientificObject.PointsText, UpdateSourceTrigger=PropertyChanged}" />
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="描边" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Figure.SelectedScientificObject.StrokeColor, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="2" Width="46" Padding="5,4"
                                                    Background="{Binding Figure.SelectedScientificObject.StrokeBrush}"
                                                    Click="ScientificObjectStrokeColorPicker_OnClick"
                                                    Content="取色" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="填充 / 透明度 %" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Figure.SelectedScientificObject.FillColor, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox Grid.Column="2" Text="{Binding Figure.SelectedScientificObject.FillOpacityPercent, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="4" Width="46" Padding="5,4"
                                                    Background="{Binding Figure.SelectedScientificObject.FillBrush}"
                                                    Click="ScientificObjectFillColorPicker_OnClick"
                                                    Content="取色" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="文字颜色" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Figure.SelectedScientificObject.TextColor, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="2" Width="46" Padding="5,4"
                                                    Background="{Binding Figure.SelectedScientificObject.TextBrush}"
                                                    Click="ScientificObjectTextColorPicker_OnClick"
                                                    Content="取色" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="线宽 / pt" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <TextBox Margin="0,4,0,0" Text="{Binding Figure.SelectedScientificObject.StrokeWidthPt, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,7,0,0" Visibility="{Binding Figure.SelectedScientificObject.DirectionEditorVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="6" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="方向角 / °（顺时针）" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <TextBox Margin="0,4,0,0" Text="{Binding Figure.SelectedScientificObject.DirectionAngleDegrees, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Width="42" VerticalAlignment="Bottom"
                                            Command="{Binding Figure.SelectedScientificObject.SetHorizontalDirectionCommand}"
                                            Content="水平" />
                                    <Button Grid.Column="4" Width="42" VerticalAlignment="Bottom"
                                            Command="{Binding Figure.SelectedScientificObject.SetVerticalDirectionCommand}"
                                            Content="垂直" />
                                </Grid>
                                <Grid Margin="0,7,0,0" Visibility="{Binding Figure.SelectedScientificObject.RangeVisibility}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="最小值" Foreground="{StaticResource MutedBrush}" FontSize="9" /><TextBox Margin="0,4,0,0" IsEnabled="{Binding Figure.SelectedScientificObject.CanEditColorbarRange}" Text="{Binding Figure.SelectedScientificObject.Minimum, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="最大值 / 单位" Foreground="{StaticResource MutedBrush}" FontSize="9" /><Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBox IsEnabled="{Binding Figure.SelectedScientificObject.CanEditColorbarRange}" Text="{Binding Figure.SelectedScientificObject.Maximum, UpdateSourceTrigger=PropertyChanged}" /><TextBox Grid.Column="2" Text="{Binding Figure.SelectedScientificObject.Unit, UpdateSourceTrigger=PropertyChanged}" /></Grid></StackPanel>
                                </Grid>
                                <Grid Margin="0,7,0,0" Visibility="{Binding Figure.SelectedScientificObject.RangeVisibility}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="绑定状态" Foreground="{StaticResource MutedBrush}" FontSize="9" /><ComboBox Margin="0,4,0,0" ItemsSource="{Binding Figure.SelectedScientificObject.ColorbarBindingStateChoices}" SelectedItem="{Binding Figure.SelectedScientificObject.ColorbarBindingState}" /></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="方向" Foreground="{StaticResource MutedBrush}" FontSize="9" /><ComboBox Margin="0,4,0,0" ItemsSource="{Binding Figure.SelectedScientificObject.ColorbarOrientationChoices}" SelectedItem="{Binding Figure.SelectedScientificObject.ColorbarOrientation}" /></StackPanel>
                                </Grid>
                                <StackPanel Margin="0,7,0,0" Visibility="{Binding Figure.SelectedScientificObject.RangeVisibility}">
                                    <TextBlock Text="绑定通道" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                    <ComboBox Margin="0,4,0,0"
                                              ItemsSource="{Binding Figure.ColorbarChannels}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="ChannelId"
                                              SelectedValue="{Binding Figure.SelectedScientificObject.ChannelId, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="0,7,0,0" Visibility="{Binding Figure.SelectedScientificObject.RangeVisibility}"><TextBlock Text="Colormap" Foreground="{StaticResource MutedBrush}" FontSize="9" /><ComboBox Margin="0,4,0,0" IsEnabled="{Binding Figure.SelectedScientificObject.CanEditColorbarRange}" ItemsSource="{Binding Figure.SelectedScientificObject.ColormapChoices}" SelectedItem="{Binding Figure.SelectedScientificObject.Colormap, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel Margin="0,7,0,0" Visibility="{Binding Figure.SelectedScientificObject.RangeVisibility}"><TextBlock Text="Ticks（value|label；分号分隔）" Foreground="{StaticResource MutedBrush}" FontSize="9" /><TextBox Margin="0,4,0,0" Text="{Binding Figure.SelectedScientificObject.ColorbarTicksText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel Margin="0,7,0,0" Visibility="{Binding Figure.SelectedScientificObject.ChannelEntriesVisibility}"><TextBlock Text="通道（标签|#AARRGGBB；分号分隔）" Foreground="{StaticResource MutedBrush}" FontSize="9" /><TextBox Margin="0,4,0,0" Text="{Binding Figure.SelectedScientificObject.ChannelEntriesText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel Margin="0,7,0,0" Visibility="{Binding Figure.SelectedScientificObject.ChannelEntriesVisibility}"><TextBlock Text="图例内边距 / px" Foreground="{StaticResource MutedBrush}" FontSize="9" /><TextBox Margin="0,4,0,0" Text="{Binding Figure.SelectedScientificObject.ChannelLegendPadding, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <TextBlock Margin="0,8,0,0" Text="{Binding Figure.SelectedScientificObject.ValidationMessage}" Foreground="#80DDEA" FontSize="9" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Grid Margin="0,20,0,8">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="投稿导出预设" />
                            <TextBlock HorizontalAlignment="Right" Text="{Binding ExportProfileSummary}" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                        </Grid>
                        <ListBox MinHeight="90"
                                 MaxHeight="180"
                                 ItemsSource="{Binding ExportProfiles}"
                                 SelectedItem="{Binding SelectedExportProfile}"
                                 Background="{StaticResource PanelRaisedBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 BorderThickness="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="7,5">
                                        <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedBrush}" FontSize="8" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <UniformGrid Margin="0,7,0,0" Columns="3">
                            <Button Margin="0,0,5,0" Padding="6" Command="{Binding AddExportProfileCommand}" Content="新增" />
                            <Button Margin="0,0,5,0" Padding="6" Command="{Binding RemoveSelectedExportProfileCommand}" Content="移除" />
                            <Button Padding="6" Command="{Binding ResetExportProfilesCommand}" Content="恢复默认" />
                        </UniformGrid>
                        <Border Margin="0,8,0,0" Padding="10" Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="名称" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                <TextBox Margin="0,4,0,0" Text="{Binding SelectedExportProfile.Name, UpdateSourceTrigger=PropertyChanged}" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="格式" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <ComboBox Margin="0,4,0,0" IsEditable="True" Text="{Binding SelectedExportProfile.Format, UpdateSourceTrigger=PropertyChanged}">
                                            <ComboBoxItem Content="tiff" />
                                            <ComboBoxItem Content="png" />
                                            <ComboBoxItem Content="jpg" />
                                            <ComboBoxItem Content="pdf" />
                                            <ComboBoxItem Content="svg" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="位深" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <ComboBox Margin="0,4,0,0" IsEditable="True" Text="{Binding SelectedExportProfile.BitDepth, UpdateSourceTrigger=PropertyChanged}">
                                            <ComboBoxItem Content="8" />
                                            <ComboBoxItem Content="16" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="DPI" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <TextBox Margin="0,4,0,0" Text="{Binding SelectedExportProfile.Dpi, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="缩放倍数" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <TextBox Margin="0,4,0,0" Text="{Binding SelectedExportProfile.Scale, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="目标宽 / px（可空）" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <TextBox Margin="0,4,0,0" Text="{Binding SelectedExportProfile.WidthPixels, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="目标高 / px（可空）" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <TextBox Margin="0,4,0,0" Text="{Binding SelectedExportProfile.HeightPixels, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Margin="0,8,0,0" Text="PDF font strategy" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                <ComboBox Margin="0,4,0,0"
                                          ItemsSource="{Binding SelectedExportProfile.PdfFontStrategyChoices}"
                                          SelectedItem="{Binding SelectedExportProfile.PdfFontStrategy, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="{Binding SelectedExportProfile.PdfFontStrategyDescription}"
                                           Foreground="#D9B991" FontSize="8" TextWrapping="Wrap" />
                                <CheckBox Margin="0,8,0,0" IsChecked="{Binding SelectedExportProfile.WriteProvenance}" Content="生成溯源 JSON 与 HTML 报告" />
                                <TextBlock Margin="0,6,0,0" Text="{Binding SelectedExportProfile.ValidationMessage}" Foreground="#80DDEA" FontSize="8" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,18,0,8" Style="{StaticResource SectionTitleStyle}" Text="智能辅助 · 可解释 / 可撤销" />
                        <Border Padding="10" Background="#171A21" BorderBrush="#66543A" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="使用确定性规则辅助布局、样式和科研诚信审查；不执行生成式填充、克隆、局部擦除或对象移除。"
                                           Foreground="#E8C989" FontSize="9" TextWrapping="Wrap" />
                                <Button Margin="0,9,0,0"
                                        Command="{Binding ApplySmartLayoutCommand}"
                                        Content="推荐并应用布局" />
                                <Button Margin="0,6,0,0"
                                        Command="{Binding HarmonizeFigureStyleCommand}"
                                        Content="协调全局样式" />
                                <Button Margin="0,6,0,0"
                                        Command="{Binding RunAssistedFigureReviewCommand}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Content="运行样式 + 科研诚信辅助审查" />
                                <TextBlock Margin="0,7,0,0"
                                           Text="{Binding SmartAssistStatusText}"
                                           Foreground="#D9C29A"
                                           FontSize="8"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,18,0,8" Style="{StaticResource SectionTitleStyle}" Text="Figure QC · 投稿前检查" />
                        <Border Padding="10" Background="#121E27" BorderBrush="#315365" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding FigureQcStatusText}" Foreground="#DCE7F0" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,3,0,0" Text="{Binding FigureQcCountText}" Foreground="{StaticResource MutedBrush}" FontSize="8" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Margin="8,0,0,0" Padding="9,5" Command="{Binding RunFigureQcCommand}" Content="重新检查" />
                                </Grid>
                                <Border Margin="0,8,0,0" Padding="8" Background="#0D151C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                                    <TextBlock Text="{Binding SubmissionPreflightSummary}"
                                               Foreground="#DCE7F0"
                                               FontFamily="Consolas"
                                               FontSize="9"
                                               TextWrapping="Wrap" />
                                </Border>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="92" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="项目最小有效分辨率 / dpi"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="9"
                                               VerticalAlignment="Center" />
                                    <TextBox Grid.Column="2"
                                             Text="{Binding FigureQcMinimumDpi, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Figure QC 最小有效 DPI" />
                                </Grid>
                                <ListBox Margin="0,9,0,0"
                                         MinHeight="54"
                                         MaxHeight="230"
                                         Background="#0D151C"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         BorderThickness="1"
                                         ItemsSource="{Binding FigureQcIssues}"
                                         SelectedItem="{Binding SelectedFigureQcIssue}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="5,4" Padding="7" BorderBrush="{Binding SeverityBrush}" BorderThickness="3,0,0,0">
                                                <StackPanel>
                                                    <Grid>
                                                        <TextBlock Text="{Binding SeverityText}" Foreground="{Binding SeverityBrush}" FontSize="8" FontWeight="Bold" />
                                                        <TextBlock HorizontalAlignment="Right" Text="{Binding TargetText}" Foreground="{StaticResource MutedBrush}" FontSize="8" />
                                                    </Grid>
                                                    <TextBlock Margin="0,3,0,0" Text="{Binding Message}" FontSize="9" TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,3,0,0" Text="{Binding SuggestedAction}" Foreground="{StaticResource MutedBrush}" FontSize="8" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Margin="0,8,0,0" Command="{Binding NavigateToSelectedQcIssueCommand}" Content="定位选中问题" />
                            </StackPanel>
                        </Border>

                        <Button Margin="0,18,0,0" Command="{Binding AddCurrentCropToFigureCommand}" Content="加入当前裁剪" />
                        <Button Margin="0,8,0,0" Command="{Binding ExportFigureCommand}" Style="{StaticResource AccentButtonStyle}" Content="导出整张拼版" />
                        <Button Margin="0,8,0,0" Command="{Binding ExportFigureVariantsCommand}" Content="批量导出投稿版本（主图/补充图/缩略图）" />
                        <Button Margin="0,8,0,0" Command="{Binding BuildSubmissionPackageCommand}" Content="生成投稿包（Figure / Data / Audit）" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="最终组图从原始文件重新裁剪并渲染；投稿包会先运行源文件验证与 QC，并生成 TIFF、可编辑 SVG、数据表、source manifest、溯源与审计报告。目标文件夹必须为空，源图不会被复制。"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="9"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    </Grid>
                    </ScrollViewer>
</UserControl>
