<UserControl x:Class="SciCanvas.App.ScientificDataWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <ScrollViewer x:Name="DataWorkspaceScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="14,14,14,24">
            <TextBlock Text="Scientific Data" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,0"
                       Text="CSV / TSV / XLSX · Preview → Confirm · Source read-only"
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="9"
                       TextWrapping="Wrap" />

            <Button Margin="0,12,0,0"
                    Command="{Binding SelectFileCommand}"
                    Content="选择表格文件…" />
            <TextBlock Margin="0,6,0,0"
                       Text="{Binding SourceFileName}"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding SourcePath}" />

            <Border Margin="0,12,0,0"
                    Padding="9"
                    Background="#101820"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="导入选择" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock Margin="0,7,0,0" Text="工作表（XLSX）" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                    <ComboBox Margin="0,3,0,0"
                              ItemsSource="{Binding AvailableSheets}"
                              SelectedItem="{Binding SelectedSheetName}" />
                    <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="A1 范围（XLSX，可空）" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                            <TextBox Margin="0,3,0,0" Text="{Binding SelectedRange, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="表头行" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                            <TextBox Margin="0,3,0,0" Text="{Binding HeaderRow, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                    <Button Margin="0,8,0,0"
                            Command="{Binding RefreshPreviewCommand}"
                            Content="刷新预览" />
                </StackPanel>
            </Border>

            <TextBlock Margin="0,12,0,0"
                       Text="{Binding PreviewSummary}"
                       Foreground="#80DDEA"
                       FontSize="9" />
            <ItemsControl x:Name="DataPreviewColumnsList"
                          Margin="0,6,0,0"
                          ItemsSource="{Binding PreviewColumns}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,6"
                                Padding="7"
                                Background="#151E27"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3">
                            <StackPanel>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Margin="0,0,3,0"
                                              ItemsSource="{Binding DataContext.DataTypeChoices, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                              SelectedItem="{Binding DataType}" />
                                    <TextBox Grid.Column="1"
                                             Margin="3,0"
                                             Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="单位" />
                                    <ComboBox Grid.Column="2"
                                              Margin="3,0,0,0"
                                              ItemsSource="{Binding DataContext.RoleChoices, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                              SelectedItem="{Binding Role}"
                                              ToolTip="列角色" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Margin="0,8,0,0" Text="前几行" FontSize="9" FontWeight="SemiBold" />
            <ListBox x:Name="DataPreviewRowsList"
                     Margin="0,5,0,0"
                     MinHeight="90"
                     MaxHeight="220"
                     ItemsSource="{Binding PreviewRows}"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Margin="4,2"
                                   Text="{Binding DisplayText}"
                                   FontFamily="Consolas"
                                   FontSize="8" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Margin="0,10,0,0" Text="DataAsset 名称" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
            <TextBox Margin="0,3,0,0" Text="{Binding AssetName, UpdateSourceTrigger=PropertyChanged}" />
            <Button Margin="0,7,0,0"
                    Command="{Binding ConfirmImportCommand}"
                    Content="确认并创建 DataAsset" />

            <TextBlock Margin="0,16,0,0" Text="已导入数据资产" FontSize="10" FontWeight="SemiBold" />
            <ListBox x:Name="ImportedDataAssetsList"
                     Margin="0,6,0,0"
                     MinHeight="80"
                     MaxHeight="180"
                     ItemsSource="{Binding Assets}"
                     SelectedItem="{Binding SelectedAsset}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="5,3">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SourceRevision, StringFormat=revision {0}}"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="8" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Margin="0,5,0,0" Text="{Binding SelectedAssetSummary}" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
            <Button Margin="0,6,0,0" Command="{Binding RemoveSelectedAssetCommand}" Content="从工程移除选中资产" />
            <TextBlock Margin="0,10,0,0"
                       Text="{Binding StatusText}"
                       Foreground="#D9B991"
                       FontSize="8"
                       TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
