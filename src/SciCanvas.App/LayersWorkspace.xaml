<UserControl x:Class="SciCanvas.App.LayersWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#141A22" />
        <SolidColorBrush x:Key="PanelRaisedBrush" Color="#1A222D" />
        <SolidColorBrush x:Key="BorderBrush" Color="#2B3543" />
        <SolidColorBrush x:Key="MutedBrush" Color="#8F9BAD" />
    </UserControl.Resources>
    <ScrollViewer x:Name="LayersScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False">
                        <StackPanel Margin="16,16,16,24">
                            <TextBlock Text="图层" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,0" Text="当前工作区的图像、测量、标注与参考线统一在这里选择、显隐、锁定和删除。" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" />
                            <Button Margin="0,10,0,0" Command="{Binding DeleteSelectionCommand}" Content="删除选中项 · Delete" />
                            <Border Margin="0,14,0,0" Padding="9" Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Visibility="{Binding CropWorkspaceVisibility}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="测量图层" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedSource.MeasurementCountText}" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                    </Grid>
                                    <ListBox Margin="0,9,0,0"
                                             MinHeight="150"
                                             MaxHeight="420"
                                             Background="{StaticResource PanelBrush}"
                                             BorderBrush="{StaticResource BorderBrush}"
                                             BorderThickness="1"
                                             ItemsSource="{Binding SelectedSource.Measurements}"
                                             SelectedItem="{Binding SelectedSource.SelectedMeasurement}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="7,7">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsVisible}" ToolTip="显示/隐藏测量图层" />
                                                    <StackPanel Grid.Column="1" Margin="8,0">
                                                        <TextBlock Text="{Binding LayerStateText}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding ValueText}" Foreground="{StaticResource MutedBrush}" FontSize="9" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="2" IsChecked="{Binding IsLocked}" Content="锁" FontSize="9" ToolTip="锁定测量图层" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Margin="0,7,0,0" Text="单击画布图形或列表均可选择；锁定后仍可查看，但不能移动、缩放或删除。" Foreground="{StaticResource MutedBrush}" FontSize="8" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,14,0,0" Padding="9" Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Visibility="{Binding FigureWorkspaceVisibility}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="拼版面板" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding Figure.PanelCountText}" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                    </Grid>
                                    <ListBox Margin="0,9,0,0" MinHeight="140" MaxHeight="360" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ItemsSource="{Binding Figure.Panels}" SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="7,7">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsVisible}" ToolTip="显示/隐藏图层" />
                                                    <StackPanel Grid.Column="1" Margin="8,0">
                                                        <TextBlock FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"><Run Text="{Binding Label, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding RoleDisplayName, Mode=OneWay}" /></TextBlock>
                                                        <TextBlock Text="{Binding Source.DisplayName}" Foreground="{StaticResource MutedBrush}" FontSize="9" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="2" IsChecked="{Binding IsLocked}" Content="锁" FontSize="9" ToolTip="锁定图层" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <UniformGrid Margin="0,8,0,0" Columns="3">
                                        <Button Margin="0,0,5,0" Padding="7" Command="{Binding Figure.MoveLayerUpCommand}" Content="上移" />
                                        <Button Margin="0,0,5,0" Padding="7" Command="{Binding Figure.MoveLayerDownCommand}" Content="下移" />
                                        <Button Padding="7" Command="{Binding Figure.RemoveSelectedCommand}" Content="移除" />
                                    </UniformGrid>
                                    <UniformGrid Margin="0,6,0,0" Columns="2">
                                        <Button Margin="0,0,5,0" Padding="6" Command="{Binding Figure.SelectAllPanelsCommand}" Content="全选面板" />
                                        <Button Padding="6" Command="{Binding Figure.ClearPanelSelectionCommand}" Content="取消选择" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                            <Border Margin="0,12,0,0" Padding="9" Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Visibility="{Binding FigureWorkspaceVisibility}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Plot 面板" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding Figure.PlotPanels.Count, StringFormat={}{0} 个}" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                    </Grid>
                                    <ListBox Margin="0,9,0,0"
                                             MinHeight="90"
                                             MaxHeight="280"
                                             Background="{StaticResource PanelBrush}"
                                             BorderBrush="{StaticResource BorderBrush}"
                                             BorderThickness="1"
                                             ItemsSource="{Binding Figure.PlotPanels}"
                                             SelectedItem="{Binding Figure.SelectedPlotPanel}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="7,7">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsVisible}" ToolTip="显示/隐藏 Plot 面板" />
                                                    <StackPanel Grid.Column="1" Margin="8,0">
                                                        <TextBlock FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"><Run Text="{Binding Label}" /><Run Text=" · " /><Run Text="{Binding PlotName}" /></TextBlock>
                                                        <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="9" TextTrimming="CharacterEllipsis"><Run Text="{Binding PlotTypeText}" /><Run Text=" · " /><Run Text="{Binding DataAssetName}" /><Run Text=" · rev " /><Run Text="{Binding SourceRevision}" /></TextBlock>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="2" IsChecked="{Binding IsLocked}" Content="锁" FontSize="9" ToolTip="锁定 Plot 面板" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Button Margin="0,8,0,0" Padding="7" Command="{Binding Figure.RemoveSelectedPlotPanelCommand}" Content="移除选中 Plot 面板" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,12,0,0" Padding="9" Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Visibility="{Binding FigureWorkspaceVisibility}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="标注图层" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding Figure.AnnotationCountText}" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                    </Grid>
                                    <ListBox Margin="0,9,0,0"
                                             MinHeight="110"
                                             MaxHeight="300"
                                             Background="{StaticResource PanelBrush}"
                                             BorderBrush="{StaticResource BorderBrush}"
                                             BorderThickness="1"
                                             ItemsSource="{Binding Figure.Annotations}"
                                             SelectedItem="{Binding Figure.SelectedAnnotation}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="7,7">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsVisible}" ToolTip="显示/隐藏标注图层" />
                                                    <StackPanel Grid.Column="1" Margin="8,0">
                                                        <TextBlock Text="{Binding KindDisplayName}" FontSize="11" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Text}" Foreground="{StaticResource MutedBrush}" FontSize="9" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="2" IsChecked="{Binding IsLocked}" Content="锁" FontSize="9" ToolTip="锁定标注图层" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <UniformGrid Margin="0,8,0,0" Columns="3">
                                        <Button Margin="0,0,5,0" Padding="7" Command="{Binding Figure.MoveAnnotationUpCommand}" Content="上移" />
                                        <Button Margin="0,0,5,0" Padding="7" Command="{Binding Figure.MoveAnnotationDownCommand}" Content="下移" />
                                        <Button Padding="7" Command="{Binding Figure.RemoveSelectedAnnotationCommand}" Content="删除" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                            <Border Margin="0,12,0,0" Padding="9" Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Visibility="{Binding FigureWorkspaceVisibility}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="参考线图层" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding Figure.GuideCountText}" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                    </Grid>
                                    <ListBox Margin="0,9,0,0"
                                             MinHeight="80"
                                             MaxHeight="220"
                                             Background="{StaticResource PanelBrush}"
                                             BorderBrush="{StaticResource BorderBrush}"
                                             BorderThickness="1"
                                             ItemsSource="{Binding Figure.Guides}"
                                             SelectedItem="{Binding Figure.SelectedGuide}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="7,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                     <TextBlock Text="{Binding Summary}" />
                                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsLocked}" Content="锁" FontSize="9" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Button Margin="0,8,0,0" Command="{Binding Figure.RemoveSelectedGuideCommand}" Content="删除选中参考线" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,12,0,0" Padding="9" Background="#10212A" BorderBrush="#245A68" BorderThickness="1" CornerRadius="3">
                                <StackPanel>
                                    <TextBlock Text="图层说明" Foreground="#8CE5F4" FontSize="10" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,4,0,0" Text="一次只激活一种图层类型；Delete 删除当前选中对象。眼睛控制显示，锁定会阻止拖动、改大小和删除。" Foreground="{StaticResource MutedBrush}" FontSize="9" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
    </ScrollViewer>
</UserControl>
