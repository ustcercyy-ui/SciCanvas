                                    <Button Margin="0,4,4,0" Command="{Binding PasteSelectedMeasurementStyleCommand}" Content="粘贴样式" />
                                    <Button Margin="4,4,0,0" Command="{Binding ApplyMeasurementStyleToSameTypeCommand}" Content="应用到同类型" />
                                </UniformGrid>
                                <Button Margin="0,8,0,0" Command="{Binding DeleteSelectedMeasurementCommand}" Content="删除当前测量" />
                                <TextBlock Margin="0,12,0,0"
                                           Text="科学图像分析 · 原始像素"
                                           Foreground="#AFC5D2"
                                           FontSize="9"
                                           FontWeight="SemiBold" />
                                <ComboBox Margin="0,6,0,0"
                                          ItemsSource="{Binding AvailableAnalysisChannels}"
                                          SelectedItem="{Binding AnalysisChannel}"
                                          ToolTip="灰度/亮度或明确的 RGB/A 原始通道" />
