                                    <TextBlock Text="{Binding SelectedSource.Calibration.StatusText}" Foreground="#7DD9E9" FontSize="10" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding SelectedSource.Calibration.OriginText}" Foreground="#AEB9C7" FontSize="9" />
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="X 尺度 / unit per px" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <TextBox Margin="0,4,0,0" Text="{Binding SelectedSource.Calibration.UnitsPerPixelX, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Y 尺度 / unit per px" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <TextBox Margin="0,4,0,0" Text="{Binding SelectedSource.Calibration.UnitsPerPixelY, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,10,0,0">
