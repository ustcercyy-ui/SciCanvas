                                                               Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                               PreviewMouseLeftButtonDown="ScientificPolygonVertexHandle_OnMouseLeftButtonDown"
                                                               PreviewMouseMove="ScientificPolygonVertexHandle_OnMouseMove"
                                                               PreviewMouseLeftButtonUp="ScientificPolygonVertexHandle_OnMouseLeftButtonUp"
                                                               LostMouseCapture="ScientificPolygonVertexHandle_OnLostMouseCapture">
                                                            <Thumb.Style>
                                                                <Style TargetType="Thumb">
                                                                    <Setter Property="Background" Value="#FFF5FBFF" />
                                                                    <Setter Property="BorderBrush" Value="#FFFFB300" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Background" Value="#FF16C7E8" />
                                                                            <Setter Property="BorderBrush" Value="#FFFFFFFF" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Thumb.Style>
                                                        </Thumb>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Canvas>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Canvas Width="{Binding Figure.CanvasWidth}"
                                    Height="{Binding Figure.CanvasHeight}"
                                    Panel.ZIndex="130"
                                    Background="#01000000"
                                    Cursor="Cross"
                                    Visibility="{Binding Figure.PolygonAnnotationDraftVisibility}"
                                    PreviewMouseLeftButtonDown="FigurePolygonAnnotationDraft_OnMouseLeftButtonDown">
                                <Polyline Points="{Binding Figure.PolygonAnnotationDraftPoints}"
                                          Stroke="#FFFFB300"
                                          StrokeThickness="4"
                                          StrokeDashArray="6,4"
                                          IsHitTestVisible="False" />
                                <ItemsControl Width="{Binding Figure.CanvasWidth}"
                                              Height="{Binding Figure.CanvasHeight}"
                                              ItemsSource="{Binding Figure.PolygonAnnotationDraftPoints}"
                                              IsHitTestVisible="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Ellipse Width="14" Height="14" Margin="-7"
                                                     Fill="#FFF5FBFF" Stroke="#FFFFB300" StrokeThickness="4" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Canvas>
                            <ItemsControl Width="{Binding Figure.CanvasWidth}"
                                          Height="{Binding Figure.CanvasHeight}"
                                          ItemsSource="{Binding Figure.MeasurementOverlays}"
                                          Panel.ZIndex="95"
                                          IsHitTestVisible="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Canvas Width="{Binding DataContext.Figure.CanvasWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Height="{Binding DataContext.Figure.CanvasHeight, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <Line X1="{Binding PointAX}" Y1="{Binding PointAY}"
                                                  X2="{Binding PointBX}" Y2="{Binding PointBY}"
                                                  Stroke="{Binding StrokeBrush}" StrokeThickness="{Binding StrokeWidthPixels}"
                                                  StrokeDashArray="{Binding StrokeDashArray}"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Visibility="{Binding LengthVisibility}" />
                                            <Polyline Points="{Binding AnglePoints}" Stroke="{Binding StrokeBrush}"
                                                      StrokeThickness="{Binding StrokeWidthPixels}"
                                                      StrokeDashArray="{Binding StrokeDashArray}"
                                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Visibility="{Binding AngleVisibility}" />
                                            <Polyline Points="{Binding PolylinePoints}" Stroke="{Binding StrokeBrush}"
                                                      StrokeThickness="{Binding StrokeWidthPixels}"
                                                      StrokeDashArray="{Binding StrokeDashArray}"
                                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Visibility="{Binding PolylineVisibility}" />
                                            <Rectangle Canvas.Left="{Binding RectangleX}" Canvas.Top="{Binding RectangleY}"
                                                       Width="{Binding RectangleWidth}" Height="{Binding RectangleHeight}"
                                                       Stroke="{Binding StrokeBrush}" StrokeThickness="{Binding StrokeWidthPixels}"
                                                       StrokeDashArray="{Binding StrokeDashArray}" Fill="{Binding FillBrush}"
                                                       Visibility="{Binding RectangleVisibility}" />
                                            <Ellipse Canvas.Left="{Binding RectangleX}" Canvas.Top="{Binding RectangleY}"
                                                     Width="{Binding RectangleWidth}" Height="{Binding RectangleHeight}"
                                                     Stroke="{Binding StrokeBrush}" StrokeThickness="{Binding StrokeWidthPixels}"
                                                     StrokeDashArray="{Binding StrokeDashArray}" Fill="{Binding FillBrush}"
                                                     Visibility="{Binding CircleVisibility}" />
                                            <ItemsControl ItemsSource="{Binding Markers}" Visibility="{Binding MarkerVisibility}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Ellipse Width="{Binding DataContext.MarkerSizePixels, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                 Height="{Binding DataContext.MarkerSizePixels, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                 Stroke="{Binding DataContext.MarkerStrokeBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                 StrokeThickness="{Binding DataContext.StrokeWidthPixels, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                 Fill="{Binding DataContext.MarkerFillBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Canvas.Left="{Binding LabelX}" Canvas.Top="{Binding LabelY}"
                                                       Text="{Binding Label}" Foreground="{Binding LabelBrush}"
                                                       FontFamily="{Binding LabelFontFamily}" FontSize="{Binding LabelFontSizePixels}"
                                                       FontWeight="{Binding LabelFontWeight}" Visibility="{Binding LabelVisibility}" />
                                        </Canvas>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl Width="{Binding Figure.CanvasWidth}"
                                          Height="{Binding Figure.CanvasHeight}"
                                          ItemsSource="{Binding Figure.RoiProjections}"
                                          Panel.ZIndex="96"
                                          IsHitTestVisible="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Canvas Width="{Binding DataContext.Figure.CanvasWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Height="{Binding DataContext.Figure.CanvasHeight, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <Rectangle Canvas.Left="{Binding ShapeX}" Canvas.Top="{Binding ShapeY}"
                                                       Width="{Binding ShapeWidth}" Height="{Binding ShapeHeight}"
                                                       Stroke="{Binding StrokeBrush}" StrokeThickness="{Binding StrokeWidthPixels}"
                                                       Fill="{Binding FillBrush}" Visibility="{Binding RectangleVisibility}" />
                                            <Ellipse Canvas.Left="{Binding ShapeX}" Canvas.Top="{Binding ShapeY}"
                                                     Width="{Binding ShapeWidth}" Height="{Binding ShapeHeight}"
                                                     Stroke="{Binding StrokeBrush}" StrokeThickness="{Binding StrokeWidthPixels}"
                                                     Fill="{Binding FillBrush}" Visibility="{Binding EllipseVisibility}" />
                                            <Polygon Points="{Binding Points}" Stroke="{Binding StrokeBrush}"
                                                     StrokeThickness="{Binding StrokeWidthPixels}" Fill="{Binding FillBrush}"
                                                     StrokeLineJoin="Round" Visibility="{Binding PolygonVisibility}" />
                                            <Polyline Points="{Binding Points}" Stroke="{Binding StrokeBrush}"
                                                      StrokeThickness="{Binding StrokeWidthPixels}"
                                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Visibility="{Binding PolylineVisibility}" />
                                            <TextBlock Canvas.Left="{Binding LabelX}" Canvas.Top="{Binding LabelY}"
                                                       Text="{Binding Label}" Foreground="{Binding LabelBrush}"
                                                       FontFamily="{Binding LabelFontFamily}" FontSize="{Binding LabelFontSizePixels}"
                                                       FontWeight="{Binding LabelFontWeight}" Visibility="{Binding LabelVisibility}" />
                                        </Canvas>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>

                    <StackPanel Visibility="{Binding Figure.EmptyVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock Text="{Binding Figure.TemplateName}" Foreground="#17202A" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Margin="0,10,0,0" Text="{Binding Figure.TemplateDescription}" Foreground="#45515E" FontSize="14" TextWrapping="Wrap" MaxWidth="620" TextAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Border x:Name="MeasurementDockPanel" Grid.Row="2"
                        Height="230"
                        Background="#11171F"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Visibility="{Binding MeasurementDockVisibility}">
                    <Grid Margin="12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="250" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition x:Name="MeasurementDockContentRow" Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding SelectedSource.MeasurementCountText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectedSource.MeasurementSummaryText}"
                                   Foreground="#AFC5D2" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button x:Name="MeasurementDockToggleButton"
                                Grid.Column="1"
                                Width="48"
                                Height="24"
                                Padding="4,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Panel.ZIndex="20"
                                Click="MeasurementDockToggleButton_OnClick"
                                Content="收起"
                                ToolTip="收起测量表，扩大图像画布高度" />
                        <DataGrid x:Name="MeasurementDockDataGrid" Grid.Row="1"
                                  Margin="0,4,10,0"
                                  ItemsSource="{Binding SelectedSource.Measurements}"
                                  SelectedItem="{Binding SelectedSource.SelectedMeasurement}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  RowHeaderWidth="0"
                                  GridLinesVisibility="Horizontal"
                                  Background="#0F151D"
                                  Foreground="#E8EDF4"
                                  BorderBrush="{StaticResource BorderBrush}"
                                  HorizontalGridLinesBrush="#26313D">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Number}" Width="42" />
                                <DataGridTextColumn Header="Image" Binding="{Binding SourceName}" Width="120" />
                                <DataGridTextColumn Header="Type" Binding="{Binding TypeText}" Width="72" />
                                <DataGridTextColumn Header="Value" Binding="{Binding ValueText}" Width="112" />
                                <DataGridTextColumn Header="Pixel" Binding="{Binding PixelValueText}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel x:Name="MeasurementDockActions" Grid.Row="1" Grid.Column="1" Margin="10,4,0,0">
                            <TextBlock Text="{Binding SelectedSource.SelectedMeasurementStatusText}"
                                       Foreground="#7DD9E9" FontSize="10" TextWrapping="Wrap" />
                            <TextBlock Margin="0,7,0,2"
                                       Text="{Binding SelectedSource.MeasurementHistogramStatusText}"
                                       Foreground="#AFC5D2" FontSize="9" TextTrimming="CharacterEllipsis" />
                            <Border Height="60"
                                    Padding="4"
                                    Background="#0B1016"
                                    BorderBrush="#26313D"
                                    BorderThickness="1"
                                    Visibility="{Binding SelectedSource.MeasurementHistogramVisibility}">
                                <ItemsControl ItemsSource="{Binding SelectedSource.MeasurementHistogramBars}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ToolTip="{Binding ToolTip}">
                                                <Border Height="{Binding HeightPixels}"
                                                        Margin="1,0"
                                                        VerticalAlignment="Bottom"
                                                        Background="#FF22C7E8"
                                                        CornerRadius="1,1,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <Button Margin="0,7,0,0" Command="{Binding DeleteSelectedMeasurementCommand}" Content="删除所选测量" />
                            <Button Margin="0,6,0,0" Command="{Binding PinSelectedMeasurementToFigureCommand}" Content="Pin 到 Figure" ToolTip="将所选测量以保持 MeasurementId、源修订和标定关系的科学 Overlay 添加到同源 Panel" />
                            <Button Margin="0,6,0,0" Command="{Binding CopyMeasurementsCommand}" Content="复制表格" />
                            <Button Margin="0,6,0,0" Command="{Binding ExportMeasurementsCommand}" Style="{StaticResource AccentButtonStyle}" Content="导出 CSV / Excel" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter x:Name="RightSidebarSplitter" Grid.Column="3" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#263442" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True" ToolTip="拖动调整检查器宽度" />

            <Border x:Name="RightSidebarPanel" Grid.Column="4" Background="{StaticResource PanelBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Background="#171E27">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="InspectorTabButton" Grid.Column="0" Command="{Binding ShowInspectorTabCommand}" Content="检查器" Background="#171E27" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                    <Setter Property="Background" Value="#171E27" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0,0,0,2" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInspectorTabActive}" Value="True">
                                            <Setter Property="Foreground" Value="#F5FBFF" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="LayersTabButton" Grid.Column="1" Command="{Binding ShowLayersTabCommand}" Content="图层" Background="#171E27" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                    <Setter Property="Background" Value="#171E27" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0,0,0,2" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLayersTabActive}" Value="True">
                                            <Setter Property="Foreground" Value="#F5FBFF" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="ChannelsTabButton" Grid.Column="2" Command="{Binding ShowChannelsTabCommand}" Content="通道" Background="#171E27" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                    <Setter Property="Background" Value="#171E27" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0,0,0,2" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChannelsTabActive}" Value="True">
                                            <Setter Property="Foreground" Value="#F5FBFF" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="LinkedViewsTabButton" Grid.Column="3" Command="{Binding ShowLinkedViewsTabCommand}" Content="联动" Background="#171E27" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                    <Setter Property="Background" Value="#171E27" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0,0,0,2" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLinkedViewsTabActive}" Value="True">
                                            <Setter Property="Foreground" Value="#F5FBFF" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
</Button>
                        <Button x:Name="RegistrationTabButton" Grid.Column="4" Command="{Binding ShowRegistrationTabCommand}" Content="配准" Background="#171E27" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                    <Setter Property="Background" Value="#171E27" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0,0,0,2" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRegistrationTabActive}" Value="True">
                                            <Setter Property="Foreground" Value="#F5FBFF" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
</Button>
                        <Button x:Name="RoiPropagationTabButton" Grid.Column="5" Command="{Binding ShowRoiPropagationTabCommand}" Content="ROI" Background="#171E27" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                    <Setter Property="Background" Value="#171E27" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0,0,0,2" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRoiPropagationTabActive}" Value="True">
                                            <Setter Property="Foreground" Value="#F5FBFF" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="PublishingPortabilityTabButton" Grid.Column="6" Command="{Binding ShowPublishingPortabilityTabCommand}" Content="发布" Background="#171E27" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                    <Setter Property="Background" Value="#171E27" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0,0,0,2" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPublishingPortabilityTabActive}" Value="True">
                                            <Setter Property="Foreground" Value="#F5FBFF" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="ScientificDataTabButton" Grid.Column="7" Command="{Binding ShowScientificDataTabCommand}" Content="数据" Background="#171E27" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                    <Setter Property="Background" Value="#171E27" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0,0,0,2" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScientificDataTabActive}" Value="True">
                                            <Setter Property="Foreground" Value="#F5FBFF" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="PlotTabButton" Grid.Column="8" Command="{Binding ShowPlotTabCommand}" Content="绘图" Background="#171E27" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                    <Setter Property="Background" Value="#171E27" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0,0,0,2" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlotTabActive}" Value="True">
                                            <Setter Property="Foreground" Value="#F5FBFF" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                    <app:InspectorWorkspace x:Name="InspectorWorkspacePanel"
                                            Grid.Row="1"
                                            Visibility="{Binding InspectorTabVisibility}" />
                    <app:LayersWorkspace x:Name="LayersWorkspacePanel"
                                         Grid.Row="1"
                                         Visibility="{Binding LayersTabVisibility}" />
                    <app:ChannelsInspector x:Name="ChannelsInspectorPanel"
                                           Grid.Row="1"
                                           DataContext="{Binding MultiChannelWorkspace}"
                                           Visibility="{Binding DataContext.ChannelsTabVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                    <app:LinkedViewsInspector x:Name="LinkedViewsInspectorPanel"
                                              Grid.Row="1"
                                              DataContext="{Binding LinkedViewsWorkspace}"
Visibility="{Binding DataContext.LinkedViewsTabVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                    <app:RegistrationWorkspace x:Name="RegistrationWorkspacePanel"
                                               Grid.Row="1"
                                               DataContext="{Binding RegistrationWorkspace}"
Visibility="{Binding DataContext.RegistrationTabVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                    <app:RoiPropagationWorkspace x:Name="RoiPropagationWorkspacePanel"
                                                 Grid.Row="1"
                                                 DataContext="{Binding RoiPropagationWorkspace}"
                                                 Visibility="{Binding DataContext.RoiPropagationTabVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                    <app:PublishingPortabilityWorkspace x:Name="PublishingPortabilityWorkspacePanel"
                                                        Grid.Row="1"
                                                        DataContext="{Binding PublishingPortabilityWorkspace}"
                                                        Visibility="{Binding DataContext.PublishingPortabilityTabVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                    <app:ScientificDataWorkspace x:Name="ScientificDataWorkspacePanel"
                                                 Grid.Row="1"
                                                 DataContext="{Binding ScientificDataWorkspace}"
                                                 Visibility="{Binding DataContext.ScientificDataTabVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                    <app:PlotWorkspace x:Name="PlotWorkspacePanel"
                                       Grid.Row="1"
                                       DataContext="{Binding PlotWorkspace}"
                                       Visibility="{Binding DataContext.PlotTabVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                </Grid>
            </Border>

            <Button x:Name="RightSidebarToggleButton"
                    Grid.Column="4"
                    Width="26"
                    Height="54"
                    Padding="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Panel.ZIndex="50"
                    Click="RightSidebarToggleButton_OnClick"
                    Content="›"
                    ToolTip="收起检查器，扩大中央画布" />
        </Grid>

        <Border Grid.Row="3" Background="#10161E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="●" Foreground="#62D49C" FontSize="9" />
                    <TextBlock Margin="6,0,0,0" Text="{Binding StatusMessage}" Foreground="#AEB9C6" FontSize="10" />
                    <TextBlock Margin="14,0,0,0" Text="{Binding LastError}" Foreground="#F28A8A" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="560" ToolTip="{Binding LastError}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Margin="0,0,14,0" Text="{Binding AutosaveStatusText}" Foreground="#62D49C" FontSize="9" />
                    <TextBlock Text="{Binding HistoryStatusText}" Foreground="#7FA8B5" FontSize="9" />
                    <TextBlock Margin="14,0,0,0" Text="本地模式 · 无网络上传" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
