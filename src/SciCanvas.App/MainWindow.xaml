                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="整体缩放 / %" Foreground="{StaticResource MutedBrush}" FontSize="9" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="2"
                                             Text="{Binding Figure.SelectedPanel.ScalePercent, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.#}}"
                                             ToolTip="按源图比例同时缩放宽高，范围 1%—1000%。" />
                                </Grid>
                                <TextBlock Margin="0,5,0,0" Text="{Binding Figure.SelectedPanel.AspectRatioText}" Foreground="{StaticResource MutedBrush}" FontSize="8" />
                                <TextBlock Margin="0,2,0,0" Text="{Binding Figure.SelectedPanel.SizeStatusText}" Foreground="#80DDEA" FontSize="9" />

                                <TextBlock Margin="0,12,0,6" Text="对齐到画布" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                <UniformGrid Columns="3" Rows="2">
                                    <Button Margin="0,0,5,5" Padding="6" Command="{Binding Figure.AlignPanelLeftCommand}" Content="左" />
                                    <Button Margin="0,0,5,5" Padding="6" Command="{Binding Figure.AlignPanelHorizontalCenterCommand}" Content="水平中" />
                                    <Button Margin="0,0,0,5" Padding="6" Command="{Binding Figure.AlignPanelRightCommand}" Content="右" />
                                    <Button Margin="0,0,5,0" Padding="6" Command="{Binding Figure.AlignPanelTopCommand}" Content="上" />
                                    <Button Margin="0,0,5,0" Padding="6" Command="{Binding Figure.AlignPanelVerticalCenterCommand}" Content="垂直中" />
                                    <Button Padding="6" Command="{Binding Figure.AlignPanelBottomCommand}" Content="下" />
                                </UniformGrid>

                                <Border Margin="0,12,0,0"
                                        Padding="9"
                                        Background="#10212A"
                                        BorderBrush="#245A68"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Visibility="{Binding Figure.MultiplePanelSelectionVisibility}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Figure.SelectedPanelCountText}" Foreground="#8CE5F4" FontSize="10" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,0,7" Text="所选面板相互对齐；锁定面板作为参照但不会移动。" Foreground="{StaticResource MutedBrush}" FontSize="8" TextWrapping="Wrap" />
                                        <UniformGrid Columns="3" Rows="2">
                                            <Button Margin="0,0,5,5" Padding="5" Command="{Binding Figure.AlignSelectionLeftCommand}" Content="齐左" />
                                            <Button Margin="0,0,5,5" Padding="5" Command="{Binding Figure.AlignSelectionHorizontalCenterCommand}" Content="横中" />
                                            <Button Margin="0,0,0,5" Padding="5" Command="{Binding Figure.AlignSelectionRightCommand}" Content="齐右" />
                                            <Button Margin="0,0,5,0" Padding="5" Command="{Binding Figure.AlignSelectionTopCommand}" Content="齐上" />
                                            <Button Margin="0,0,5,0" Padding="5" Command="{Binding Figure.AlignSelectionVerticalCenterCommand}" Content="纵中" />
                                            <Button Padding="5" Command="{Binding Figure.AlignSelectionBottomCommand}" Content="齐下" />
                                        </UniformGrid>
                                        <UniformGrid Margin="0,7,0,0" Columns="2">
                                            <Button Margin="0,0,5,0" Padding="5" Command="{Binding Figure.DistributeSelectionHorizontallyCommand}" Content="水平等距" />
                                            <Button Padding="5" Command="{Binding Figure.DistributeSelectionVerticallyCommand}" Content="垂直等距" />
                                        </UniformGrid>
                                        <UniformGrid Margin="0,7,0,0" Columns="2">
                                            <Button Margin="0,0,5,0" Padding="5" Command="{Binding Figure.LinkSelectedPanelCropsCommand}" Content="关联裁剪" ToolTip="所选面板必须来自同一源图；之后替换其中一个裁剪会同步到同组面板" />
                                            <Button Padding="5" Command="{Binding Figure.UnlinkSelectedPanelCropsCommand}" Content="解除关联" />
                                        </UniformGrid>
                                        <TextBlock Margin="0,9,0,5"
                                                   Text="匹配主选面板（最后选中的高亮面板）"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="8" />
                                        <UniformGrid Columns="4">
                                            <Button Margin="0,0,4,0" Padding="4" Command="{Binding Figure.MatchSelectionWidthCommand}" Content="同宽" />
                                            <Button Margin="0,0,4,0" Padding="4" Command="{Binding Figure.MatchSelectionHeightCommand}" Content="同高" />
                                            <Button Margin="0,0,4,0" Padding="4" Command="{Binding Figure.MatchSelectionFrameCommand}" Content="同框" />
                                            <Button Padding="4" Command="{Binding Figure.MatchSelectionAspectRatioCommand}" Content="同比" ToolTip="保持各自宽度，将宽高比匹配到主选面板" />
                                        </UniformGrid>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="精确边界间距 / px" Foreground="{StaticResource MutedBrush}" FontSize="9" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="2" Text="{Binding Figure.ExactSpacingPixels, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                        <UniformGrid Margin="0,6,0,0" Columns="2">
                                            <Button Margin="0,0,5,0" Padding="5" Command="{Binding Figure.SetHorizontalSpacingCommand}" Content="应用水平间距" />
                                            <Button Padding="5" Command="{Binding Figure.SetVerticalSpacingCommand}" Content="应用垂直间距" />
                                        </UniformGrid>
                                        <TextBlock Margin="0,5,0,0" Text="{Binding Figure.ExactSpacingStatusText}" Foreground="{StaticResource MutedBrush}" FontSize="8" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Expander Margin="0,14,0,0" Header="Panel 局部样式覆盖" IsExpanded="False">
                                    <Border Margin="0,6,0,0" Padding="9" Background="#101820" BorderBrush="#334454" BorderThickness="1" CornerRadius="3">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Figure.SelectedPanelStyleOverrideStatusText}" Foreground="#80DDEA" FontSize="8" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,9,0,0" Text="Panel Label" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="SemiBold" />
                                            <ComboBox Margin="0,5,0,0" IsEditable="True" IsTextSearchEnabled="True"
                                                      ItemsSource="{Binding Figure.SelectedPanelLabelFontChoices}"
                                                      Text="{Binding Figure.SelectedPanelLabelFontFamily, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Margin="0,3,0,0" Text="{Binding Figure.SelectedPanelLabelFontAvailabilityMessage}" Foreground="#FFFFB74D" FontSize="8" TextWrapping="Wrap" />
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="文字颜色" Foreground="{StaticResource MutedBrush}" FontSize="8" />
                                                    <Grid Margin="0,3,0,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="4" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <TextBox Text="{Binding Figure.SelectedPanelLabelTextColor, UpdateSourceTrigger=PropertyChanged}" />
                                                        <Button Grid.Column="2" Width="36" Padding="3" Background="{Binding Figure.SelectedPanelLabelTextBrush}" Click="SelectedPanelLabelColorPicker_OnClick" Content="取色" />
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="字号 / pt" Foreground="{StaticResource MutedBrush}" FontSize="8" />
                                                    <TextBox Margin="0,3,0,0" Text="{Binding Figure.SelectedPanelLabelFontSizePt, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding Figure.SelectedPanelLabelIsBold}" Content="粗体" />
                                                <Button Margin="16,0,0,0" Padding="7,3" Command="{Binding Figure.ResetSelectedPanelLabelStyleCommand}" Content="恢复继承" />
                                            </StackPanel>

                                            <TextBlock Margin="0,12,0,0" Text="Scale Bar" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="SemiBold" />
                                            <ComboBox Margin="0,5,0,0" IsEditable="True" IsTextSearchEnabled="True"
                                                      ItemsSource="{Binding Figure.SelectedPanelScaleBarFontChoices}"
                                                      Text="{Binding Figure.SelectedPanelScaleBarFontFamily, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Margin="0,3,0,0" Text="{Binding Figure.SelectedPanelScaleBarFontAvailabilityMessage}" Foreground="#FFFFB74D" FontSize="8" TextWrapping="Wrap" />
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="尺线颜色" Foreground="{StaticResource MutedBrush}" FontSize="8" />
                                                    <Grid Margin="0,3,0,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="4" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <TextBox Text="{Binding Figure.SelectedPanelScaleBarColor, UpdateSourceTrigger=PropertyChanged}" />
                                                        <Button Grid.Column="2" Width="36" Padding="3" Background="{Binding Figure.SelectedPanelScaleBarBrush}" Click="SelectedPanelScaleBarColorPicker_OnClick" Content="取色" />
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="文字颜色" Foreground="{StaticResource MutedBrush}" FontSize="8" />
                                                    <Grid Margin="0,3,0,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="4" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <TextBox Text="{Binding Figure.SelectedPanelScaleBarLabelColor, UpdateSourceTrigger=PropertyChanged}" />
                                                        <Button Grid.Column="2" Width="36" Padding="3" Background="{Binding Figure.SelectedPanelScaleBarLabelBrush}" Click="SelectedPanelScaleBarLabelColorPicker_OnClick" Content="取色" />
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="字号 / pt" Foreground="{StaticResource MutedBrush}" FontSize="8" />
                                                    <TextBox Margin="0,3,0,0" Text="{Binding Figure.SelectedPanelScaleBarFontSizePt, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="尺线厚度 / pt" Foreground="{StaticResource MutedBrush}" FontSize="8" />
                                                    <TextBox Margin="0,3,0,0" Text="{Binding Figure.SelectedPanelScaleBarThicknessPt, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding Figure.SelectedPanelScaleBarLabelIsBold}" Content="文字粗体" />
                                                <Button Margin="16,0,0,0" Padding="7,3" Command="{Binding Figure.ResetSelectedPanelScaleBarStyleCommand}" Content="恢复继承" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Expander>

                                <Border Margin="0,14,0,0" Padding="9" Background="#101820" BorderBrush="#334454" BorderThickness="1" CornerRadius="3">
                                    <StackPanel>
                                        <CheckBox IsChecked="{Binding Figure.SelectedPanel.ShowScaleBar}"
                                                  Content="显示经过校准的比例尺" />
                                        <TextBlock Margin="0,6,0,0" Text="{Binding Figure.SelectedPanel.CropLinkStatusText}" Foreground="{StaticResource MutedBrush}" FontSize="8" />
                                        <Button Margin="0,7,0,0" Command="{Binding Figure.CreateInsetCommand}" Content="创建 Inset 局部放大" />
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="校准值 / 源像素" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                                <TextBox Margin="0,4,0,0"
                                                         Text="{Binding Figure.SelectedPanel.PhysicalUnitsPerSourcePixel, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="主比例尺长度" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                                <TextBox Margin="0,4,0,0"
                                                         Text="{Binding Figure.SelectedPanel.ScaleBarPhysicalLength, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="主比例尺显示单位" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                                <ComboBox Margin="0,4,0,0"
                                                          IsEditable="True"
                                                          Text="{Binding Figure.SelectedPanel.ScaleBarUnit, UpdateSourceTrigger=PropertyChanged}">
                                                    <ComboBoxItem Content="nm" />
                                                    <ComboBoxItem Content="µm" />
                                                    <ComboBoxItem Content="mm" />
                                                </ComboBox>
                                            </StackPanel>
                                            <CheckBox Grid.Column="2"
                                                      VerticalAlignment="Bottom"
                                                      Margin="0,0,0,6"
                                                      IsChecked="{Binding Figure.SelectedPanel.ScaleBarShowLabel}"
                                                      Content="显示数值标签" />
                                        </Grid>
                                        <StackPanel Margin="0,7,0,0">
                                            <TextBlock Text="校准单位（校准值 / 源像素）" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                            <ComboBox Margin="0,4,0,0"
                                                      IsEditable="True"
                                                      Text="{Binding Figure.SelectedPanel.CalibrationUnit, UpdateSourceTrigger=PropertyChanged}">
                                                <ComboBoxItem Content="nm" />
                                                <ComboBoxItem Content="µm" />
                                                <ComboBoxItem Content="mm" />
                                            </ComboBox>
                                        </StackPanel>
                                        <Border Margin="0,10,0,0" Padding="7" Background="#0D151D" BorderBrush="#2D3E4D" BorderThickness="1" CornerRadius="3">
                                            <StackPanel>
                                                <DockPanel LastChildFill="False">
                                                    <TextBlock DockPanel.Dock="Left" Text="额外比例尺" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="SemiBold" />
                                                    <Button DockPanel.Dock="Right" Padding="7,2" Command="{Binding Figure.AddAdditionalScaleBarCommand}" Content="+ 新增" />
                                                </DockPanel>
                                                <TextBlock Margin="0,4,0,0" Text="与当前 Panel 共享校准值；显示单位可独立换算。" Foreground="{StaticResource MutedBrush}" FontSize="8" TextWrapping="Wrap" />
                                                <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Figure.SelectedPanel.AdditionalScaleBars}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,3,0,0" Padding="6" Background="#111E28" BorderBrush="#304657" BorderThickness="1" CornerRadius="2">
                                                                <StackPanel>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                                        <TextBox Text="{Binding PhysicalLength, UpdateSourceTrigger=PropertyChanged}" />
                                                                        <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableUnits}" SelectedItem="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" />
                                                                    </Grid>
                                                                    <Grid Margin="0,5,0,0">
                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                        <ComboBox ItemsSource="{Binding AvailableAnchors}" SelectedItem="{Binding Anchor, UpdateSourceTrigger=PropertyChanged}" />
                                                                        <Button Grid.Column="2" Margin="8,0,0,0" Padding="7,2" Command="{Binding RemoveCommand}" Content="删除" />
                                                                    </Grid>
                                                                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                                                        <CheckBox IsChecked="{Binding ShowLabel}" Content="显示标签" />
                                                                        <CheckBox Margin="12,0,0,0" IsChecked="{Binding IsVisible}" Content="显示" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>                                        <TextBlock Margin="0,8,0,0"
                                                   Text="{Binding Figure.SelectedPanel.ScaleBarStatusText}"
                                                   Foreground="#80DDEA"
                                                   FontSize="9"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,5,0,0"
                                                   Text="校准值应来自显微镜元数据或实验记录；软件不会猜测物理尺度。"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="8"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,20,0,8">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="非破坏性图像处理" />
                            <TextBlock HorizontalAlignment="Right" Text="显示层" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                        </Grid>
                        <Border Padding="10" Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="仅记录参数，不改写源图；导出时从原始像素重新渲染。" Foreground="{StaticResource MutedBrush}" FontSize="8" TextWrapping="Wrap" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="亮度 (-100—+100)" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <Slider Margin="0,4,0,0"
                                                Minimum="-100"
                                                Maximum="100"
                                                SmallChange="1"
                                                LargeChange="10"
                                                IsSnapToTickEnabled="False"
                                                Height="18"
                                                Foreground="{StaticResource AccentBrush}"
                                                Value="{Binding Figure.SelectedPanel.BrightnessPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Margin="0,3,0,0" Text="{Binding Figure.SelectedPanel.BrightnessPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="对比度 (-100—+100)" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <Slider Margin="0,4,0,0"
                                                Minimum="-100"
                                                Maximum="100"
                                                SmallChange="1"
                                                LargeChange="10"
                                                IsSnapToTickEnabled="False"
                                                Height="18"
                                                Foreground="{StaticResource AccentBrush}"
                                                Value="{Binding Figure.SelectedPanel.ContrastPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Margin="0,3,0,0" Text="{Binding Figure.SelectedPanel.ContrastPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Gamma (0.1—10)" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <TextBox Margin="0,3,0,0" Text="{Binding Figure.SelectedPanel.Gamma, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="黑点 (0—1)" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <TextBox Margin="0,3,0,0" Text="{Binding Figure.SelectedPanel.BlackPoint, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
