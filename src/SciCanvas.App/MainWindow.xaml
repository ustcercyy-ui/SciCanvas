                                <TextBox Text="{Binding Figure.SelectedPanel.Label, UpdateSourceTrigger=PropertyChanged}" MaxLength="16" />
                                <TextBlock Margin="0,5,0,0" Text="{Binding Figure.SelectedPanel.FrameStatusText}" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                <StackPanel Margin="0,5,0,0" Visibility="{Binding Figure.SelectedPanel.FrameSelectionVisibility}">
                                    <TextBlock Text="多页图像帧（从 1 开始）" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                    <TextBox Margin="0,3,0,0" Text="{Binding Figure.SelectedPanel.FrameNumber, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <TextBlock Margin="0,5,0,0" Text="{Binding Figure.SelectedPanel.EffectiveDpiText}" Foreground="#80DDEA" FontSize="10" />
                                <Border Margin="0,6,0,0"
                                        Padding="7"
                                        Background="#2A2414"
                                        BorderBrush="#8D7735"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Visibility="{Binding Figure.SelectedPanel.RequiresScientificReview, Converter={StaticResource BooleanToVisibility}}">
                                    <TextBlock Text="{Binding Figure.SelectedPanel.ScientificValidityText}" Foreground="#F2D272" FontSize="9" TextWrapping="Wrap" />
                                </Border>
                                <TextBlock Margin="0,4,0,0" Text="{Binding Figure.SelectedPanel.HelpText}" Foreground="{StaticResource MutedBrush}" FontSize="9" TextWrapping="Wrap" />
                                <Button Margin="0,8,0,0" Command="{Binding ReplaceSelectedPanelSourceCommand}" Content="用当前源图替换面板" />
                                <TextBlock Margin="0,8,0,0" Text="图像适配" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                <ComboBox Margin="0,4,0,0"
                                          ItemsSource="{Binding Figure.SelectedPanel.AvailableFitModes}"
                                          SelectedItem="{Binding Figure.SelectedPanel.FitMode}" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="X / mm" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <TextBox Margin="0,4,0,0" Text="{Binding Figure.SelectedPanel.XMm, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.###}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Y / mm" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <TextBox Margin="0,4,0,0" Text="{Binding Figure.SelectedPanel.YMm, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.###}}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Margin="0,12,0,6" Text="Panel Frame / mm" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="宽度" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <TextBox Margin="0,4,0,0" Text="{Binding Figure.SelectedPanel.WidthMm, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.###}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="高度" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <TextBox Margin="0,4,0,0" Text="{Binding Figure.SelectedPanel.HeightMm, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.###}}" />
                                    </StackPanel>
                                </Grid>
                                <CheckBox Margin="0,8,0,0"
                                          IsChecked="{Binding Figure.SelectedPanel.IsAspectRatioLocked}"
                                          Content="锁定源图比例（等比缩放）"
