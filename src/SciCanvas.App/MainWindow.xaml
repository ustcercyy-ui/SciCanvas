<Window x:Class="SciCanvas.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:SciCanvas.App"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding ProjectDisplayName, StringFormat={}{0} · SciCanvas}"
        Width="1360"
        Height="860"
        MinWidth="720"
        MinHeight="480"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Closing="MainWindow_OnClosing"
        Loaded="MainWindow_OnLoaded"
        PreviewKeyDown="MainWindow_OnPreviewKeyDown"
        Background="#0D1117"
        Foreground="#E8EDF4">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProjectCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveProjectAsCommand}" />
        <KeyBinding Key="I" Modifiers="Control" Command="{Binding OpenSourcesCommand}" />
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding AddCurrentCropToFigureCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding RedoCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

        <SolidColorBrush x:Key="PanelBrush" Color="#141A22" />
        <SolidColorBrush x:Key="PanelRaisedBrush" Color="#1A222D" />
        <SolidColorBrush x:Key="BorderBrush" Color="#2B3543" />
        <SolidColorBrush x:Key="MutedBrush" Color="#8F9BAD" />
        <SolidColorBrush x:Key="AccentBrush" Color="#22C7E8" />

        <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
            <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Focusable="False">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False">
                            <RepeatButton.Template>
                                <ControlTemplate TargetType="{x:Type RepeatButton}">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </RepeatButton.Template>
                        </RepeatButton>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb MinHeight="24" Margin="2" Background="{TemplateBinding Foreground}">
                            <Thumb.Template>
                                <ControlTemplate TargetType="{x:Type Thumb}">
                                    <Border x:Name="ThumbBorder" Background="{TemplateBinding Background}" CornerRadius="4" />
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ThumbBorder" Property="Background" Value="#6E8194" />
                                        </Trigger>
                                        <Trigger Property="IsDragging" Value="True">
                                            <Setter TargetName="ThumbBorder" Property="Background" Value="#22C7E8" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False">
                            <RepeatButton.Template>
                                <ControlTemplate TargetType="{x:Type RepeatButton}">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </RepeatButton.Template>
                        </RepeatButton>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
            <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                <Track x:Name="PART_Track" Orientation="Horizontal" IsDirectionReversed="False" Focusable="False">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Focusable="False">
                            <RepeatButton.Template>
                                <ControlTemplate TargetType="{x:Type RepeatButton}">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </RepeatButton.Template>
                        </RepeatButton>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb MinWidth="24" Margin="2" Background="{TemplateBinding Foreground}">
                            <Thumb.Template>
                                <ControlTemplate TargetType="{x:Type Thumb}">
                                    <Border x:Name="ThumbBorder" Background="{TemplateBinding Background}" CornerRadius="4" />
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ThumbBorder" Property="Background" Value="#6E8194" />
                                        </Trigger>
                                        <Trigger Property="IsDragging" Value="True">
                                            <Setter TargetName="ThumbBorder" Property="Background" Value="#22C7E8" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Focusable="False">
                            <RepeatButton.Template>
                                <ControlTemplate TargetType="{x:Type RepeatButton}">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </RepeatButton.Template>
                        </RepeatButton>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="#10161E" />
            <Setter Property="Foreground" Value="#526579" />
            <Setter Property="Width" Value="12" />
            <Setter Property="MinWidth" Value="12" />
            <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}" />
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="12" />
                    <Setter Property="MinHeight" Value="12" />
                    <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E8EDF4" />
            <Setter Property="Background" Value="#202A36" />
            <Setter Property="BorderBrush" Value="#344253" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#293646" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#16222C" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#087E98" />
            <Setter Property="BorderBrush" Value="#26D8F6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="ToolButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                    <Setter Property="Background" Value="#087E98" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Foreground" Value="#F5FBFF" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="CompactToolButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolButtonStyle}">
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#101820" />
            <Setter Property="Background" Value="#0F151D" />
            <Setter Property="BorderBrush" Value="#354253" />
            <Setter Property="Padding" Value="7,5" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="#0F151D" />
            <Setter Property="Foreground" Value="#E8EDF4" />
            <Setter Property="BorderBrush" Value="#26313D" />
            <Setter Property="Padding" Value="7,3" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#174B59" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                    <Setter Property="BorderBrush" Value="#22C7E8" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1A222D" />
            <Setter Property="Foreground" Value="#AEB9C7" />
            <Setter Property="BorderBrush" Value="#2B3543" />
            <Setter Property="Padding" Value="7,5" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#0F151D" />
            <Setter Property="Foreground" Value="#E8EDF4" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#174B59" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#F4F7FA" />
            <Setter Property="Background" Value="#0F151D" />
            <Setter Property="BorderBrush" Value="#354253" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CaretBrush" Value="#22C7E8" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DDE5EE" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AEB9C7" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition x:Name="HeaderContentRow" Height="98" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.RowSpan="2" Background="#121820" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition x:Name="HeaderInnerContentRow" Height="98" />
                </Grid.RowDefinitions>
                <Menu Grid.Row="0" Margin="8,0" Background="Transparent" Foreground="#D8E0E8" VerticalContentAlignment="Center">
                    <Menu.Resources>
                        <Style TargetType="MenuItem">
                            <Setter Property="Foreground" Value="#D8E0E8" />
                            <Setter Property="Background" Value="#171E27" />
                            <Setter Property="Padding" Value="10,5" />
                        </Style>
                    </Menu.Resources>
                    <MenuItem Header="文件(F)">
                        <MenuItem Header="新建工程" Command="{Binding NewProjectCommand}" />
                        <MenuItem Header="打开工程…" Command="{Binding OpenProjectCommand}" />
                        <MenuItem Header="保存工程" Command="{Binding SaveProjectCommand}" />
                        <MenuItem Header="另存为…" Command="{Binding SaveProjectAsCommand}" />
                        <Separator />
                        <MenuItem Header="导入图像…" Command="{Binding OpenSourcesCommand}" />
                    </MenuItem>
                    <MenuItem Header="编辑(E)">
                        <MenuItem Header="撤销" Command="{Binding UndoCommand}" />
                        <MenuItem Header="重做" Command="{Binding RedoCommand}" />
                    </MenuItem>
                    <MenuItem Header="视图(V)">
                        <MenuItem Header="裁剪视图" Command="{Binding ShowCropWorkspaceCommand}" />
                        <MenuItem Header="拼版视图" Command="{Binding ShowFigureWorkspaceCommand}" />
                        <Separator />
                        <MenuItem Header="检查器" Command="{Binding ShowInspectorTabCommand}" />
                        <MenuItem Header="图层" Command="{Binding ShowLayersTabCommand}" />
                        <MenuItem Header="科学数据" Command="{Binding ShowScientificDataTabCommand}" />
                        <MenuItem Header="科学绘图" Command="{Binding ShowPlotTabCommand}" />
                    </MenuItem>
                    <MenuItem Header="图像(I)">
                        <MenuItem Header="导出当前裁剪" Command="{Binding ExportCropCommand}" />
                        <MenuItem Header="批量导出裁剪" Command="{Binding ExportBatchCropsCommand}" />
                    </MenuItem>
                    <MenuItem Header="测量(A)">
                        <MenuItem Header="标定参考线" Command="{Binding SelectCalibrationToolCommand}" />
                        <Separator />
                        <MenuItem Header="长度" Command="{Binding SelectLengthToolCommand}" />
                        <MenuItem Header="角度（三点）" Command="{Binding SelectAngleToolCommand}" />
                        <MenuItem Header="矩形区域测量" Command="{Binding SelectRectangleRoiToolCommand}" />
                        <MenuItem Header="圆形区域测量" Command="{Binding SelectCircleRoiToolCommand}" />
                        <MenuItem Header="折线长度测量（双击完成）" Command="{Binding SelectPolylineToolCommand}" />
                        <Separator />
                        <MenuItem Header="复制测量表" Command="{Binding CopyMeasurementsCommand}" />
                        <MenuItem Header="导出测量 CSV / Excel" Command="{Binding ExportMeasurementsCommand}" />
                        <MenuItem Header="Pin 所选测量到 Figure" Command="{Binding PinSelectedMeasurementToFigureCommand}" />
                    </MenuItem>
                    <MenuItem Header="裁剪(C)">
                        <MenuItem Header="加入当前裁剪到拼版" Command="{Binding AddCurrentCropToFigureCommand}" />
                        <MenuItem Header="加入批量裁剪队列" Command="{Binding AddCurrentCropToBatchQueueCommand}" />
                    </MenuItem>
                    <MenuItem Header="拼版(M)">
                        <MenuItem Header="导出整张拼版" Command="{Binding ExportFigureCommand}" />
                        <MenuItem Header="批量导出投稿版本" Command="{Binding ExportFigureVariantsCommand}" />
                        <MenuItem Header="生成投稿包…" Command="{Binding BuildSubmissionPackageCommand}" />
                        <Separator />
                        <MenuItem Header="运行 Figure QC" Command="{Binding RunFigureQcCommand}" />
                    </MenuItem>
                    <MenuItem Header="工具(T)">
                        <MenuItem Header="{Binding TemplateLibraryLabel}" Command="{Binding ShowFigureWorkspaceCommand}" />
                        <MenuItem Header="导入用户模板" Command="{Binding ImportTemplateCommand}" />
                    </MenuItem>
                    <MenuItem Header="帮助(H)">
                        <MenuItem Header="关于与快捷键" Command="{Binding ShowHelpCommand}" />
                    </MenuItem>
                </Menu>
                <Button x:Name="HeaderToggleButton"
                        Grid.Row="0"
                        Width="52"
                        Height="24"
                        Margin="0,3,8,3"
                        Padding="4,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Panel.ZIndex="20"
                        Click="HeaderToggleButton_OnClick"
                        Content="收起"
                        ToolTip="收起顶部命令区，扩大画布高度" />
                <Grid x:Name="HeaderCommandArea" Grid.Row="1" Margin="14,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50" />
                        <RowDefinition Height="48" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" Margin="0,0,8,0" Background="#0A829B" CornerRadius="6">
                                <TextBlock Text="SC" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="10" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="SciCanvas" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="LOCAL · NON-DESTRUCTIVE" Foreground="{StaticResource MutedBrush}" FontSize="8" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="18,0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Command="{Binding OpenSourcesCommand}" Style="{StaticResource AccentButtonStyle}" Padding="9,5" FontSize="11" Content="导入图像" />
                            <Button Margin="6,0,0,0" Command="{Binding NewProjectCommand}" Style="{StaticResource HeaderButtonStyle}" Content="新建" />
                            <Button Margin="6,0,0,0" Command="{Binding OpenProjectCommand}" Style="{StaticResource HeaderButtonStyle}" Content="打开" />
                            <Button Margin="6,0,0,0" Command="{Binding SaveProjectCommand}" Style="{StaticResource HeaderButtonStyle}" Content="保存" />
                            <Button Margin="6,0,0,0" Command="{Binding UndoCommand}" Style="{StaticResource HeaderButtonStyle}" Content="撤销" ToolTip="Ctrl+Z" />
                            <Button Margin="6,0,0,0" Command="{Binding RedoCommand}" Style="{StaticResource HeaderButtonStyle}" Content="重做" ToolTip="Ctrl+Y 或 Ctrl+Shift+Z" />
                        </StackPanel>
                        <Border Grid.Column="2" Padding="8,4" Background="#10251E" BorderBrush="#256B51" BorderThickness="1" CornerRadius="12" VerticalAlignment="Center">
                            <TextBlock Text="源文件只读保护" Foreground="#75D9AA" FontSize="10" />
                        </Border>
                    </Grid>
                    <Border Grid.Row="1" Margin="0,3,0,5" Padding="6,0" Background="#0F151D" BorderBrush="#26313D" BorderThickness="1" CornerRadius="5">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Command="{Binding SelectCropToolCommand}" Style="{StaticResource CompactToolButtonStyle}" Tag="{Binding IsCropToolActive}" Content="裁剪" ToolTip="V · 裁剪工具" />
                            <Button Command="{Binding SelectCalibrationToolCommand}" Style="{StaticResource CompactToolButtonStyle}" Tag="{Binding IsCalibrationToolActive}" Content="标定" ToolTip="K · 拖动参考线建立空间尺度" />
                            <Button Command="{Binding SelectLengthToolCommand}" Style="{StaticResource CompactToolButtonStyle}" Tag="{Binding IsLengthToolActive}" Content="长度" ToolTip="L" />
                            <Button Command="{Binding SelectAngleToolCommand}" Style="{StaticResource CompactToolButtonStyle}" Tag="{Binding IsAngleToolActive}" Content="角度" ToolTip="A" />
                            <Button Command="{Binding SelectRectangleRoiToolCommand}" Style="{StaticResource CompactToolButtonStyle}" Tag="{Binding IsRectangleRoiToolActive}" Content="矩形测量" />
                            <Button Command="{Binding SelectCircleRoiToolCommand}" Style="{StaticResource CompactToolButtonStyle}" Tag="{Binding IsCircleRoiToolActive}" Content="圆形测量" />
                            <Button Command="{Binding SelectPolylineToolCommand}" Style="{StaticResource CompactToolButtonStyle}" Tag="{Binding IsPolylineToolActive}" Content="折线测量" />
                            <Button Margin="12,0,0,0" Command="{Binding ShowFigureWorkspaceCommand}" Style="{StaticResource CompactToolButtonStyle}" Content="拼版视图" />
                            <Button Margin="6,0,0,0" Command="{Binding AddCurrentCropToFigureCommand}" Style="{StaticResource AccentButtonStyle}" Padding="9,5" FontSize="11" Content="加入拼版" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftSidebarColumn" Width="0.75*" MinWidth="160" MaxWidth="340" />
                <ColumnDefinition x:Name="LeftSplitterColumn" Width="6" />
                <ColumnDefinition Width="2*" MinWidth="280" />
                <ColumnDefinition x:Name="RightSplitterColumn" Width="6" />
                <ColumnDefinition x:Name="RightSidebarColumn" Width="1.05*" MinWidth="230" MaxWidth="420" />
            </Grid.ColumnDefinitions>

            <Border x:Name="LeftSidebarPanel" Grid.Column="0" Background="{StaticResource PanelBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="106" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="10,8,10,7">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="32" />
                        </Grid.RowDefinitions>
                        <UniformGrid Columns="4">
                            <Button Padding="5,3" Style="{StaticResource ToolButtonStyle}" Tag="{Binding IsAssetWorkspaceActive}" Command="{Binding ShowCropWorkspaceCommand}" Content="Assets" ToolTip="项目资产库" />
                            <Button Padding="5,3" Style="{StaticResource ToolButtonStyle}" Tag="{Binding IsFigureWorkspaceActive}" Command="{Binding ShowFigureWorkspaceCommand}" Content="Figures" ToolTip="当前 Figure 工作区" />
                            <Button Padding="5,3" Style="{StaticResource ToolButtonStyle}" Tag="{Binding IsLayersTabActive}" Command="{Binding ShowLayersTabCommand}" Content="Layers" ToolTip="科学对象与图层" />
                            <Button Padding="5,3" Style="{StaticResource ToolButtonStyle}" Command="{Binding ShowFigureWorkspaceCommand}" Content="Templates" ToolTip="Figure 模板" />
                        </UniformGrid>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Asset Library" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Sources.Count, StringFormat={}{0} 项}" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
                        </Grid>
                        <TextBox Grid.Row="2"
                                 Padding="7,4"
                                 Text="{Binding AssetSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="按名称、路径、类型或链接状态筛选"
                                 AutomationProperties.Name="搜索项目资产" />
                    </Grid>

                    <ListBox Grid.Row="1"
                             Margin="8,0,8,8"
                             Padding="0"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding AssetsView}"
                             SelectedItem="{Binding SelectedSource}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#203442" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Background="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Background}" CornerRadius="5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="66" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="58" Height="58" Background="#0B0F14" CornerRadius="3" ClipToBounds="True">
                                            <Image Source="{Binding Preview}" Stretch="Uniform" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding OriginalPath}" />
                                            <TextBlock Margin="0,4,0,0" Text="{Binding DimensionsText}" Foreground="#B8C4D1" FontSize="10" />
                                            <TextBlock Margin="0,2,0,0"
                                                       Text="{Binding DetailsText, Mode=OneWay}"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="9" />
                                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                                <Border Padding="4,1" Background="#163B46" CornerRadius="3">
                                                    <TextBlock Text="{Binding AssetKindText}" Foreground="#80DDEA" FontSize="8" />
                                                </Border>
                                                <TextBlock Margin="6,0,0,0" Text="{Binding UsageText}" Foreground="#B8C4D1" FontSize="8" />
                                                <TextBlock Margin="6,0,0,0" Text="{Binding SourceRevisionText}" Foreground="{StaticResource MutedBrush}" FontSize="8" />
                                                <TextBlock Margin="6,0,0,0" Text="{Binding LinkStateText}" Foreground="#75D9AA" FontSize="8" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="2" Margin="12" Padding="10" Background="#101820" BorderBrush="#284455" BorderThickness="1" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="只读导入" Foreground="#7EDDF0" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,0" Text="原图路径、SHA-256 与 Windows 文件标识会被记录；导出不会覆盖源文件。" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Button x:Name="LeftSidebarToggleButton"
                    Grid.Column="0"
                    Width="26"
                    Height="54"
                    Padding="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Panel.ZIndex="50"
                    Click="LeftSidebarToggleButton_OnClick"
                    Content="‹"
                    ToolTip="收起资源库，扩大中央画布" />

            <GridSplitter x:Name="LeftSidebarSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#263442" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True" ToolTip="拖动调整源图像栏宽度" />

            <Grid Grid.Column="2" Background="#090D12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Visibility="{Binding CropWorkspaceVisibility}" Background="#11171F" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="源图画布 · 像素坐标" Foreground="#B8C3CF" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Margin="16,0" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis"
                                   Text="{Binding ActiveScienceToolHint}" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Width="30" Height="28" Padding="0" Click="SourceZoomOut_OnClick" Content="−" ToolTip="缩小 · Ctrl+-" />
                            <TextBlock x:Name="SourceZoomText" Width="54" Text="适合" TextAlignment="Center" VerticalAlignment="Center" Foreground="#8CE5F4" FontSize="10" />
                            <Button Width="30" Height="28" Padding="0" Click="SourceZoomIn_OnClick" Content="＋" ToolTip="放大 · Ctrl++" />
                            <Button Margin="6,0,0,0" Padding="8,4" Click="SourceZoomFit_OnClick" Content="适合" ToolTip="适合窗口 · Ctrl+0" />
                            <Button Margin="4,0,0,0" Padding="8,4" Click="SourceZoomActual_OnClick" Content="1:1" ToolTip="100% · Ctrl+1" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="24" ClipToBounds="True" Visibility="{Binding CropWorkspaceVisibility}">
                    <Border Background="#0C1219" BorderBrush="#202B36" BorderThickness="1" />

                    <StackPanel Visibility="{Binding EmptyStateVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="84" Height="84" Background="#121D27" BorderBrush="#294250" BorderThickness="1" CornerRadius="42">
                            <TextBlock Text="＋" Foreground="#4BD4EF" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Margin="0,18,0,0" Text="导入科研图像开始裁剪" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Margin="0,8,0,0" Text="支持 TIFF、PNG、JPEG、BMP · 全程本地处理" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                        <Button Margin="0,20,0,0" Command="{Binding OpenSourcesCommand}" Style="{StaticResource AccentButtonStyle}" Content="选择图像" HorizontalAlignment="Center" />
                    </StackPanel>

                    <ScrollViewer x:Name="ImageViewport"
                                  Margin="12"
                                  Visibility="{Binding SourceCanvasVisibility}"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  CanContentScroll="False"
                                  PreviewMouseWheel="ImageViewport_OnPreviewMouseWheel"
                                  PreviewMouseDown="Viewport_OnPreviewMouseDown"
                                  PreviewMouseMove="Viewport_OnPreviewMouseMove"
                                  PreviewMouseUp="Viewport_OnPreviewMouseUp"
                                  SizeChanged="ImageViewport_OnSizeChanged">
                        <Canvas x:Name="ImageCanvas"
                                Width="{Binding SelectedSource.Width, FallbackValue=1}"
                                Height="{Binding SelectedSource.Height, FallbackValue=1}"
                                Background="Transparent"
                                ClipToBounds="True"
                                Cursor="Cross"
                                MouseLeftButtonDown="ImageCanvas_OnMouseLeftButtonDown"
                                MouseMove="ImageCanvas_OnMouseMove"
                                MouseLeftButtonUp="ImageCanvas_OnMouseLeftButtonUp"
                                LostMouseCapture="ImageCanvas_OnLostMouseCapture"
                                SizeChanged="ImageCanvas_OnSizeChanged">
                            <Canvas.LayoutTransform>
                                <ScaleTransform x:Name="ImageZoomTransform" ScaleX="1" ScaleY="1" />
                            </Canvas.LayoutTransform>
                            <Image Width="{Binding SelectedSource.Width}"
                                   Height="{Binding SelectedSource.Height}"
                                   Source="{Binding SelectedSource.Preview}"
                                   Stretch="Fill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <Grid x:Name="CropOverlay"
                                  Canvas.Left="{Binding Crop.X}"
                                  Canvas.Top="{Binding Crop.Y}"
                                  Panel.ZIndex="2"
                                  Width="{Binding Crop.Width}"
                                  Height="{Binding Crop.Height}"
                                  Cursor="SizeAll"
                                  Visibility="{Binding CropOverlayVisibility}">
                                <Rectangle Fill="#2400D7FF"
                                           Stroke="#17D9F4"
                                           StrokeThickness="5" />
                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7" Padding="7,3" Background="#D011171F" BorderBrush="#17D9F4" BorderThickness="1" CornerRadius="3" IsHitTestVisible="False">
                                    <TextBlock Text="{Binding Crop.SizeText}" Foreground="#8CE5F4" FontSize="18" FontWeight="SemiBold" />
                                </Border>
                                <Thumb x:Name="CropTopLeftHandle" Uid="TopLeft" Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-13" Background="#FFF5FBFF" BorderBrush="#FF087E98" BorderThickness="5" Cursor="SizeNWSE" PreviewMouseLeftButtonDown="CropResizeHandle_OnMouseLeftButtonDown" PreviewMouseLeftButtonUp="CropResizeHandle_OnMouseLeftButtonUp" LostMouseCapture="CropResizeHandle_OnLostMouseCapture" />
                                <Thumb x:Name="CropTopHandle" Uid="Top" Width="30" Height="18" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-9,0,0" Background="#FFF5FBFF" BorderBrush="#FF087E98" BorderThickness="5" Cursor="SizeNS" PreviewMouseLeftButtonDown="CropResizeHandle_OnMouseLeftButtonDown" PreviewMouseLeftButtonUp="CropResizeHandle_OnMouseLeftButtonUp" LostMouseCapture="CropResizeHandle_OnLostMouseCapture" />
                                <Thumb x:Name="CropTopRightHandle" Uid="TopRight" Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="-13" Background="#FFF5FBFF" BorderBrush="#FF087E98" BorderThickness="5" Cursor="SizeNESW" PreviewMouseLeftButtonDown="CropResizeHandle_OnMouseLeftButtonDown" PreviewMouseLeftButtonUp="CropResizeHandle_OnMouseLeftButtonUp" LostMouseCapture="CropResizeHandle_OnLostMouseCapture" />
                                <Thumb x:Name="CropRightHandle" Uid="Right" Width="18" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-9,0" Background="#FFF5FBFF" BorderBrush="#FF087E98" BorderThickness="5" Cursor="SizeWE" PreviewMouseLeftButtonDown="CropResizeHandle_OnMouseLeftButtonDown" PreviewMouseLeftButtonUp="CropResizeHandle_OnMouseLeftButtonUp" LostMouseCapture="CropResizeHandle_OnLostMouseCapture" />
                                <Thumb x:Name="CropBottomRightHandle" Uid="BottomRight" Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="-13" Background="#FFF5FBFF" BorderBrush="#FF087E98" BorderThickness="5" Cursor="SizeNWSE" PreviewMouseLeftButtonDown="CropResizeHandle_OnMouseLeftButtonDown" PreviewMouseLeftButtonUp="CropResizeHandle_OnMouseLeftButtonUp" LostMouseCapture="CropResizeHandle_OnLostMouseCapture" />
                                <Thumb x:Name="CropBottomHandle" Uid="Bottom" Width="30" Height="18" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-9" Background="#FFF5FBFF" BorderBrush="#FF087E98" BorderThickness="5" Cursor="SizeNS" PreviewMouseLeftButtonDown="CropResizeHandle_OnMouseLeftButtonDown" PreviewMouseLeftButtonUp="CropResizeHandle_OnMouseLeftButtonUp" LostMouseCapture="CropResizeHandle_OnLostMouseCapture" />
                                <Thumb x:Name="CropBottomLeftHandle" Uid="BottomLeft" Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-13" Background="#FFF5FBFF" BorderBrush="#FF087E98" BorderThickness="5" Cursor="SizeNESW" PreviewMouseLeftButtonDown="CropResizeHandle_OnMouseLeftButtonDown" PreviewMouseLeftButtonUp="CropResizeHandle_OnMouseLeftButtonUp" LostMouseCapture="CropResizeHandle_OnLostMouseCapture" />
                                <Thumb x:Name="CropLeftHandle" Uid="Left" Width="18" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-9,0,0,0" Background="#FFF5FBFF" BorderBrush="#FF087E98" BorderThickness="5" Cursor="SizeWE" PreviewMouseLeftButtonDown="CropResizeHandle_OnMouseLeftButtonDown" PreviewMouseLeftButtonUp="CropResizeHandle_OnMouseLeftButtonUp" LostMouseCapture="CropResizeHandle_OnLostMouseCapture" />
                            </Grid>
                            <Line X1="{Binding SelectedSource.Calibration.ReferenceStartX}"
                                  Y1="{Binding SelectedSource.Calibration.ReferenceStartY}"
                                  X2="{Binding SelectedSource.Calibration.ReferenceEndX}"
                                  Y2="{Binding SelectedSource.Calibration.ReferenceEndY}"
                                  Stroke="#FF22C7E8"
                                  StrokeThickness="5"
                                  Panel.ZIndex="10"
                                  IsHitTestVisible="False"
                                  Visibility="{Binding SelectedSource.Calibration.ReferenceLineVisibility}" />
                            <Border Canvas.Left="{Binding SelectedSource.Calibration.ReferenceLabelX}"
                                    Canvas.Top="{Binding SelectedSource.Calibration.ReferenceLabelY}"
                                    Panel.ZIndex="11"
                                    Padding="10,5"
                                    Background="#D011171F"
                                    BorderBrush="#FF22C7E8"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding SelectedSource.Calibration.ReferenceLineVisibility}">
                                <TextBlock Text="{Binding SelectedSource.Calibration.ReferenceLabel}"
                                           Foreground="#FF4BD4EF"
                                           FontSize="22"
                                           FontWeight="SemiBold" />
                            </Border>
                            <ItemsControl Width="{Binding SelectedSource.Width}"
                                          Height="{Binding SelectedSource.Height}"
                                          ItemsSource="{Binding SelectedSource.Measurements}"
                                          Panel.ZIndex="20">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="0" />
                                        <Setter Property="Canvas.Top" Value="0" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Canvas Width="{Binding DataContext.SelectedSource.Width, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Height="{Binding DataContext.SelectedSource.Height, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Tag="{Binding}"
                                                Cursor="Hand"
                                                MouseLeftButtonDown="Measurement_OnMouseLeftButtonDown"
                                                PreviewMouseMove="Measurement_OnMouseMove"
                                                PreviewMouseLeftButtonUp="Measurement_OnMouseLeftButtonUp"
                                                LostMouseCapture="Measurement_OnLostMouseCapture">
                                            <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                                                  Stroke="Transparent" StrokeThickness="24"
                                                  Visibility="{Binding LengthVisibility}" />
                                            <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                                                  Stroke="{Binding OverlayStroke}" StrokeThickness="{Binding OverlayThickness}"
                                                  StrokeDashArray="{Binding StrokeDashArray}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  IsHitTestVisible="False"
                                                  Visibility="{Binding LengthVisibility}" />
                                            <Polyline Points="{Binding PolylinePoints}"
                                                      Stroke="Transparent"
                                                      StrokeThickness="24"
                                                      StrokeLineJoin="Round"
                                                      Visibility="{Binding PolylineVisibility}" />
                                            <Polyline Points="{Binding PolylinePoints}"
                                                      Stroke="{Binding OverlayStroke}"
                                                      StrokeThickness="{Binding OverlayThickness}"
                                                      StrokeDashArray="{Binding StrokeDashArray}"
                                                      StrokeLineJoin="Round"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      IsHitTestVisible="False"
                                                      Visibility="{Binding PolylineVisibility}" />
                                            <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                                                  Stroke="Transparent" StrokeThickness="24"
                                                  Visibility="{Binding AngleVisibility}" />
                                            <Line X1="{Binding X2}" Y1="{Binding Y2}" X2="{Binding X3}" Y2="{Binding Y3}"
                                                  Stroke="Transparent" StrokeThickness="24"
                                                  Visibility="{Binding AngleVisibility}" />
                                            <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                                                  Stroke="{Binding OverlayStroke}" StrokeThickness="{Binding OverlayThickness}"
                                                  StrokeDashArray="{Binding StrokeDashArray}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  IsHitTestVisible="False"
                                                  Visibility="{Binding AngleVisibility}" />
                                            <Line X1="{Binding X2}" Y1="{Binding Y2}" X2="{Binding X3}" Y2="{Binding Y3}"
                                                  Stroke="{Binding OverlayStroke}" StrokeThickness="{Binding OverlayThickness}"
                                                  StrokeDashArray="{Binding StrokeDashArray}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  IsHitTestVisible="False"
                                                  Visibility="{Binding AngleVisibility}" />
                                            <Rectangle Canvas.Left="{Binding RectangleX}"
                                                       Canvas.Top="{Binding RectangleY}"
                                                       Width="{Binding RectangleWidth}"
                                                       Height="{Binding RectangleHeight}"
                                                       Stroke="{Binding OverlayStroke}"
                                                       StrokeThickness="{Binding OverlayThickness}"
                                                       StrokeDashArray="{Binding StrokeDashArray}"
                                                       Fill="{Binding OverlayFill}"
                                                       Visibility="{Binding RectangleVisibility}" />
                                            <Ellipse Canvas.Left="{Binding RectangleX}"
                                                     Canvas.Top="{Binding RectangleY}"
                                                     Width="{Binding RectangleWidth}"
                                                     Height="{Binding RectangleHeight}"
                                                     Stroke="{Binding OverlayStroke}"
                                                     StrokeThickness="{Binding OverlayThickness}"
                                                     StrokeDashArray="{Binding StrokeDashArray}"
                                                     Fill="{Binding OverlayFill}"
                                                     Visibility="{Binding CircleVisibility}" />
                                            <Ellipse Canvas.Left="{Binding PointAMarkerX}" Canvas.Top="{Binding PointAMarkerY}"
                                                     Width="{Binding MarkerSizePixels}" Height="{Binding MarkerSizePixels}" Fill="{Binding MarkerFillBrush}"
                                                     Stroke="{Binding MarkerStrokeBrush}" StrokeThickness="3" IsHitTestVisible="False"
                                                     Visibility="{Binding MarkerVisibility}" />
                                            <Ellipse Canvas.Left="{Binding PointBMarkerX}" Canvas.Top="{Binding PointBMarkerY}"
                                                     Width="{Binding MarkerSizePixels}" Height="{Binding MarkerSizePixels}" Fill="{Binding MarkerFillBrush}"
                                                     Stroke="{Binding MarkerStrokeBrush}" StrokeThickness="3" IsHitTestVisible="False"
                                                     Visibility="{Binding MarkerVisibility}" />
                                            <Ellipse Canvas.Left="{Binding PointCMarkerX}" Canvas.Top="{Binding PointCMarkerY}"
                                                     Width="{Binding MarkerSizePixels}" Height="{Binding MarkerSizePixels}" Fill="{Binding MarkerFillBrush}"
                                                     Stroke="{Binding MarkerStrokeBrush}" StrokeThickness="3" IsHitTestVisible="False"
                                                     Visibility="{Binding PointCMarkerVisibility}" />
                                            <Border Canvas.Left="{Binding LabelX}"
                                                    Canvas.Top="{Binding LabelY}"
                                                    Padding="9,4"
                                                    Background="#D011171F"
                                                    BorderBrush="{Binding LabelBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    IsHitTestVisible="False"
                                                    Visibility="{Binding LabelVisibility}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Number, StringFormat={}{0} · }"
                                                               Foreground="{Binding LabelBrush}"
                                                               FontFamily="{Binding LabelFontFamily}"
                                                               FontSize="{Binding LabelFontSizePixels}" />
                                                    <TextBlock Text="{Binding ValueText}"
                                                               Foreground="{Binding LabelBrush}"
                                                               FontFamily="{Binding LabelFontFamily}"
                                                               FontSize="{Binding LabelFontSizePixels}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontWeight" Value="Normal" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding LabelIsBold}" Value="True">
                                                                        <Setter Property="FontWeight" Value="Bold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                            <Thumb x:Name="MeasurementPointAHandle"
                                                   Canvas.Left="{Binding PointAHandleX}"
                                                   Canvas.Top="{Binding PointAHandleY}"
                                                   Width="{Binding SelectionHandleSizePixels}"
                                                   Height="{Binding SelectionHandleSizePixels}"
                                                   Background="#FFF5FBFF"
                                                   BorderBrush="#FFFFB300"
                                                   BorderThickness="6"
                                                   Cursor="SizeAll"
                                                   Tag="{Binding}"
                                                   Visibility="{Binding SelectionHandleVisibility}"
                                                   PreviewMouseLeftButtonDown="MeasurementResizeHandle_OnMouseLeftButtonDown" />
                                            <Thumb x:Name="MeasurementPointBHandle"
                                                   Canvas.Left="{Binding PointBHandleX}"
                                                   Canvas.Top="{Binding PointBHandleY}"
                                                   Width="{Binding SelectionHandleSizePixels}"
                                                   Height="{Binding SelectionHandleSizePixels}"
                                                   Background="#FFF5FBFF"
                                                   BorderBrush="#FFFFB300"
                                                   BorderThickness="6"
                                                   Cursor="SizeAll"
                                                   Tag="{Binding}"
                                                   Visibility="{Binding SelectionHandleVisibility}"
                                                   PreviewMouseLeftButtonDown="MeasurementResizeHandle_OnMouseLeftButtonDown" />
                                            <Thumb x:Name="MeasurementPointCHandle"
                                                   Canvas.Left="{Binding PointCHandleX}"
                                                   Canvas.Top="{Binding PointCHandleY}"
                                                   Width="{Binding SelectionHandleSizePixels}"
                                                   Height="{Binding SelectionHandleSizePixels}"
                                                   Background="#FFF5FBFF"
                                                   BorderBrush="#FFFFB300"
                                                   BorderThickness="6"
                                                   Cursor="SizeAll"
                                                   Tag="{Binding}"
                                                   Visibility="{Binding PointCHandleVisibility}"
                                                   PreviewMouseLeftButtonDown="MeasurementResizeHandle_OnMouseLeftButtonDown" />
                                        </Canvas>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl Width="{Binding SelectedSource.Width}"
                                          Height="{Binding SelectedSource.Height}"
                                          ItemsSource="{Binding SourceRois}"
                                          Panel.ZIndex="19"
                                          IsHitTestVisible="{Binding IsCanonicalRoiToolActive}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="0" />
                                        <Setter Property="Canvas.Top" Value="0" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Canvas Width="{Binding DataContext.SelectedSource.Width, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Height="{Binding DataContext.SelectedSource.Height, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Tag="{Binding}"
                                                Cursor="SizeAll"
                                                MouseLeftButtonDown="CanonicalRoi_OnMouseLeftButtonDown"
                                                PreviewMouseMove="CanonicalRoi_OnMouseMove"
                                                PreviewMouseLeftButtonUp="CanonicalRoi_OnMouseLeftButtonUp"
                                                LostMouseCapture="CanonicalRoi_OnLostMouseCapture">
                                            <Rectangle Canvas.Left="{Binding ShapeX}" Canvas.Top="{Binding ShapeY}"
                                                       Width="{Binding ShapeWidth}" Height="{Binding ShapeHeight}"
                                                       Stroke="{Binding StrokeBrush}" StrokeThickness="{Binding StrokeWidth}"
                                                       Fill="{Binding FillBrush}" Visibility="{Binding RectangleVisibility}" />
                                            <Ellipse Canvas.Left="{Binding ShapeX}" Canvas.Top="{Binding ShapeY}"
                                                     Width="{Binding ShapeWidth}" Height="{Binding ShapeHeight}"
                                                     Stroke="{Binding StrokeBrush}" StrokeThickness="{Binding StrokeWidth}"
                                                     Fill="{Binding FillBrush}" Visibility="{Binding EllipseVisibility}" />
                                            <Polygon Points="{Binding Points}" Stroke="{Binding StrokeBrush}"
                                                     StrokeThickness="{Binding StrokeWidth}" Fill="{Binding FillBrush}"
                                                     StrokeLineJoin="Round" Visibility="{Binding PolygonVisibility}" />
                                            <Polyline Points="{Binding Points}" Stroke="Transparent"
                                                      StrokeThickness="18" StrokeLineJoin="Round"
                                                      Visibility="{Binding PolylineVisibility}" />
                                            <Polyline Points="{Binding Points}" Stroke="{Binding StrokeBrush}"
                                                      StrokeThickness="{Binding StrokeWidth}" StrokeLineJoin="Round"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      IsHitTestVisible="False" Visibility="{Binding PolylineVisibility}" />
                                            <Border Canvas.Left="{Binding ShapeX}" Canvas.Top="{Binding ShapeY}"
                                                    Margin="5,-24,0,0" Padding="5,2"
                                                    Background="#D011171F" BorderBrush="{Binding StrokeBrush}"
                                                    BorderThickness="1" CornerRadius="3"
                                                    IsHitTestVisible="False">
                                                <TextBlock Text="{Binding Label}" Foreground="{Binding StrokeBrush}" FontSize="11" />
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding VertexHandles}"
                                                          Visibility="{Binding SelectionVisibility}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Thumb Width="10" Height="10"
                                                               Background="#FFF5FBFF" BorderBrush="#FFFFB300"
                                                               BorderThickness="2" Cursor="SizeAll"
                                                               Tag="{Binding}"
                                                               PreviewMouseLeftButtonDown="CanonicalRoiVertexHandle_OnMouseLeftButtonDown"
                                                               PreviewMouseMove="CanonicalRoiVertexHandle_OnMouseMove"
                                                               PreviewMouseLeftButtonUp="CanonicalRoiVertexHandle_OnMouseLeftButtonUp"
                                                               LostMouseCapture="CanonicalRoiVertexHandle_OnLostMouseCapture" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Canvas>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Canvas Width="{Binding SelectedSource.Width}"
                                    Height="{Binding SelectedSource.Height}"
                                    Panel.ZIndex="25"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding CanonicalRoiDraftVisibility}">
                                <Rectangle Canvas.Left="{Binding CanonicalRoiDraftX}"
                                           Canvas.Top="{Binding CanonicalRoiDraftY}"
                                           Width="{Binding CanonicalRoiDraftWidth}"
                                           Height="{Binding CanonicalRoiDraftHeight}"
                                           Stroke="#FFFFB300" StrokeThickness="2"
                                           StrokeDashArray="5,3" Fill="#20FFB300"
                                           Visibility="{Binding CanonicalRoiDraftRectangleVisibility}" />
                                <Ellipse Canvas.Left="{Binding CanonicalRoiDraftX}"
                                         Canvas.Top="{Binding CanonicalRoiDraftY}"
                                         Width="{Binding CanonicalRoiDraftWidth}"
                                         Height="{Binding CanonicalRoiDraftHeight}"
                                         Stroke="#FFFFB300" StrokeThickness="2"
                                         StrokeDashArray="5,3" Fill="#20FFB300"
                                         Visibility="{Binding CanonicalRoiDraftEllipseVisibility}" />
                                <Polyline Points="{Binding CanonicalRoiDraftPoints}"
                                          Stroke="#FFFFB300" StrokeThickness="2"
                                          StrokeDashArray="5,3" StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Visibility="{Binding CanonicalRoiDraftPathVisibility}" />
                            </Canvas>
                            <ItemsControl Width="{Binding SelectedSource.Width}"
                                          Height="{Binding SelectedSource.Height}"
                                          ItemsSource="{Binding AssistedRegions}"
                                          Panel.ZIndex="18"
                                          IsHitTestVisible="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Rectangle Width="{Binding Width}"
                                                       Height="{Binding Height}"
                                                       Stroke="{Binding OverlayStroke}"
                                                       StrokeThickness="3"
                                                       Fill="{Binding OverlayFill}" />
                                            <Border Margin="2"
                                                    Padding="3,1"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Background="#CC11171F"
                                                    BorderBrush="{Binding OverlayStroke}"
                                                    BorderThickness="1">
                                                <TextBlock Text="{Binding Id}"
                                                           Foreground="{Binding OverlayStroke}"
                                                           FontSize="12"
                                                           FontWeight="Bold" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Row="0" Visibility="{Binding FigureWorkspaceVisibility}" Background="#11171F" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
