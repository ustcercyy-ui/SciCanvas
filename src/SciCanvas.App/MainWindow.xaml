                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="文字颜色" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
