                                          ItemsSource="{Binding SelectedExportProfile.PdfFontStrategyChoices}"
                                          SelectedItem="{Binding SelectedExportProfile.PdfFontStrategy, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="{Binding SelectedExportProfile.PdfFontStrategyDescription}"
                                           Foreground="#D9B991" FontSize="8" TextWrapping="Wrap" />
                                <CheckBox Margin="0,8,0,0" IsChecked="{Binding SelectedExportProfile.WriteProvenance}" Content="生成溯源 JSON 与 HTML 报告" />
                                <TextBlock Margin="0,6,0,0" Text="{Binding SelectedExportProfile.ValidationMessage}" Foreground="#80DDEA" FontSize="8" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,18,0,8" Style="{StaticResource SectionTitleStyle}" Text="智能辅助 · 可解释 / 可撤销" />
                        <Border Padding="10" Background="#171A21" BorderBrush="#66543A" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="使用确定性规则辅助布局、样式和科研诚信审查；不执行生成式填充、克隆、局部擦除或对象移除。"
                                           Foreground="#E8C989" FontSize="9" TextWrapping="Wrap" />
                                <Button Margin="0,9,0,0"
                                        Command="{Binding ApplySmartLayoutCommand}"
                                        Content="推荐并应用布局" />
                                <Button Margin="0,6,0,0"
                                        Command="{Binding HarmonizeFigureStyleCommand}"
                                        Content="协调全局样式" />
                                <Button Margin="0,6,0,0"
                                        Command="{Binding RunAssistedFigureReviewCommand}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Content="运行样式 + 科研诚信辅助审查" />
                                <TextBlock Margin="0,7,0,0"
                                           Text="{Binding SmartAssistStatusText}"
                                           Foreground="#D9C29A"
                                           FontSize="8"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,18,0,8" Style="{StaticResource SectionTitleStyle}" Text="Figure QC · 投稿前检查" />
                        <Border Padding="10" Background="#121E27" BorderBrush="#315365" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding FigureQcStatusText}" Foreground="#DCE7F0" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,3,0,0" Text="{Binding FigureQcCountText}" Foreground="{StaticResource MutedBrush}" FontSize="8" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Margin="8,0,0,0" Padding="9,5" Command="{Binding RunFigureQcCommand}" Content="重新检查" />
                                </Grid>
                                <Border Margin="0,8,0,0" Padding="8" Background="#0D151C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                                    <TextBlock Text="{Binding SubmissionPreflightSummary}"
                                               Foreground="#DCE7F0"
                                               FontFamily="Consolas"
                                               FontSize="9"
                                               TextWrapping="Wrap" />
                                </Border>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="92" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="项目最小有效分辨率 / dpi"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="9"
                                               VerticalAlignment="Center" />
                                    <TextBox Grid.Column="2"
                                             Text="{Binding FigureQcMinimumDpi, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Figure QC 最小有效 DPI" />
                                </Grid>
                                <ListBox Margin="0,9,0,0"
                                         MinHeight="54"
                                         MaxHeight="230"
                                         Background="#0D151C"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         BorderThickness="1"
                                         ItemsSource="{Binding FigureQcIssues}"
                                         SelectedItem="{Binding SelectedFigureQcIssue}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="5,4" Padding="7" BorderBrush="{Binding SeverityBrush}" BorderThickness="3,0,0,0">
                                                <StackPanel>
                                                    <Grid>
                                                        <TextBlock Text="{Binding SeverityText}" Foreground="{Binding SeverityBrush}" FontSize="8" FontWeight="Bold" />
                                                        <TextBlock HorizontalAlignment="Right" Text="{Binding TargetText}" Foreground="{StaticResource MutedBrush}" FontSize="8" />
                                                    </Grid>
                                                    <TextBlock Margin="0,3,0,0" Text="{Binding Message}" FontSize="9" TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,3,0,0" Text="{Binding SuggestedAction}" Foreground="{StaticResource MutedBrush}" FontSize="8" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Margin="0,8,0,0" Command="{Binding NavigateToSelectedQcIssueCommand}" Content="定位选中问题" />
                            </StackPanel>
                        </Border>

                        <Button Margin="0,18,0,0" Command="{Binding AddCurrentCropToFigureCommand}" Content="加入当前裁剪" />
                        <Button Margin="0,8,0,0" Command="{Binding ExportFigureCommand}" Style="{StaticResource AccentButtonStyle}" Content="导出整张拼版" />
                        <Button Margin="0,8,0,0" Command="{Binding ExportFigureVariantsCommand}" Content="批量导出投稿版本（主图/补充图/缩略图）" />
                        <Button Margin="0,8,0,0" Command="{Binding BuildSubmissionPackageCommand}" Content="生成投稿包（Figure / Data / Audit）" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="最终组图从原始文件重新裁剪并渲染；投稿包会先运行源文件验证与 QC，并生成 TIFF、可编辑 SVG、数据表、source manifest、溯源与审计报告。目标文件夹必须为空，源图不会被复制。"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="9"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    </Grid>
                    </ScrollViewer>
                    <ScrollViewer x:Name="LayersScrollViewer" Grid.Row="1" Visibility="{Binding LayersTabVisibility}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                        <StackPanel Margin="16,16,16,24">
                            <TextBlock Text="图层" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,0" Text="当前工作区的图像、测量、标注与参考线统一在这里选择、显隐、锁定和删除。" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" />
                            <Button Margin="0,10,0,0" Command="{Binding DeleteSelectionCommand}" Content="删除选中项 · Delete" />
                            <Border Margin="0,14,0,0" Padding="9" Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Visibility="{Binding CropWorkspaceVisibility}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="测量图层" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedSource.MeasurementCountText}" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                    </Grid>
                                    <ListBox Margin="0,9,0,0"
                                             MinHeight="150"
                                             MaxHeight="420"
                                             Background="{StaticResource PanelBrush}"
                                             BorderBrush="{StaticResource BorderBrush}"
                                             BorderThickness="1"
                                             ItemsSource="{Binding SelectedSource.Measurements}"
                                             SelectedItem="{Binding SelectedSource.SelectedMeasurement}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="7,7">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsVisible}" ToolTip="显示/隐藏测量图层" />
                                                    <StackPanel Grid.Column="1" Margin="8,0">
                                                        <TextBlock Text="{Binding LayerStateText}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding ValueText}" Foreground="{StaticResource MutedBrush}" FontSize="9" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="2" IsChecked="{Binding IsLocked}" Content="锁" FontSize="9" ToolTip="锁定测量图层" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Margin="0,7,0,0" Text="单击画布图形或列表均可选择；锁定后仍可查看，但不能移动、缩放或删除。" Foreground="{StaticResource MutedBrush}" FontSize="8" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,14,0,0" Padding="9" Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Visibility="{Binding FigureWorkspaceVisibility}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="拼版面板" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding Figure.PanelCountText}" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                    </Grid>
                                    <ListBox Margin="0,9,0,0" MinHeight="140" MaxHeight="360" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ItemsSource="{Binding Figure.Panels}" SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="7,7">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsVisible}" ToolTip="显示/隐藏图层" />
                                                    <StackPanel Grid.Column="1" Margin="8,0">
                                                        <TextBlock FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"><Run Text="{Binding Label, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding RoleDisplayName, Mode=OneWay}" /></TextBlock>
                                                        <TextBlock Text="{Binding Source.DisplayName}" Foreground="{StaticResource MutedBrush}" FontSize="9" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="2" IsChecked="{Binding IsLocked}" Content="锁" FontSize="9" ToolTip="锁定图层" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <UniformGrid Margin="0,8,0,0" Columns="3">
                                        <Button Margin="0,0,5,0" Padding="7" Command="{Binding Figure.MoveLayerUpCommand}" Content="上移" />
                                        <Button Margin="0,0,5,0" Padding="7" Command="{Binding Figure.MoveLayerDownCommand}" Content="下移" />
                                        <Button Padding="7" Command="{Binding Figure.RemoveSelectedCommand}" Content="移除" />
                                    </UniformGrid>
                                    <UniformGrid Margin="0,6,0,0" Columns="2">
                                        <Button Margin="0,0,5,0" Padding="6" Command="{Binding Figure.SelectAllPanelsCommand}" Content="全选面板" />
                                        <Button Padding="6" Command="{Binding Figure.ClearPanelSelectionCommand}" Content="取消选择" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                            <Border Margin="0,12,0,0" Padding="9" Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Visibility="{Binding FigureWorkspaceVisibility}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="标注图层" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding Figure.AnnotationCountText}" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                    </Grid>
                                    <ListBox Margin="0,9,0,0"
                                             MinHeight="110"
                                             MaxHeight="300"
                                             Background="{StaticResource PanelBrush}"
                                             BorderBrush="{StaticResource BorderBrush}"
                                             BorderThickness="1"
                                             ItemsSource="{Binding Figure.Annotations}"
                                             SelectedItem="{Binding Figure.SelectedAnnotation}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="7,7">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsVisible}" ToolTip="显示/隐藏标注图层" />
                                                    <StackPanel Grid.Column="1" Margin="8,0">
                                                        <TextBlock Text="{Binding KindDisplayName}" FontSize="11" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Text}" Foreground="{StaticResource MutedBrush}" FontSize="9" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="2" IsChecked="{Binding IsLocked}" Content="锁" FontSize="9" ToolTip="锁定标注图层" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <UniformGrid Margin="0,8,0,0" Columns="3">
                                        <Button Margin="0,0,5,0" Padding="7" Command="{Binding Figure.MoveAnnotationUpCommand}" Content="上移" />
                                        <Button Margin="0,0,5,0" Padding="7" Command="{Binding Figure.MoveAnnotationDownCommand}" Content="下移" />
                                        <Button Padding="7" Command="{Binding Figure.RemoveSelectedAnnotationCommand}" Content="删除" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                            <Border Margin="0,12,0,0" Padding="9" Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Visibility="{Binding FigureWorkspaceVisibility}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="参考线图层" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding Figure.GuideCountText}" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                    </Grid>
                                    <ListBox Margin="0,9,0,0"
                                             MinHeight="80"
                                             MaxHeight="220"
                                             Background="{StaticResource PanelBrush}"
                                             BorderBrush="{StaticResource BorderBrush}"
                                             BorderThickness="1"
                                             ItemsSource="{Binding Figure.Guides}"
                                             SelectedItem="{Binding Figure.SelectedGuide}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="7,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                     <TextBlock Text="{Binding Summary}" />
                                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsLocked}" Content="锁" FontSize="9" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Button Margin="0,8,0,0" Command="{Binding Figure.RemoveSelectedGuideCommand}" Content="删除选中参考线" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,12,0,0" Padding="9" Background="#10212A" BorderBrush="#245A68" BorderThickness="1" CornerRadius="3">
                                <StackPanel>
                                    <TextBlock Text="图层说明" Foreground="#8CE5F4" FontSize="10" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,4,0,0" Text="一次只激活一种图层类型；Delete 删除当前选中对象。眼睛控制显示，锁定会阻止拖动、改大小和删除。" Foreground="{StaticResource MutedBrush}" FontSize="9" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <app:ChannelsInspector x:Name="ChannelsInspectorPanel"
                                           Grid.Row="1"
                                           DataContext="{Binding MultiChannelWorkspace}"
                                           Visibility="{Binding DataContext.ChannelsTabVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                    <app:LinkedViewsInspector x:Name="LinkedViewsInspectorPanel"
                                              Grid.Row="1"
                                              DataContext="{Binding LinkedViewsWorkspace}"
Visibility="{Binding DataContext.LinkedViewsTabVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                    <app:RegistrationWorkspace x:Name="RegistrationWorkspacePanel"
                                               Grid.Row="1"
                                               DataContext="{Binding RegistrationWorkspace}"
Visibility="{Binding DataContext.RegistrationTabVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                    <app:RoiPropagationWorkspace x:Name="RoiPropagationWorkspacePanel"
                                                 Grid.Row="1"
                                                 DataContext="{Binding RoiPropagationWorkspace}"
                                                 Visibility="{Binding DataContext.RoiPropagationTabVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                    <app:PublishingPortabilityWorkspace x:Name="PublishingPortabilityWorkspacePanel"
                                                        Grid.Row="1"
                                                        DataContext="{Binding PublishingPortabilityWorkspace}"
                                                        Visibility="{Binding DataContext.PublishingPortabilityTabVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                </Grid>
            </Border>

            <Button x:Name="RightSidebarToggleButton"
                    Grid.Column="4"
                    Width="26"
                    Height="54"
                    Padding="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Panel.ZIndex="50"
                    Click="RightSidebarToggleButton_OnClick"
                    Content="›"
                    ToolTip="收起检查器，扩大中央画布" />
        </Grid>

        <Border Grid.Row="3" Background="#10161E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="●" Foreground="#62D49C" FontSize="9" />
                    <TextBlock Margin="6,0,0,0" Text="{Binding StatusMessage}" Foreground="#AEB9C6" FontSize="10" />
                    <TextBlock Margin="14,0,0,0" Text="{Binding LastError}" Foreground="#F28A8A" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="560" ToolTip="{Binding LastError}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Margin="0,0,14,0" Text="{Binding AutosaveStatusText}" Foreground="#62D49C" FontSize="9" />
                    <TextBlock Text="{Binding HistoryStatusText}" Foreground="#7FA8B5" FontSize="9" />
                    <TextBlock Margin="14,0,0,0" Text="本地模式 · 无网络上传" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
