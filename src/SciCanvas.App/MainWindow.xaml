                                      Visibility="{Binding SelectedSource.SelectedMeasurement.FillStyleVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="填充颜色" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding SelectedSource.SelectedMeasurement.FillColor, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="2" Width="46" Padding="5,4"
                                                    Background="{Binding SelectedSource.SelectedMeasurement.OverlayFill}"
                                                    Click="MeasurementFillColorPicker_OnClick"
                                                    Content="取色" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="透明度 / %" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                        <TextBox Margin="0,4,0,0"
                                                 Text="{Binding SelectedSource.SelectedMeasurement.FillOpacityPercent, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
