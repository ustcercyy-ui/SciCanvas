                                    <StackPanel Grid.Column="2"><TextBlock Text="填充 / 透明度 %" Foreground="{StaticResource MutedBrush}" FontSize="9" /><Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBox Text="{Binding Figure.SelectedScientificObject.FillColor, UpdateSourceTrigger=PropertyChanged}" /><TextBox Grid.Column="2" Text="{Binding Figure.SelectedScientificObject.FillOpacityPercent, UpdateSourceTrigger=PropertyChanged}" /></Grid></StackPanel>
                                </Grid>
