<UserControl x:Class="SciCanvas.App.PlotWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SciCanvas.App"
             Focusable="False">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <DataTemplate x:Key="AxisEditorTemplate">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock Text="标题" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                        <TextBox Margin="0,3,0,0" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                        <TextBlock Text="单位" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                        <TextBox Margin="0,3,0,0" Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,3,0">
                        <TextBlock Text="Scale" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                        <ComboBox Margin="0,3,0,0"
                                  ItemsSource="{Binding DataContext.AxisScaleChoices, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                  SelectedItem="{Binding Scale}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="3,0">
                        <TextBlock Text="Min（可空）" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                        <TextBox Margin="0,3,0,0" Text="{Binding Minimum, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="3,0,0,0">
                        <TextBlock Text="Max（可空）" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                        <TextBox Margin="0,3,0,0" Text="{Binding Maximum, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock Text="Major tick（可空）" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                        <TextBox Margin="0,3,0,0" Text="{Binding MajorTickInterval, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                        <TextBlock Text="Minor ticks" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                        <TextBox Margin="0,3,0,0" Text="{Binding MinorTickCount, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="TextStyleEditorTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <TextBox Margin="0,0,3,0"
                         Text="{Binding FontFamily, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="FontFamily" />
                <TextBox Grid.Column="1"
                         Margin="3,0"
                         Text="{Binding FontSizePt, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="FontSize (pt)" />
                <TextBox Grid.Column="2"
                         Margin="3,0"
                         Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Color · #RRGGBB / #AARRGGBB" />
                <CheckBox Grid.Column="3"
                          Margin="5,0,0,0"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          IsChecked="{Binding IsBold}"
                          Content="B"
                          FontWeight="Bold"
                          ToolTip="Bold" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer x:Name="PlotWorkspaceScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="14,14,14,24">
            <TextBlock Text="Plot Workspace" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,0"
                       Text="2D scientific plots · DataAsset/column bound · vector preview"
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="9"
                       TextWrapping="Wrap" />

            <TextBlock Margin="0,12,0,0" Text="DataAsset" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
            <ComboBox x:Name="PlotDataAssetComboBox"
                      Margin="0,3,0,0"
                      ItemsSource="{Binding DataAssets}"
                      SelectedItem="{Binding SelectedDataAsset}"
                      DisplayMemberPath="Name" />
            <TextBlock Margin="0,5,0,0"
                       Text="{Binding SelectedDataAssetSummary}"
                       Foreground="#80DDEA"
                       FontSize="8"
                       TextWrapping="Wrap" />

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="工程中的 Plot" FontSize="10" FontWeight="SemiBold" />
                <Button Grid.Column="1"
                        Margin="6,0,0,0"
                        Padding="8,4"
                        Command="{Binding NewPlotCommand}"
                        Content="新建" />
                <Button Grid.Column="2"
                        Margin="6,0,0,0"
                        Padding="8,4"
                        Command="{Binding RemoveSelectedPlotCommand}"
                        Content="移除" />
                <Button Grid.Column="3"
                        Margin="6,0,0,0"
                        Padding="8,4"
                        Command="{Binding AddSelectedPlotToFigureCommand}"
                        Content="添加到 Figure" />
            </Grid>
            <ListBox x:Name="ProjectPlotsList"
                     Margin="0,6,0,0"
                     MinHeight="70"
                     MaxHeight="150"
                     ItemsSource="{Binding Plots}"
                     SelectedItem="{Binding SelectedPlot}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="5,3">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="8">
                                <Run Text="{Binding PlotType}" />
                                <Run Text=" · revision " />
                                <Run Text="{Binding Data.SourceRevision}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Margin="0,12,0,0"
                    Padding="4"
                    Background="White"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="3">
                <app:PlotPreviewControl x:Name="PlotVectorPreview"
                                        Height="225"
                                        Plot="{Binding SelectedPlot}"
                                        DataAsset="{Binding SelectedDataAsset}"
                                        SnapsToDevicePixels="True" />
            </Border>

            <Border Margin="0,12,0,0"
                    Padding="9"
                    Background="#101820"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Plot definition" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock Margin="0,7,0,0" Text="名称" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                    <TextBox Margin="0,3,0,0" Text="{Binding PlotName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,7,0,0" Text="Plot type" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                    <ComboBox x:Name="PlotKindComboBox"
                              Margin="0,3,0,0"
                              ItemsSource="{Binding PlotKindChoices}"
                              SelectedItem="{Binding SelectedPlotKind}" />

                    <StackPanel Margin="0,7,0,0"
                                Visibility="{Binding UsesXColumn, Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock Text="X column" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                        <ComboBox Margin="0,3,0,0"
                                  ItemsSource="{Binding NumericColumns}"
                                  SelectedItem="{Binding SelectedXColumn}"
                                  DisplayMemberPath="Name" />
                    </StackPanel>
                    <StackPanel Margin="0,7,0,0"
                                Visibility="{Binding UsesCategoryColumn, Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock Text="Category column（可空）" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                        <ComboBox Margin="0,3,0,0"
                                  ItemsSource="{Binding AvailableColumns}"
                                  SelectedItem="{Binding SelectedXColumn}"
                                  DisplayMemberPath="Name" />
                    </StackPanel>
                    <TextBlock Margin="0,7,0,0" Text="Y / value column" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                    <ComboBox Margin="0,3,0,0"
                              ItemsSource="{Binding NumericColumns}"
                              SelectedItem="{Binding SelectedYColumn}"
                              DisplayMemberPath="Name" />

                    <StackPanel Margin="0,7,0,0"
                                Visibility="{Binding UsesValueColumn, Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock Text="Heatmap value column" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                        <ComboBox Margin="0,3,0,0"
                                  ItemsSource="{Binding NumericColumns}"
                                  SelectedItem="{Binding SelectedValueColumn}"
                                  DisplayMemberPath="Name" />
                    </StackPanel>

                    <StackPanel Margin="0,7,0,0"
                                Visibility="{Binding UsesErrorBars, Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock Text="Error bars" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                        <ComboBox Margin="0,3,0,0"
                                  ItemsSource="{Binding ErrorBarModeChoices}"
                                  SelectedItem="{Binding SelectedErrorBarMode}" />
                        <ComboBox Margin="0,5,0,0"
                                  ItemsSource="{Binding NumericColumns}"
                                  SelectedItem="{Binding SelectedSymmetricErrorColumn}"
                                  DisplayMemberPath="Name"
                                  Visibility="{Binding UsesSymmetricErrorColumn, Converter={StaticResource BooleanToVisibility}}"
                                  ToolTip="Symmetric error column" />
                        <Grid Margin="0,5,0,0"
                              Visibility="{Binding UsesAsymmetricErrorColumns, Converter={StaticResource BooleanToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Margin="0,0,3,0"
                                      ItemsSource="{Binding NumericColumns}"
                                      SelectedItem="{Binding SelectedLowerErrorColumn}"
                                      DisplayMemberPath="Name"
                                      ToolTip="Lower error column" />
                            <ComboBox Grid.Column="1"
                                      Margin="3,0,0,0"
                                      ItemsSource="{Binding NumericColumns}"
                                      SelectedItem="{Binding SelectedUpperErrorColumn}"
                                      DisplayMemberPath="Name"
                                      ToolTip="Upper error column" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Expander Margin="0,10,0,0"
                      Header="Quantitative Heatmap · grid / color scale / colorbar"
                      IsExpanded="True"
                      Visibility="{Binding UsesHeatmapSettings, Converter={StaticResource BooleanToVisibility}}">
                <Border Margin="0,5,0,0" Padding="8" Background="#151E27" CornerRadius="3">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,3,0">
                                <TextBlock Text="Grid semantics" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                                <ComboBox Margin="0,3,0,0"
                                          ItemsSource="{Binding Heatmap.GridKindChoices}"
                                          SelectedItem="{Binding Heatmap.GridKind}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="3,0,0,0">
                                <TextBlock Text="Duplicate cell policy" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                                <ComboBox Margin="0,3,0,0"
                                          ItemsSource="{Binding Heatmap.DuplicateCellPolicyChoices}"
                                          SelectedItem="{Binding Heatmap.DuplicateCellPolicy}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Margin="0,5,0,0"
                                   Text="Auto：完整网格按坐标间距绘制；不完整数据使用彩色点且不插值。重复坐标默认 Error。"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="8"
                                   TextWrapping="Wrap" />

                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,3,0">
                                <TextBlock Text="Colormap" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                                <ComboBox Margin="0,3,0,0"
                                          ItemsSource="{Binding Heatmap.ColormapChoices}"
                                          SelectedItem="{Binding Heatmap.Colormap}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="3,0">
                                <TextBlock Text="Value scale" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                                <ComboBox Margin="0,3,0,0"
                                          ItemsSource="{Binding Heatmap.ScaleChoices}"
                                          SelectedItem="{Binding Heatmap.Scale}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="3,0,0,0">
                                <TextBlock Text="Clamp mode" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                                <ComboBox Margin="0,3,0,0"
                                          ItemsSource="{Binding Heatmap.ClampModeChoices}"
                                          SelectedItem="{Binding Heatmap.ClampMode}" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,3,0">
                                <TextBlock Text="Scale min（可空）" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                                <TextBox Margin="0,3,0,0" Text="{Binding Heatmap.Minimum, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="3,0">
                                <TextBlock Text="Scale max（可空）" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                                <TextBox Margin="0,3,0,0" Text="{Binding Heatmap.Maximum, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="3,0,0,0">
                                <TextBlock Text="NoData color（空=透明）" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                                <TextBox Margin="0,3,0,0" Text="{Binding Heatmap.NoDataColor, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <CheckBox Margin="0,10,0,0"
                                  IsChecked="{Binding Heatmap.ShowColorbar}"
                                  Content="显示与 Heatmap 范围联动的 colorbar" />
                        <StackPanel Margin="0,7,0,0"
                                    Visibility="{Binding Heatmap.ShowColorbar, Converter={StaticResource BooleanToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,3,0">
                                    <TextBlock Text="Binding" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                                    <ComboBox Margin="0,3,0,0"
                                              ItemsSource="{Binding Heatmap.ColorbarBindingChoices}"
                                              SelectedItem="{Binding Heatmap.ColorbarBinding}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="3,0">
                                    <TextBlock Text="Orientation" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                                    <ComboBox Margin="0,3,0,0"
                                              ItemsSource="{Binding Heatmap.ColorbarOrientationChoices}"
                                              SelectedItem="{Binding Heatmap.ColorbarOrientation}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="3,0,0,0">
                                    <TextBlock Text="Position" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                                    <ComboBox Margin="0,3,0,0"
                                              ItemsSource="{Binding Heatmap.ColorbarPositionChoices}"
                                              SelectedItem="{Binding Heatmap.ColorbarPosition}" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,7,0,0"
                                  Visibility="{Binding Heatmap.IsDetachedColorbar, Converter={StaticResource BooleanToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,3,0">
                                    <TextBlock Text="Detached min" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                                    <TextBox Margin="0,3,0,0" Text="{Binding Heatmap.ColorbarMinimum, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="3,0,0,0">
                                    <TextBlock Text="Detached max" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                                    <TextBox Margin="0,3,0,0" Text="{Binding Heatmap.ColorbarMaximum, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,3,0">
                                    <TextBlock Text="Unit" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                                    <TextBox Margin="0,3,0,0" Text="{Binding Heatmap.ColorbarUnit, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="3,0,0,0">
                                    <TextBlock Text="Ticks（逗号分隔；空=自动）" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                                    <TextBox Margin="0,3,0,0" Text="{Binding Heatmap.ColorbarTicks, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Margin="0,7,0,0">
                                <TextBlock Text="Tick labels（| 分隔；空=按数值自动生成；数量须与 ticks 相同）"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="8" />
                                <TextBox Margin="0,3,0,0"
                                         Text="{Binding Heatmap.ColorbarTickLabels, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <CheckBox Margin="0,7,0,0"
                                      IsChecked="{Binding Heatmap.UseCustomColorbarFont}"
                                      Content="独立 colorbar label 字体（关闭时继承 Tick font）" />
                            <ContentControl Margin="0,5,0,0"
                                            Content="{Binding Heatmap.ColorbarFont}"
                                            ContentTemplate="{StaticResource TextStyleEditorTemplate}"
                                            Visibility="{Binding Heatmap.UseCustomColorbarFont, Converter={StaticResource BooleanToVisibility}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Expander>

            <Expander Margin="0,10,0,0"
                      Header="Filter · explicit expression / excluded rows"
                      IsExpanded="True">
                <Border Margin="0,5,0,0" Padding="8" Background="#151E27" CornerRadius="3">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding IsFilterEnabled}"
                                  Content="启用 filter（不修改原始 DataAsset）" />
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,3,0">
                                <TextBlock Text="Source column" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                                <ComboBox Margin="0,3,0,0"
                                          ItemsSource="{Binding AvailableColumns}"
                                          SelectedItem="{Binding SelectedFilterColumn}"
                                          DisplayMemberPath="Name" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="3,0,0,0">
                                <TextBlock Text="Operator" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                                <ComboBox Margin="0,3,0,0"
                                          ItemsSource="{Binding FilterOperatorChoices}"
                                          SelectedItem="{Binding SelectedFilterOperator}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Margin="0,7,0,0"
                                    Visibility="{Binding FilterNeedsOperand, Converter={StaticResource BooleanToVisibility}}">
                            <TextBlock Text="Operand · invariant value" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                            <TextBox Margin="0,3,0,0"
                                     Text="{Binding FilterOperand, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <Button Margin="0,7,0,0"
                                Command="{Binding PreviewFilterCommand}"
                                Content="预览 expression 与 excluded count" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{Binding FilterSummary}"
                                   Foreground="#80DDEA"
                                   FontSize="8"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Expander>

            <Expander Margin="0,7,0,0"
                      Header="Transforms · ordered / non-destructive / auditable"
                      IsExpanded="True">
                <Border Margin="0,5,0,0" Padding="8" Background="#151E27" CornerRadius="3">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,3,0">
                                <TextBlock Text="Bound numeric column" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                                <ComboBox Margin="0,3,0,0"
                                          ItemsSource="{Binding NumericColumns}"
                                          SelectedItem="{Binding NewTransformColumn}"
                                          DisplayMemberPath="Name" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="3,0,0,0">
                                <TextBlock Text="Transform kind" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                                <ComboBox Margin="0,3,0,0"
                                          ItemsSource="{Binding TransformKindChoices}"
                                          SelectedItem="{Binding NewTransformKind}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Margin="0,7,0,0"
                                    Visibility="{Binding NewTransformNeedsParameter, Converter={StaticResource BooleanToVisibility}}">
                            <TextBlock Text="Offset" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                            <TextBox Margin="0,3,0,0"
                                     Text="{Binding NewTransformParameter, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <Grid Margin="0,7,0,0"
                              Visibility="{Binding NewTransformNeedsWindow, Converter={StaticResource BooleanToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,3,0">
                                <TextBlock Text="Window size" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                                <TextBox Margin="0,3,0,0"
                                         Text="{Binding NewTransformWindowSize, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="3,0,0,0">
                                <TextBlock Text="Alignment" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                                <ComboBox Margin="0,3,0,0"
                                          ItemsSource="{Binding MovingAverageAlignmentChoices}"
                                          SelectedItem="{Binding NewTransformAlignment}" />
                            </StackPanel>
                        </Grid>
                        <Button Margin="0,7,0,0"
                                Command="{Binding AddTransformCommand}"
                                Content="添加到 ordered transform list" />
                        <ListBox x:Name="PlotTransformsList"
                                 Margin="0,7,0,0"
                                 MinHeight="60"
                                 MaxHeight="150"
                                 ItemsSource="{Binding Transforms}"
                                 SelectedItem="{Binding SelectedTransform}"
                                 DisplayMemberPath="Summary" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Margin="0,0,3,0"
                                    Command="{Binding MoveTransformUpCommand}"
                                    Content="上移" />
                            <Button Grid.Column="1"
                                    Margin="3,0"
                                    Command="{Binding MoveTransformDownCommand}"
                                    Content="下移" />
                            <Button Grid.Column="2"
                                    Margin="3,0,0,0"
                                    Command="{Binding RemoveSelectedTransformCommand}"
                                    Content="移除" />
                        </Grid>
                        <TextBlock Margin="0,6,0,0"
                                   Text="Filter 先执行；Transforms 按列表从上到下执行。边缘 moving average 使用部分窗口但不删除行。"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="8"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Expander>

            <Expander Margin="0,10,0,0" Header="X axis · title / unit / range / ticks" IsExpanded="True">
                <Border Margin="0,5,0,0" Padding="8" Background="#151E27" CornerRadius="3">
                    <ContentControl Content="{Binding XAxis}" ContentTemplate="{StaticResource AxisEditorTemplate}" />
                </Border>
            </Expander>
            <Expander Margin="0,7,0,0" Header="Y axis · title / unit / range / ticks">
                <Border Margin="0,5,0,0" Padding="8" Background="#151E27" CornerRadius="3">
                    <ContentControl Content="{Binding YAxis}" ContentTemplate="{StaticResource AxisEditorTemplate}" />
                </Border>
            </Expander>

            <Expander Margin="0,7,0,0" Header="Scientific typography · canonical TextStyle">
                <Border Margin="0,5,0,0" Padding="8" Background="#151E27" CornerRadius="3">
                    <StackPanel>
                        <TextBlock Text="Axis font" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                        <ContentControl Margin="0,3,0,0" Content="{Binding AxisFont}" ContentTemplate="{StaticResource TextStyleEditorTemplate}" />
                        <TextBlock Margin="0,7,0,0" Text="Tick font" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                        <ContentControl Margin="0,3,0,0" Content="{Binding TickFont}" ContentTemplate="{StaticResource TextStyleEditorTemplate}" />
                        <TextBlock Margin="0,7,0,0" Text="Legend font" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                        <ContentControl Margin="0,3,0,0" Content="{Binding LegendFont}" ContentTemplate="{StaticResource TextStyleEditorTemplate}" />
                        <TextBlock Margin="0,7,0,0" Text="Annotation font" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                        <ContentControl Margin="0,3,0,0" Content="{Binding AnnotationFont}" ContentTemplate="{StaticResource TextStyleEditorTemplate}" />
                    </StackPanel>
                </Border>
            </Expander>

            <Expander Margin="0,7,0,0" Header="Series visual style" IsExpanded="True">
                <Border Margin="0,5,0,0" Padding="8" Background="#151E27" CornerRadius="3">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,3,0">
                                <TextBlock Text="Line color" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                                <TextBox Margin="0,3,0,0" Text="{Binding SeriesStyle.LineColor, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="3,0">
                                <TextBlock Text="Width (pt)" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                                <TextBox Margin="0,3,0,0" Text="{Binding SeriesStyle.LineWidthPt, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="3,0,0,0">
                                <TextBlock Text="Line style" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                                <ComboBox Margin="0,3,0,0"
                                          ItemsSource="{Binding LineStyleChoices}"
                                          SelectedItem="{Binding SeriesStyle.LineStyle}" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,3,0">
                                <TextBlock Text="Marker" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                                <ComboBox Margin="0,3,0,0"
                                          ItemsSource="{Binding MarkerShapeChoices}"
                                          SelectedItem="{Binding SeriesStyle.MarkerShape}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="3,0">
                                <TextBlock Text="Size (pt)" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                                <TextBox Margin="0,3,0,0" Text="{Binding SeriesStyle.MarkerSizePt, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="3,0,0,0">
                                <TextBlock Text="Fill" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                                <TextBox Margin="0,3,0,0" Text="{Binding SeriesStyle.MarkerFill, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Margin="0,7,0,0" Text="Marker stroke" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                        <TextBox Margin="0,3,0,0" Text="{Binding SeriesStyle.MarkerStroke, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>
            </Expander>

            <Button x:Name="SavePlotButton"
                    Margin="0,12,0,0"
                    Command="{Binding SavePlotCommand}"
                    Content="{Binding SaveActionLabel}" />
            <TextBlock Margin="0,8,0,0"
                       Text="{Binding StatusText}"
                       Foreground="#D9B991"
                       FontSize="8"
                       TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
