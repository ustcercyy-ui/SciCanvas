<UserControl x:Class="SciCanvas.App.PublishingPortabilityWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="14,14,14,24">
            <TextBlock Text="发布可移植性" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,0"
                       Text="Team preset pack · Missing fonts · Requested/Effective 分离"
                       Foreground="{DynamicResource MutedBrush}" FontSize="9" TextWrapping="Wrap" />

            <TextBlock Margin="0,14,0,0" Text="JOURNAL PRESETS" FontSize="9" FontWeight="SemiBold" />
            <ListBox Margin="0,6,0,0" MinHeight="100" MaxHeight="180"
                     ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="5,4">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Id}" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Margin="0,5,0,0" Text="{Binding SelectedPresetSummary}" Foreground="#80DDEA" FontSize="8" TextWrapping="Wrap" />
            <UniformGrid Margin="0,7,0,0" Columns="2">
                <Button Margin="0,0,4,0" Command="{Binding ExportSelectedPresetCommand}" Content="导出选中 JSON" />
                <Button Margin="4,0,0,0" Command="{Binding ExportPresetPackCommand}" Content="导出 Team Pack" />
            </UniformGrid>
            <TextBox Margin="0,7,0,0" MinHeight="120" MaxHeight="240"
                     Text="{Binding PresetJson, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="8" />
            <ComboBox Margin="0,6,0,0" ItemsSource="{Binding CollisionPolicyChoices}"
                      SelectedItem="{Binding CollisionPolicy}" />
            <UniformGrid Margin="0,6,0,0" Columns="2">
                <Button Margin="0,0,4,0" Command="{Binding PreviewPresetJsonCommand}" Content="预览导入" />
                <Button Margin="4,0,0,0" Command="{Binding ImportPresetJsonCommand}" Content="确认导入" />
            </UniformGrid>

            <TextBlock Margin="0,16,0,0" Text="FONT PORTABILITY / MISSING FONTS" FontSize="9" FontWeight="SemiBold" />
            <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding MissingFonts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,5" Padding="7" Background="#101820" BorderBrush="#334553" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding RequestedFontFamily}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Status}" Foreground="#E7C49C" FontSize="8" />
                                <TextBlock Text="{Binding UsedBy, StringFormat=Used by: {0}}" Foreground="{DynamicResource MutedBrush}" FontSize="8" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Margin="0,7,0,0" Text="Requested font" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
            <TextBox Margin="0,3,0,0" Text="{Binding RequestedFont, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Margin="0,6,0,0" Text="Substitute font（已安装）" Foreground="{DynamicResource MutedBrush}" FontSize="8" />
            <ComboBox Margin="0,3,0,0" IsEditable="True" ItemsSource="{Binding InstalledFonts}"
                      Text="{Binding SubstituteFont, UpdateSourceTrigger=PropertyChanged}" />
            <Button Margin="0,7,0,0" Command="{Binding SetSubstitutionCommand}" Content="应用到当前工程" />
            <ListBox Margin="0,7,0,0" MinHeight="60" MaxHeight="140"
                     ItemsSource="{Binding Substitutions}" SelectedItem="{Binding SelectedSubstitution}"
                     DisplayMemberPath="Summary" />
            <Button Margin="0,6,0,0" Command="{Binding RemoveSelectedSubstitutionCommand}" Content="移除选中替换" />
            <TextBlock Margin="0,9,0,0" Text="{Binding StatusText}" Foreground="#D9B991" FontSize="8" TextWrapping="Wrap" />
            <TextBlock Margin="0,7,0,0"
                       Text="注意：替换只用于 render snapshot；object.FontFamily/requested value 与工程审计值保持原样。"
                       Foreground="#80DDEA" FontSize="8" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
