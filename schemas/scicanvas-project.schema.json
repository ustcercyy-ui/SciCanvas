{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scicanvas.org/schemas/scicanvas-project.schema.json",
  "title": "SciCanvas Project 2.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "createdAt",
    "updatedAt",
    "canvas",
    "sources",
    "layers",
    "cropPresets",
    "guides",
    "exportProfiles",
    "workspace"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "Current writer emits 2.4; older supported versions are migrated before validation.",
      "examples": ["2.4"]
    },
    "projectId": {
      "type": "string",
      "format": "uuid"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "title": {
      "type": "string",
      "maxLength": 256
    },
    "canvas": {
      "$ref": "#/$defs/canvas"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceAsset"
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/imageLayer" },
          { "$ref": "#/$defs/textLayer" },
          { "$ref": "#/$defs/scaleBarLayer" }
        ]
      }
    },
    "cropPresets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cropPreset"
      }
    },
    "guides": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/guide"
      }
    },
    "exportProfiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exportProfile"
      }
    },
    "journalPresetSnapshots": {
      "type": "array",
      "items": { "$ref": "#/$defs/journalPresetSnapshot" }
    },
    "fontSubstitutions": {
      "type": "array",
      "items": { "$ref": "#/$defs/fontSubstitution" }
    },
    "calibrations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/calibration"
      }
    },
    "measurements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/measurement"
      }
    },
    "analyses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scientificAnalysis"
      }
    },
    "multiChannelGroups": {
      "type": "array",
      "items": { "$ref": "#/$defs/multiChannelGroup" }
    },
    "linkGroups": {
      "type": "array",
      "items": { "$ref": "#/$defs/linkGroup" }
    },
    "rois": {
      "type": "array",
      "items": { "$ref": "#/$defs/canonicalRoi" }
    },    "templateSnapshot": {
      "anyOf": [
        { "$ref": "#/$defs/templateSnapshot" },
        { "type": "null" }
      ]
    },
    "auditTrail": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/auditEntry"
      }
    },
    "workspace": {
      "$ref": "#/$defs/workspace"
    }
  },
  "$defs": {
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "background"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "background": {
          "type": "string",
          "enum": ["transparent", "white", "black", "custom"]
        },
        "backgroundColor": {
          "type": ["string", "null"],
          "pattern": "^#[0-9A-Fa-f]{8}$"
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activeFigureId", "minimumEffectiveDpi", "alignmentToleranceMm",
        "spacingToleranceMm", "verifySourceHashes", "figures"
      ],
      "properties": {
        "activeFigureId": { "type": "string", "format": "uuid" },
        "minimumEffectiveDpi": { "type": "integer", "minimum": 1, "maximum": 2400 },
        "alignmentToleranceMm": { "type": "number", "minimum": 0 },
        "spacingToleranceMm": { "type": "number", "minimum": 0 },
        "verifySourceHashes": { "type": "boolean" },
        "figures": {
          "type": "array",
          "items": { "$ref": "#/$defs/workspaceFigure" }
        }
      }
    },
    "workspaceFigure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "widthMm", "heightMm", "dpi", "templateId", "layerIds"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "widthMm": { "type": "number", "exclusiveMinimum": 0 },
        "heightMm": { "type": "number", "exclusiveMinimum": 0 },
        "dpi": { "type": "integer", "minimum": 1, "maximum": 2400 },
        "templateId": { "type": "string" },
        "layerIds": {
          "type": "array",
          "items": { "type": "string", "format": "uuid" }
        }
      }
    },
    "templateSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "templateId": { "type": "string" },
        "workspaceMode": { "type": "string", "enum": ["crop", "figure"] },
        "selectedSourceId": { "type": ["string", "null"], "format": "uuid" },
        "activeCrop": {
          "anyOf": [
            { "$ref": "#/$defs/pixelRect" },
            { "type": "null" }
          ]
        },
        "lockCropSizeAcrossSources": { "type": "boolean" },
        "cropOverlayVisible": { "type": "boolean" },
        "snappingEnabled": { "type": "boolean" },
        "snapTolerancePixels": { "type": "number", "minimum": 1, "maximum": 100 },
        "exactSpacingPixels": { "type": "integer", "minimum": 0 },
        "autoPanelLabelsEnabled": { "type": "boolean" },
        "showPanelLabels": { "type": "boolean" },
        "panelLabelSequence": {
          "type": "string",
          "enum": ["lowercase", "uppercase", "numeric"]
        },
        "layerSlots": {
          "type": "object",
          "propertyNames": { "format": "uuid" },
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "scaleBars": {
          "type": "object",
          "propertyNames": { "format": "uuid" },
          "additionalProperties": { "$ref": "#/$defs/projectScaleBar" }
        },
        "annotations": {
          "type": "array",
          "items": { "$ref": "#/$defs/projectAnnotation" }
        },
        "scientificObjects": {
          "type": "array",
          "items": { "$ref": "#/$defs/figureScientificObject" }
        },
        "measurementOverlays": {
          "type": "array",
          "items": { "$ref": "#/$defs/measurementOverlay" }
        },
        "globalStyle": {
          "anyOf": [
            { "$ref": "#/$defs/globalStyle" },
            { "type": "null" }
          ]
        },
        "scientificColors": {
          "type": "array",
          "items": { "$ref": "#/$defs/scientificColor" }
        }
      }
    },
    "globalStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fontFamily", "fontSizePt", "strokeWidthPt", "textColor", "shapeColor", "scaleBarColor",
        "panelLabelFontFamily", "panelLabelFontSizePt", "panelLabelTextColor", "panelLabelIsBold",
        "scaleBarLabelColor", "scaleBarFontFamily", "scaleBarFontSizePt", "scaleBarLabelIsBold",
        "scaleBarThicknessPt"
      ],
      "properties": {
        "fontFamily": { "type": "string", "minLength": 1, "maxLength": 128 },
        "fontSizePt": { "type": "number", "minimum": 4, "maximum": 72 },
        "strokeWidthPt": { "type": "number", "minimum": 0.25, "maximum": 10 },
        "textColor": { "type": "string", "pattern": "^#(?:[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$" },
        "shapeColor": { "type": "string", "pattern": "^#(?:[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$" },
        "scaleBarColor": { "type": "string", "pattern": "^#(?:[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$" },
        "panelLabelFontFamily": { "type": "string", "minLength": 1, "maxLength": 128 },
        "panelLabelFontSizePt": { "type": "number", "minimum": 4, "maximum": 72 },
        "panelLabelTextColor": { "type": "string", "pattern": "^#(?:[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$" },
        "panelLabelIsBold": { "type": "boolean" },
        "scaleBarLabelColor": { "type": "string", "pattern": "^#(?:[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$" },
        "scaleBarFontFamily": { "type": "string", "minLength": 1, "maxLength": 128 },
        "scaleBarFontSizePt": { "type": "number", "minimum": 4, "maximum": 72 },
        "scaleBarLabelIsBold": { "type": "boolean" },
        "scaleBarThicknessPt": { "type": "number", "minimum": 0.25, "maximum": 10 }
      }
    },
    "scientificColor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "color"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "color": { "type": "string", "pattern": "^#(?:[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$" }
      }
    },
    "projectScaleBar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled", "physicalUnitsPerSourcePixel", "physicalLength", "unit", "showLabel"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "physicalUnitsPerSourcePixel": { "type": "number" },
        "physicalLength": { "type": "number" },
        "unit": { "type": "string" },
        "showLabel": { "type": "boolean" }
      }
    },
    "projectAnnotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "kind", "x", "y", "endX", "endY", "text", "color",
        "strokeColor", "fillColor", "fillOpacityPercent", "textColor", "fontFamily",
        "fontSizePt", "strokeWidthPt", "isBold", "visible", "locked", "zIndex"
      ],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "kind": { "type": "string", "enum": ["text", "arrow", "line", "rectangle", "ellipse"] },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "endX": { "type": "number" },
        "endY": { "type": "number" },
        "text": { "type": "string" },
        "color": { "type": "string", "pattern": "^#(?:[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$" },
        "strokeColor": { "type": "string", "pattern": "^#(?:[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$" },
        "fillColor": { "type": "string", "pattern": "^#(?:[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$" },
        "fillOpacityPercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "textColor": { "type": "string", "pattern": "^#(?:[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$" },
        "fontFamily": { "type": "string", "minLength": 1, "maxLength": 128 },
        "fontSizePt": { "type": "number", "minimum": 4, "maximum": 72 },
        "strokeWidthPt": { "type": "number", "minimum": 0.25, "maximum": 10 },
        "isBold": { "type": "boolean" },
        "visible": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "zIndex": { "type": "integer", "minimum": 0 }
      }
    },
    "sourceAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "originalPath",
        "fingerprint",
        "metadata",
        "linkState"
      ],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "displayName": { "type": "string", "minLength": 1 },
        "originalPath": { "type": "string", "minLength": 1 },
        "projectRelativePath": { "type": ["string", "null"] },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "metadata": { "$ref": "#/$defs/imageMetadata" },
        "linkState": {
          "type": "string",
          "enum": ["verified", "relocated", "modified", "missing", "unverified"]
        }
      }
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byteLength", "lastWriteTimeUtc", "sha256"],
      "properties": {
        "byteLength": { "type": "integer", "minimum": 0 },
        "lastWriteTimeUtc": { "type": "string", "format": "date-time" },
        "sha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
        "windowsFileId": { "type": ["string", "null"] }
      }
    },
    "imageMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "channels", "bitsPerChannel", "pixelFormat"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "channels": { "type": "integer", "minimum": 1 },
        "bitsPerChannel": { "type": "integer", "enum": [1, 8, 10, 12, 16, 32, 64] },
        "pixelFormat": { "type": "string", "minLength": 1 },
        "frameCount": { "type": "integer", "minimum": 1 },
        "dpiX": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "dpiY": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "physicalSizeX": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "physicalSizeY": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "physicalUnit": { "type": ["string", "null"] },
        "iccProfileName": { "type": ["string", "null"] },
        "ome": {
          "anyOf": [
            { "$ref": "#/$defs/omeMetadata" },
            { "type": "null" }
          ]
        }
      }
    },
    "omeMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimensionOrder", "pixelType", "sizeZ", "sizeC", "sizeT", "channelNames", "xmlSha256"],
      "properties": {
        "dimensionOrder": {
          "type": "string",
          "enum": ["XYZCT", "XYZTC", "XYCZT", "XYCTZ", "XYTCZ", "XYTZC"]
        },
        "pixelType": { "type": "string", "minLength": 1 },
        "sizeZ": { "type": "integer", "minimum": 1 },
        "sizeC": { "type": "integer", "minimum": 1 },
        "sizeT": { "type": "integer", "minimum": 1 },
        "physicalSizeX": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "physicalSizeY": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "physicalSizeZ": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "physicalSizeXUnit": { "type": ["string", "null"] },
        "physicalSizeYUnit": { "type": ["string", "null"] },
        "physicalSizeZUnit": { "type": ["string", "null"] },
        "timeIncrement": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "timeIncrementUnit": { "type": ["string", "null"] },
        "channelNames": {
          "type": "array",
          "items": { "type": "string" }
        },
        "xmlSha256": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{64}$"
        }
      }
    },
    "pixelRect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "normalizedRect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "figureRectMm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "scientificValidity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reasons"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["valid", "warning", "invalid", "reviewrequired"]
        },
        "reasons": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "scaleX", "scaleY", "rotationQuarterTurns"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "scaleX": { "type": "number", "exclusiveMinimum": 0 },
        "scaleY": { "type": "number", "exclusiveMinimum": 0 },
        "rotationQuarterTurns": { "type": "integer", "minimum": 0, "maximum": 3 }
      }
    },
    "layerBaseProperties": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1 },
        "visible": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "zIndex": { "type": "integer" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "imageLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type", "id", "name", "visible", "locked", "zIndex", "opacity",
        "sourceAssetId", "sourceRect", "transform", "adjustments"
      ],
      "properties": {
        "type": { "const": "image" },
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1 },
        "panelLabel": { "type": ["string", "null"], "maxLength": 16 },
        "visible": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "zIndex": { "type": "integer" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "sourceAssetId": { "type": "string", "format": "uuid" },
        "frameIndex": { "type": "integer", "minimum": 0 },
        "lockAspectRatio": { "type": "boolean", "default": true },
        "cropLinkGroupId": { "type": ["string", "null"], "format": "uuid" },
        "compositeGroupId": { "type": ["string", "null"], "format": "uuid" },
        "sourceRect": {
          "description": "Canonical half-open integer source-pixel crop; authoritative for manual mode.",
          "$ref": "#/$defs/pixelRect"
        },
        "transform": { "$ref": "#/$defs/transform" },
        "adjustments": { "type": "array", "items": { "$ref": "#/$defs/imageAdjustment" } },
        "normalizedCrop": {
          "description": "Derived normalized crop for V2 layout and backward-compatible readers; sourceRect wins in manual mode.",
          "anyOf": [
            { "$ref": "#/$defs/normalizedRect" },
            { "type": "null" }
          ]
        },
        "frameMm": {
          "anyOf": [
            { "$ref": "#/$defs/figureRectMm" },
            { "type": "null" }
          ]
        },
        "fitMode": { "type": "string", "enum": ["fit", "fill", "manual"] },
        "rotationDegrees": { "type": "number" },
        "scientificValidity": { "$ref": "#/$defs/scientificValidity" },
        "styleOverride": {
          "anyOf": [
            { "$ref": "#/$defs/panelStyleOverride" },
            { "type": "null" }
          ]
        }
      }
    },
    "panelStyleOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["panelLabel", "scaleBarText", "scaleBar"],
      "properties": {
        "panelLabel": {
          "anyOf": [
            { "$ref": "#/$defs/textStyle" },
            { "type": "null" }
          ]
        },
        "scaleBarText": {
          "anyOf": [
            { "$ref": "#/$defs/textStyle" },
            { "type": "null" }
          ]
        },
        "scaleBar": {
          "anyOf": [
            { "$ref": "#/$defs/scaleBarStyle" },
            { "type": "null" }
          ]
        }
      }
    },
    "textStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fontFamily", "fontSizePt", "isBold", "color"],
      "properties": {
        "fontFamily": { "type": "string", "minLength": 1, "maxLength": 128 },
        "fontSizePt": { "type": "number", "minimum": 4, "maximum": 72 },
        "isBold": { "type": "boolean" },
        "color": { "type": "string", "pattern": "^#(?:[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$" }
      }
    },
    "scaleBarStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultPosition", "barThicknessPt", "color"],
      "properties": {
        "defaultPosition": { "type": "string", "enum": ["bottomLeft", "bottomRight", "topLeft", "topRight", "custom"] },
        "barThicknessPt": { "type": "number", "minimum": 0.25, "maximum": 10 },
        "color": { "type": "string", "pattern": "^#(?:[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$" }
      }
    },
    "imageAdjustment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brightness", "contrast", "gamma", "blackPoint", "whitePoint", "invert", "grayscale", "channel"],
      "properties": {
        "brightness": { "type": "number", "minimum": -1, "maximum": 1 },
        "contrast": { "type": "number", "minimum": -1, "maximum": 1 },
        "gamma": { "type": "number", "minimum": 0.1, "maximum": 10 },
        "blackPoint": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
        "whitePoint": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "invert": { "type": "boolean" },
        "grayscale": { "type": "boolean" },
        "channel": { "type": "string", "enum": ["rgb", "red", "green", "blue", "alpha"] }
      }
    },
    "textLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type", "id", "name", "visible", "locked", "zIndex", "opacity",
        "text", "x", "y", "fontFamily", "fontSizePt", "color"
      ],
      "properties": {
        "type": { "const": "text" },
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1 },
        "visible": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "zIndex": { "type": "integer" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "text": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "fontFamily": { "type": "string" },
        "fontSizePt": { "type": "number", "exclusiveMinimum": 0 },
        "fontWeight": { "type": "integer", "minimum": 100, "maximum": 900 },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{8}$" }
      }
    },
    "scaleBarLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type", "id", "name", "visible", "locked", "zIndex", "opacity",
        "sourceAssetId", "x", "y", "physicalLength", "physicalUnit", "thickness"
      ],
      "properties": {
