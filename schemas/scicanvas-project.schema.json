      ],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "sourceAssetId": { "type": "string", "format": "uuid" },
        "targetAssetId": { "type": "string", "format": "uuid" },
        "sourceRevision": { "type": "integer", "minimum": 1 },
        "targetRevision": { "type": "integer", "minimum": 1 },
        "kind": { "type": "string", "enum": ["identity", "translation", "rigid", "affine"] },
        "matrix": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": { "type": "number" }
        },
        "origin": {
          "type": "string",
          "enum": ["userDeclaredIdentity", "userDeclaredTranslation", "manualLandmarks", "importedMetadata"]
        },
"createdAt": { "type": "string", "format": "date-time" },
        "residualPixels": { "type": ["number", "null"], "minimum": 0 },
        "landmarks": {
          "type": "array",
          "items": { "$ref": "#/$defs/registrationLandmark" }
        },
        "residualPhysical": { "type": ["number", "null"], "minimum": 0 },
        "residualPhysicalUnit": { "type": ["string", "null"], "minLength": 1 }
      }
    },
"registrationLandmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceX", "sourceY", "targetX", "targetY"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "sourceX": { "type": "number" },
        "sourceY": { "type": "number" },
        "targetX": { "type": "number" },
        "targetY": { "type": "number" }
      }
    },
    "auditEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp", "command", "parameters"],
      "properties": {
        "timestamp": { "type": "string", "format": "date-time" },
        "command": { "type": "string", "minLength": 1 },
        "parameters": { "type": "object" }
      }
    }
  }
}
