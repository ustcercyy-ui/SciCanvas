{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scicanvas.org/schemas/scicanvas-journal-preset.schema.json",
  "title": "SciCanvas portable journal preset or team preset pack",
  "oneOf": [
    { "$ref": "#/$defs/preset" },
    { "$ref": "#/$defs/pack" }
  ],
  "$defs": {
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formatVersion", "id", "name", "figureWidthMm", "minimumDpi",
        "preferredFormat", "allowedFormats", "colorMode"
      ],
      "properties": {
        "formatVersion": { "const": "1.0" },
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "description": { "type": ["string", "null"], "maxLength": 2048 },
        "figureWidthMm": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
        "figureHeightMm": { "type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1000 },
        "minimumDpi": { "type": "integer", "minimum": 1, "maximum": 4800 },
        "preferredFormat": { "enum": ["tiff", "png", "jpg", "pdf", "svg"] },
        "allowedFormats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["tiff", "png", "jpg", "pdf", "svg"] }
        },
        "colorMode": { "enum": ["RGB", "GRAYSCALE", "CMYK"] },
        "maximumFileSizeMb": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "fontRecommendations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "minimumLineWidthPt": { "type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 100 },
        "notes": { "type": ["string", "null"], "maxLength": 4096 },
        "sourceMetadata": { "$ref": "#/$defs/sourceMetadata" }
      }
    },
    "sourceMetadata": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "sourceName": { "type": ["string", "null"] },
        "sourceUrl": { "type": ["string", "null"], "format": "uri" },
        "sourceUpdatedAt": { "type": ["string", "null"], "format": "date-time" },
        "createdAt": { "type": ["string", "null"], "format": "date-time" },
        "author": { "type": ["string", "null"] },
        "organization": { "type": ["string", "null"] }
      }
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formatVersion", "name", "presets"],
      "properties": {
        "formatVersion": { "const": "1.0" },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "description": { "type": ["string", "null"], "maxLength": 2048 },
        "organization": { "type": ["string", "null"], "maxLength": 256 },
        "presets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/preset" }
        }
      }
    }
  }
}
